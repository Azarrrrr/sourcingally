---
import Layout from '../../layouts/Layout.astro';
import { legalLocales } from '../../data/legal-locales';
export function getStaticPaths(){return ['en','es','pt','ru','tr','fr','ja','de','ar','id','it'].map(lang=>({params:{lang},props:{lang}}))}
const { lang } = Astro.props;
const c = legalLocales[lang as keyof typeof legalLocales]?.terms ?? legalLocales.en.terms;
---
<Layout title={c.title} description={c.description} lang={lang}>
  <section class="legal-hero section-pad"><div class="container legal-wrap"><p class="eyebrow">{c.eyebrow}</p><h1>{c.heading}</h1><p>{c.reviewed}</p></div></section>
  <section class="section-pad section-light"><div class="container legal-body"><p>{c.intro}</p>{c.sections.map((section) => <section><h2>{section.heading}</h2><p>{section.body}</p></section>)}</div></section>
</Layout>
<style>.legal-hero{background:#f4f8ff}.legal-wrap{max-width:900px}.legal-wrap h1{font-size:clamp(3rem,6vw,5.7rem);line-height:1;letter-spacing:-.07em;margin:0 0 18px}.legal-wrap>p:last-child{color:var(--muted)}.legal-body{max-width:850px}.legal-body h2{font-size:1.8rem;letter-spacing:-.04em;margin:42px 0 10px}.legal-body p{color:#405069;font-size:1rem;line-height:1.85}</style>
