import Layout from '../../layouts/Layout.astro';
export function getStaticPaths(){return ['en','es','pt','ru','tr'].map(lang=>({params:{lang}}))}
const lang=Astro.params.lang || 'en';
const locales={
  en:{title:'Start a Sourcing Project | Sourcing Ally',description:'Prepare a clearer China sourcing project brief for email or WhatsApp.',back:'← Sourcing Ally',eyebrow:'Project Brief Builder',hero:'Turn an idea into a clearer sourcing conversation.',intro:'Answer the questions you already know. This tool creates a draft message for email or WhatsApp. It does not store the information you enter.',panel:'PROJECT\nBEFORE\nPRICE',panelCopy:'A more precise first message usually produces a more useful first response.',step1:'Step 1 of 3',step1Title:'Tell us the essential project facts.',step1Copy:'You can leave an answer blank if you do not know it yet. Specific details will make the conversation easier.',product:'What product do you want to source?',productPH:'Example: private-label kitchen storage containers, a clothing collection, a consumer electronic accessory…',quantity:'What quantity are you considering?',quantityPH:'Example: 500 units, first sample only, monthly reorder…',destination:'Where will the products be sold or delivered?',destinationPH:'Example: United States, Spain, Amazon FBA, UAE…',timing:'What is your target timing?',timingPH:'Example: samples in October, shipment before January…',step2:'Step 2 of 3',step2Title:'Describe the important requirements.',requirements:'Materials, dimensions, colors, or technical requirements',requirementsPH:'Add the specifications that matter. Mention reference drawings, samples, or images if you have them.',packaging:'Packaging, logo, or private-label needs',packagingPH:'Example: custom box, barcode, logo placement, insert card…',step3:'Step 3 of 3',step3Title:'What decision do you need help making?',support:'Choose the main type of support',supports:['Supplier sourcing and comparison','Sample review or factory checks','Quality control or final checks','Packaging or supplier communication','Factory visit or independent travel support','Not sure yet'],question:'Your main question or concern',questionPH:'Example: I need to