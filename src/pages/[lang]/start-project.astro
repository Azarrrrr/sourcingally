};
const c=locales[lang as keyof typeof locales] || locales.en;
---
<Layout title={c.title} description={c.description} lang={lang}>
  <section class="brief-hero"><div class="container brief-hero-grid"><div><a class="back-link" href={`/${lang}/`}>{c.back}</a><p class="eyebrow">{c.eyebrow}</p><h1>{c.hero}</h1><p class="hero-intro">{c.intro}</p></div><div class="brief-panel"><span>SA / BRIEF</span><b>{c.panel.split('\n').map(line=><>{line}<br /></>)}</b><p>{c.panelCopy}</p></div></div></section>
  <section class="brief-workspace section-pad"><div class="container workspace-grid"><form id="project-brief" class="brief-form" data-msg={JSON.stringify(c.msg)}><div class="form-heading"><p class="eyebrow">{c.step1}</p><h2>{c.step1Title}</h2><p>{c.step1Copy}</p></div><div class="form-block"><label>{c.product}<textarea name="product" placeholder={c.productPH}></textarea></label><label>{c.quantity}<input name="quantity" placeholder={c.quantityPH} /></label></div><div class="form-block"><label>{c.destination}<input name="destination" placeholder={c.destinationPH} /></label><label>{c.timing}<input name="timing" placeholder={c.timingPH} /></label></div><div class="form-heading second"><p class="eyebrow">{c.step2}</p><h2>{c.step2Title}</h2></div><div class="form-block"><label>{c.requirements}<textarea name="requirements" placeholder={c.requirementsPH}></textarea></label><label>{c.packaging}<textarea name="packaging" placeholder={c.packagingPH}></textarea></label></div><div class="form-heading second"><p class="eyebrow">{c.step3}</p><h2>{c.step3Title}</h2></div><div class="form-block"><label>{c.support}<select name="support">{c.supports.map(item=><option value={item}>{item}</option>)}</select></label><label>{c.question}<textarea name="question" placeholder={c.questionPH}></textarea></label></div><div class="form-actions"><button class="button" type="button" id="email-brief">{c.email}</button><button class="button button-outline" type="button" id="whatsapp-brief">{c.whatsapp}</button><p>{c.privacy}</p></div></form><aside class="brief-aside"><div class="aside-card dark"><p class="eyebrow">{c.why}</p><h3>{c.whyTitle}</h3><p>{c.whyCopy}</p></div><div class="aside-card"><p class="eyebrow">{c.include}</p><ul>{c.includeList.map(item=><li>{item}</li>)}</ul></div><div class="aside-card note"><p class="eyebrow">{c.fee}</p><p>{c.feeCopy}</p><a href={`/${lang}/questions/how-do-sourcing-agent-fees-work/`}>{c.feeLink}</a></div></aside></div></section>
</Layout>
<script>
  const form = document.querySelector('#project-brief');
  const ui = JSON.parse(form?.dataset.msg || '{}');
  const buildMessage = () => {
    const data = new FormData(form);
    const value = (key) => (data.get(key) || '').toString().trim() || ui.notConfirmed;
    return `${ui.greeting}\n\n${ui.opening}\n\n${ui.product}: ${value('product')}\n${ui.quantity}: ${value('quantity')}\n${ui.destination}: ${value('destination')}\n${ui.timing}: ${value('timing')}\n\n${ui.requirements}: ${value('requirements')}\n${ui.packaging}: ${value('packaging')}\n\n${ui.support}: ${value('support')}\n${ui.question}: ${value('question')}\n\n${ui.closing}`;
  };
  document.querySelector('#email-brief')?.addEventListener('click', () => { window.location.href = `mailto:sourcingally@gmail.com?subject=${encodeURIComponent(ui.subject)}&body=${encodeURIComponent(buildMessage())}`; });
  document.querySelector('#whatsapp-brief')?.addEventListener('click', () => { window.open(`https://wa.me/8619002009100?text=${encodeURIComponent(buildMessage())}`, '_blank', 'noopener'); });
</script>
