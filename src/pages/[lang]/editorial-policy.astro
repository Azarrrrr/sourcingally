---
import Layout from '../../layouts/Layout.astro';
import { legalCopy } from '../../data/legal-localization';
export function getStaticPaths(){return ['en','es','pt','ru','tr','fr','ja','de','ar','id','it'].map(lang=>({params:{lang},props:{lang}}))}
const { lang } = Astro.props;
const c = legalCopy(lang, 'editorial');
---
<Layout title={c.title} description={c.description} lang={lang}>
  <section class="policy-hero"><div class="container policy-wrap"><p class="eyebrow">{c.eyebrow}</p><h1>{c.heading}</h1><p>{c.reviewed}</p></div></section>
  <section class="section-pad section-light"><div class="container policy-grid"><article class="policy-body">{c.intro && <p class="policy-intro">{c.intro}</p>}{c.sections.map((section) => <section><h2>{section.heading}</h2><p>{section.body}</p></section>)}</article><aside class="policy-aside"><div><p class="eyebrow">{lang === 'ru' ? 'Обещание читателю' : lang === 'es' ? 'Nuestro compromiso con el lector' : lang === 'pt' ? 'Compromisso com o leitor' : lang === 'tr' ? 'Okuyucu taahhüdü' : lang === 'fr' ? 'Notre engagement envers le lecteur' : 'Reader promise'}</p><b>{lang === 'ru' ? 'Понятная структура. Практический контекст. Честные ограничения.' : lang === 'es' ? 'Estructura clara. Contexto práctico. Límites honestos.' : lang === 'pt' ? 'Estrutura clara. Contexto prático. Limites honestos.' : lang === 'tr' ? 'Açık yapı. Pratik bağlam. Dürüst sınırlar.' : lang === 'fr' ? 'Une structure claire. Un contexte pratique. Des limites honnêtes.' : 'Clear structure. Practical context. Honest limits.'}</b></div><div><p class="eyebrow">{lang === 'ru' ? 'Для реальных проектов' : lang === 'es' ? 'Para proyectos reales' : lang === 'pt' ? 'Para projetos reais' : lang === 'tr' ? 'Gerçek projeler için' : lang === 'fr' ? 'Pour les projets réels' : 'For real projects'}</p><p>{lang === 'ru' ? 'Общее образование не заменяет письменный объём проекта, актуальные профессиональные консультации или проверку конкретного поставщика и продукта.' : lang === 'es' ? 'La información general no sustituye un alcance de proyecto por escrito, asesoramiento profesional actualizado ni la verificación del proveedor y producto reales.' : lang === 'pt' ? 'A informação geral não substitui um escopo de projeto por escrito, orientação profissional atualizada ou a verificação do fornecedor e produto reais.' : lang === 'tr' ? 'Genel eğitim; yazılı proje kapsamının, güncel profesyonel danışmanlığın veya gerçek tedarikçi ve ürün doğrulamasının yerine geçmez.' : lang === 'fr' ? 'Les informations générales ne remplacent ni un périmètre de projet écrit, ni un avis professionnel à jour, ni la vérification du fournisseur et du produit concernés.' : 'General education is not a substitute for a written project scope, current professional advice, or verification of the actual supplier and product.'}</p></div><a class="button" href={`/${lang}/questions/`}>{lang === 'ru' ? 'Открыть вопросы по закупкам' : lang === 'es' ? 'Explorar preguntas de sourcing' : lang === 'pt' ? 'Explorar perguntas de sourcing' : lang === 'tr' ? 'Tedarik sorularını keşfedin' : lang === 'fr' ? 'Explorer les questions sourcing' : 'Explore Sourcing Questions'} ↗</a></aside></div></section>
</Layout>
<style>.policy-hero{background:#f4f8ff;padding:88px 0 98px;position:relative;overflow:hidden}.policy-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.policy-wrap{max-width:970px;position:relative}.policy-wrap h1{font-size:clamp(3rem,6vw,5.8rem);line-height:.98;letter-spacing:-.075em;max-width:950px;margin:0 0 23px}.policy-wrap>p:last-child{color:var(--muted)}.policy-grid{display:grid;grid-template-columns:1fr .42fr;gap:90px}.policy-body{max-width:790px}.policy-body section{margin-bottom:44px}.policy-body h2{font-size:1.85rem;letter-spacing:-.045em;margin:0 0 11px}.policy-body p{color:#405069;font-size:1.02rem;line-height:1.85;margin:0}.policy-intro{margin-bottom:44px!important}.policy-aside{display:flex;flex-direction:column;gap:15px}.policy-aside>div{border:1px solid var(--line);border-radius:15px;padding:20px;background:white}.policy-aside b{font-size:1.35rem;line-height:1.1;letter-spacing:-.04em}.policy-aside p:not(.eyebrow){color:var(--muted);font-size:.86rem;line-height:1.7;margin:0}.policy-aside .button{align-self:flex-start}@media(max-width:760px){.policy-grid{grid-template-columns:1fr;gap:35px}.policy-hero{padding:70px 0 78px}.policy-wrap h1{font-size:3rem}}</style>
