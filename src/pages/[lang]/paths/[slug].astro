---
import Layout from '../../../layouts/Layout.astro';
import { buyerPaths } from '../../../data/buyer-paths';
import { buyerPathLocales } from '../../../data/buyer-path-locales';
import { buyerPathUiLocales } from '../../../data/buyer-path-ui-locales';
export function getStaticPaths(){return ['en','es','pt','ru','tr','fr','ja','de','ar','id','it'].flatMap(lang=>buyerPaths.map(path=>({params:{lang,slug:path.slug},props:{lang,slug:path.slug}})))}
const {slug,lang}=Astro.props;
const sourcePath=buyerPaths.find(item=>item.slug===slug);
if (!sourcePath) throw new Error(`Unknown buyer path: ${slug}`);
const localPath=lang==='en' ? undefined : buyerPathLocales[lang as keyof typeof buyerPathLocales]?.paths.find(item=>item.slug===slug);
const path=localPath ? {...sourcePath,...localPath,stages:sourcePath.stages.map((item,index)=>({...item,...localPath.stages[index]})),risks:sourcePath.risks.map((item,index)=>({...item,...localPath.risks[index]})),next:sourcePath.next.map((item,index)=>({...item,label:localPath.nextLabels[index]}))} : sourcePath;
const localHref=(href:string)=>href.replace(/^\/en/,`/${lang}`);
const ui=buyerPathUiLocales[lang as keyof typeof buyerPathUiLocales] ?? buyerPathUiLocales.en;
const pageJson={'@context':'https://schema.org','@type':'Article',headline:path.title,description:path.description,author:{'@type':'Organization',name:'Sourcing Ally'},publisher:{'@type':'Organization',name:'Sourcing Ally'},mainEntityOfPage:`https://sourcingally.com/${lang}/paths/${path.slug}/`};
---
<Layout title={`${path.title} | Sourcing Ally`} description={path.description} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(pageJson)}></script>
  <article class="route-page">

    <header class="route-hero"><div class="container route-hero-grid"><div><a class="back-link" href={`/${lang}/paths/`}>{ui.back}</a><p class="eyebrow">{ui.route} {path.number} · {path.label}</p><h1>{path.title}</h1><p class="route-intro">{path.description}</p><p class="route-promise">{path.promise}</p><div class="route-hero-actions"><a class="button" href="#route">{ui.follow}</a><a class="text-link" href={`/${lang}/start-project/`}>{ui.brief}</a></div></div><aside class="route-status"><span>{ui.status} {path.number}</span><div class="status-steps">{path.stages.map((stage,index)=><div><b>{String(index+1).padStart(2,'0')}</b><i></i><small>{stage.title}</small></div>)}</div><p>{ui.scrollRoute}</p></aside></div></header>
    <section class="route-orientation"><div class="container orientation-grid"><div><p class="eyebrow">{ui.how}</p><h2>{ui.sequence}</h2></div><p>{ui.orientation}</p></div></section>
    <section id="route" class="route-sequence section-light"><div class="container"><div class="route-section-head"><p class="eyebrow">{ui.routeLabel}</p><h2>{ui.routeHeading}</h2><span>{ui.scroll}</span></div><div class="route-sticky-wrap"><div class="route-rail"><span class="rail-fill"></span>{path.stages.map((stage,index)=><b class="rail-dot" style={`--step:${index}`}>{String(index+1).padStart(2,'0')}</b>)}</div><div class="route-cards">{path.stages.map((stage,index)=><section class="route-step" data-step={index}><div class="step-index">{String(index+1).padStart(2,'0')}</div><div><p class="eyebrow">{ui.decision} {String(index+1).padStart(2,'0')}</p><h3>{stage.title}</h3><p>{stage.text}</p><a class="route-link" href={localHref(stage.href)}>{ui.openGuide} <span>↗</span></a></div><div class="step-marker"><span>{path.number}</span><i>{ui.markers[index]}</i></div></section>)}</div></div></div></section>
    <section class="route-risks section-pad"><div class="container"><div class="section-heading"><div><p class="eyebrow">{ui.risks}</p><h2>{ui.risksHeading}</h2></div><p>{ui.risksCopy}</p></div><div class="risk-grid">{path.risks.map((risk,index)=><article><span>0{index+1}</span><h3>{risk.title}</h3><p>{risk.text}</p></article>)}</div></div></section>
    <section class="route-checklist section-pad"><div class="container checklist-grid"><div><p class="eyebrow">{ui.checklist}</p><h2>{ui.checklistHeading}</h2><p>{ui.checklistCopy}</p><a class="button" href={`/${lang}/start-project/`}>{ui.create}</a></div><ol>{path.checklist.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span><b>{item}</b><i>□</i></li>)}</ol></div></section>
    <section class="route-next section-pad section-light"><div class="container"><div class="section-heading"><div><p class="eyebrow">{ui.next}</p><h2>{ui.nextHeading}</h2></div><p>{ui.nextCopy}</p></div><div class="next-grid">{path.next.map((item,index)=><a href={localHref(item.href)}><span>0{index+1}</span><b>{item.label}</b><i>↗</i></a>)}</div></div></section>
    <section class="route-note"><div class="container"><strong>{ui.noteTitle}</strong><p>{ui.noteCopy} <a href={`/${lang}/disclaimer/`}>{ui.disclaimer}</a>.</p></div></section>
  </article>
</Layout>
<script>
  const routeSteps = [...document.querySelectorAll('.route-step')];
  const dots = [...document.querySelectorAll('.rail-dot')];
  const fill = document.querySelector('.rail-fill');
  if (routeSteps.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const index = routeSteps.indexOf(entry.target);
        routeSteps.forEach((step, i) => step.classList.toggle('is-active', i === index));
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i <= index));
        if (fill) fill.style.height = `${Math.max(0, index) * 33.33}%`;
      });
    }, { threshold: .48 });
    routeSteps.forEach(step => observer.observe(step));
  }
</script>
<style>.route-localization-note{background:#fff8db;border-bottom:1px solid #eedb93;padding:11px 0}.route-localization-note>div{display:flex;gap:14px;align-items:center;flex-wrap:wrap;font-size:.76rem;line-height:1.45;color:#405069}.route-localization-note b{color:var(--ink)}.route-localization-note a{color:var(--blue);font-weight:800}.route-hero{background:#f4f8ff;padding:80px 0 95px;position:relative;overflow:hidden}.route-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.route-hero-grid{position:relative;display:grid;grid-template-columns:1fr .52fr;gap:82px;align-items:end}.back-link{display:inline-block;color:var(--blue);font-size:.84rem;font-weight:750;margin-bottom:42px}.route-hero h1{font-size:clamp(3rem,6vw,6.05rem);letter-spacing:-.08em;line-height:.96;margin:0 0 22px;max-width:900px}.route-intro{font-size:1.12rem;line-height:1.75;color:#405069;max-width:700px;margin:0 0 20px}.route-promise{border-left:4px solid var(--gold);padding:8px 0 8px 17px;color:var(--ink);font-size:1.02rem;font-weight:750;line-height:1.55;max-width:700px}.route-hero-actions{display:flex;gap:24px;align-items:center;margin-top:30px}.route-status{background:var(--ink);color:white;min-height:365px;padding:25px;box-shadow:18px 18px 0 rgba(247,201,72,.67);position:relative;overflow:hidden}.route-status:before{content:"";position:absolute;width:320px;height:320px;border:1px solid rgba(255,255,255,.18);border-radius:50%;right:-140px;bottom:-100px}.route-status>span,.route-status>p,.status-steps{position:relative;z-index:2}.route-status>span{font-size:.65rem;color:var(--gold);font-weight:800;letter-spacing:.13em}.status-steps{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:40px 0}.status-steps>div{display:grid;grid-template-columns:28px 1fr;gap:8px;align-items:center}.status-steps b{color:var(--gold);font-size:.72rem}.status-steps i{display:none}.status-steps small{font-size:.78rem;color:#d7e2ef}.route-status>p{font-size:.8rem;color:#cbd8e8;margin:0}.route-orientation{padding:72px 0;background:white}.orientation-grid{display:grid;grid-template-columns:1fr 1fr;gap:90px}.orientation-grid h2{font-size:clamp(2.2rem,4vw,4.2rem);letter-spacing:-.065em;line-height:1.02;margin:0}.orientation-grid>p{font-size:1.03rem;line-height:1.85;color:#405069;margin:0}.route-sequence{padding:90px 0;background:#eef4fb}.route-section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:35px}.route-section-head h2{font-size:clamp(2.2rem,4.4vw,4.5rem);line-height:1;letter-spacing:-.07em;margin:0}.route-section-head>span{font-size:.65rem;color:var(--coral);font-weight:800;letter-spacing:.13em}.route-sticky-wrap{display:grid;grid-template-columns:100px 1fr;gap:45px}.route-rail{position:sticky;top:150px;height:360px;width:3px;background:#cbd8e8;align-self:start;margin-left:28px}.rail-fill{position:absolute;top:0;left:0;width:100%;height:0;background:var(--gold);transition:height .45s ease}.rail-dot{position:absolute;left:50%;transform:translate(-50%,-50%);width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:white;color:#8290a3;border:1px solid #cbd8e8;font-size:.63rem;transition:.3s}.rail-dot:nth-of-type(2){top:0}.rail-dot:nth-of-type(3){top:33.33%}.rail-dot:nth-of-type(4){top:66.66%}.rail-dot:nth-of-type(5){top:100%}.rail-dot.is-active{background:var(--ink);border-color:var(--ink);color:var(--gold);box-shadow:0 0 0 7px rgba(247,201,72,.23)}.route-cards{display:flex;flex-direction:column;gap:24px}.route-step{background:white;display:grid;grid-template-columns:95px 1fr 120px;gap:30px;align-items:start;border:1px solid var(--line);border-radius:19px;padding:38px;min-height:310px;transition:transform .45s ease,box-shadow .45s ease,border-color .45s ease}.route-step.is-active{transform:translateX(12px);border-color:var(--blue);box-shadow:13px 15px 0 rgba(40,103,217,.12)}.step-index{font-size:2.5rem;color:var(--gold);font-weight:850;letter-spacing:-.07em}.route-step h3{font-size:clamp(1.8rem,3.3vw,3rem);letter-spacing:-.06em;line-height:1.03;margin:0 0 13px}.route-step p:not(.eyebrow){color:#405069;line-height:1.8;margin:0 0 22px;max-width:700px}.route-link{font-size:.86rem;color:var(--blue);font-weight:800}.step-marker{border-left:1px solid var(--line);padding-left:20px;display:flex;flex-direction:column;gap:8px}.step-marker span{font-size:.85rem;color:var(--coral);font-weight:800}.step-marker i{font-size:.65rem;letter-spacing:.12em;color:#7f8da2;font-style:normal}.route-risks{background:white}.risk-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.risk-grid article{border:1px solid var(--line);border-radius:16px;padding:24px;background:#fff}.risk-grid span{color:var(--coral);font-size:.7rem;font-weight:800}.risk-grid h3{font-size:1.32rem;line-height:1.15;letter-spacing:-.045em;margin:20px 0 10px}.risk-grid p{color:var(--muted);font-size:.9rem;line-height:1.7;margin:0}.route-checklist{background:var(--ink);color:white}.checklist-grid{display:grid;grid-template-columns:1fr 1fr;gap:85px;align-items:center}.checklist-grid h2{font-size:clamp(2.3rem,4.2vw,4.3rem);line-height:1.02;letter-spacing:-.065em;margin:0 0 17px}.checklist-grid>div>p:not(.eyebrow){color:#cbd8e8;line-height:1.8;max-width:550px;margin:0 0 28px}.checklist-grid .eyebrow{color:var(--gold)}.checklist-grid ol{list-style:none;margin:0;padding:0}.checklist-grid li{display:grid;grid-template-columns:36px 1fr 20px;gap:12px;border-top:1px solid rgba(255,255,255,.2);padding:16px 0;align-items:center}.checklist-grid li span{color:var(--gold);font-size:.68rem;font-weight:800}.checklist-grid li b{font-size:.95rem}.checklist-grid li i{font-style:normal;color:#cbd8e8;font-size:1.05rem}.next-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.next-grid a{background:white;border:1px solid var(--line);border-radius:16px;padding:20px;min-height:150px;display:flex;flex-direction:column;transition:.25s}.next-grid a:hover{transform:translateY(-5px);box-shadow:9px 11px 0 rgba(40,103,217,.11);border-color:var(--blue)}.next-grid span{font-size:.7rem;color:var(--coral);font-weight:800}.next-grid b{font-size:1.12rem;line-height:1.2;margin:20px 0}.next-grid i{font-style:normal;color:var(--blue);margin-top:auto}.route-note{background:#fff8db;padding:25px 0}.route-note>div{display:grid;grid-template-columns:250px 1fr;gap:25px;align-items:start}.route-note strong{color:var(--ink)}.route-note p{margin:0;color:#405069;line-height:1.75;font-size:.88rem}.route-note a{color:var(--blue);font-weight:700}@media(max-width:850px){.route-hero-grid,.orientation-grid,.checklist-grid{grid-template-columns:1fr;gap:40px}.route-status{max-width:400px}.route-step{grid-template-columns:60px 1fr;gap:20px}.step-marker{display:none}.risk-grid{grid-template-columns:1fr}.next-grid{grid-template-columns:1fr}.route-note>div{grid-template-columns:1fr;gap:8px}}@media(max-width:560px){.route-hero{padding:70px 0 80px}.route-hero h1{font-size:3rem}.route-hero-actions{flex-direction:column;align-items:flex-start}.route-sticky-wrap{grid-template-columns:35px 1fr;gap:17px}.route-rail{margin-left:14px}.route-step{grid-template-columns:1fr;padding:25px;min-height:0}.route-step.is-active{transform:none}.step-index{font-size:2rem}.route-section-head{display:block}.route-section-head>span{display:block;margin-top:12px}.route-checklist{padding:65px 0}.route-note{padding:22px 0}}</style>
