---
import Layout from '../../../layouts/Layout.astro';
import { buyerPaths } from '../../../data/buyer-paths';
export function getStaticPaths(){return ['en','es','pt','ru','tr'].map(lang=>({params:{lang}}))}
---
<Layout title="Choose Your Sourcing Path | Sourcing Ally" description="Explore a practical China sourcing path for your first import, private-label brand, marketplace product, product development, China visit, or existing supplier situation." lang="en">
  <section class="paths-hero"><div class="container paths-hero-grid"><div><p class="eyebrow">Choose your route</p><h1>Start with the sourcing decision you are actually facing.</h1><p>Most buyers do not need the same page. Choose the path that matches your project, then move through the practical questions, risks, checklists, and next actions.</p><a class="button" href="#paths">Find your path ↓</a></div><div class="atlas-card"><div class="atlas-label"><span>SA / SOURCING ATLAS</span><b>06 ROUTES</b></div><div class="atlas-lines"><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="atlas-dots"><b>01</b><b>02</b><b>03</b><b>04</b><b>05</b><b>06</b></div><small>Follow the question before the quotation.</small></div></div></section>
  <section class="paths-intro section-pad"><div class="container intro-split"><div><p class="eyebrow">A better starting point</p><h2>Premium sourcing advice is not one long sales page.</h2></div><p>It is a clear route through the work that matters for your situation. Each path connects the decision you are facing to the right service, guide, checklist, and project brief. The exact scope can still change with the product, supplier, quantity, destination, and timeline.</p></div></section>
  <section id="paths" class="paths-list section-pad section-light"><div class="container">{buyerPaths.map((path,index)=><article class:list={['path-card', index % 2 === 1 && 'path-card-alt']}><div class="path-number">{path.number}</div><div class="path-copy"><p class="eyebrow">{path.label}</p><h2>{path.title}</h2><p>{path.description}</p><blockquote>{path.promise}</blockquote><a class="button" href={`/en/paths/${path.slug}/`}>Explore this route <span>↗</span></a></div><div class="path-stage-preview">{path.stages.map((stage,stageIndex)=><div class:list={['stage-mini', stageIndex === 0 && 'stage-active']}><span>{String(stageIndex+1).padStart(2,'0')}</span><b>{stage.title}</b><i>→</i></div>)}</div></article>)}</div></section>
  <section class="path-close section-pad"><div class="container close-split"><div><p class="eyebrow">Not sure which route fits?</p><h2>Build a brief and begin with the questions you already know.</h2></div><p>The Project Brief Builder does not require you to know every answer. It creates a structured email or WhatsApp draft that makes the first conversation clearer.</p><a class="button button-light" href="/en/start-project/">Create your project brief ↗</a></div></section>
</Layout>
<style>.paths-hero{background:#f4f8ff;padding:95px 0 108px;position:relative;overflow:hidden}.paths-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.paths-hero-grid{display:grid;grid-template-columns:1fr .62fr;gap:80px;align-items:center;position:relative}.paths-hero h1{font-size:clamp(3.2rem,6.3vw,6.1rem);letter-spacing:-.08em;line-height:.96;max-width:860px;margin:0 0 25px}.paths-hero p:not(.eyebrow){font-size:1.12rem;line-height:1.75;color:var(--muted);max-width:650px;margin:0 0 30px}.atlas-card{min-height:420px;background:var(--ink);color:#fff;padding:25px;position:relative;overflow:hidden;box-shadow:20px 20px 0 rgba(247,201,72,.68)}.atlas-card:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px);background-size:34px 34px}.atlas-label,.atlas-card small,.atlas-dots{position:relative;z-index:2}.atlas-label{display:flex;justify-content:space-between;font-size:.65rem;font-weight:800;letter-spacing:.13em;color:var(--gold)}.atlas-lines{position:absolute;inset:90px 26px 70px}.atlas-lines i{position:absolute;height:2px;background:linear-gradient(90deg,var(--gold),transparent);transform-origin:left;opacity:.9}.atlas-lines i:nth-child(1){width:74%;left:5%;top:12%;transform:rotate(28deg)}.atlas-lines i:nth-child(2){width:62%;left:37%;top:30%;transform:rotate(111deg)}.atlas-lines i:nth-child(3){width:64%;left:13%;top:58%;transform:rotate(-10deg)}.atlas-lines i:nth-child(4){width:68%;left:31%;top:77%;transform:rotate(-64deg)}.atlas-lines i:nth-child(5){width:54%;left:18%;top:28%;transform:rotate(92deg)}.atlas-lines i:nth-child(6){width:42%;left:50%;top:56%;transform:rotate(16deg)}.atlas-dots{position:absolute;inset:110px 35px 93px}.atlas-dots b{position:absolute;width:36px;height:36px;display:grid;place-items:center;border-radius:50%;background:var(--gold);color:var(--ink);font-size:.62rem}.atlas-dots b:nth-child(1){top:0;left:4%}.atlas-dots b:nth-child(2){top:18%;right:5%}.atlas-dots b:nth-child(3){top:48%;left:18%}.atlas-dots b:nth-child(4){top:77%;right:16%}.atlas-dots b:nth-child(5){bottom:0;left:39%}.atlas-dots b:nth-child(6){top:42%;left:52%}.atlas-card small{position:absolute;bottom:24px;left:25px;color:#cbd8e8;letter-spacing:.08em;font-size:.62rem}.intro-split{display:grid;grid-template-columns:1fr 1fr;gap:90px}.intro-split h2{font-size:clamp(2.2rem,4.3vw,4.4rem);line-height:1;letter-spacing:-.06em;margin:0}.intro-split>p{font-size:1.03rem;line-height:1.85;color:#405069;margin:0}.paths-list{padding-top:35px}.path-card{display:grid;grid-template-columns:100px 1.05fr .95fr;gap:30px;padding:55px 0;border-bottom:1px solid var(--line);align-items:center}.path-number{font-size:1rem;color:var(--coral);font-weight:800;align-self:start}.path-copy h2{font-size:clamp(2.2rem,4vw,4.1rem);letter-spacing:-.065em;line-height:1.02;margin:0 0 15px}.path-copy>p:not(.eyebrow){color:var(--muted);line-height:1.75;max-width:620px}.path-copy blockquote{margin:22px 0 28px;border-left:3px solid var(--gold);padding:7px 0 7px 16px;font-size:1.02rem;line-height:1.55;color:var(--ink);font-weight:700}.path-stage-preview{border:1px solid var(--line);border-radius:17px;background:#fff;padding:19px}.stage-mini{display:grid;grid-template-columns:28px 1fr 18px;gap:10px;align-items:center;border-bottom:1px solid var(--line);padding:14px 0;color:#7c8a9c}.stage-mini:last-child{border:0}.stage-mini span{font-size:.65rem;color:var(--coral);font-weight:800}.stage-mini b{font-size:.9rem}.stage-mini i{font-style:normal;color:var(--blue)}.stage-mini.stage-active{color:var(--ink)}.stage-mini.stage-active b{font-size:1.02rem}.path-close{background:var(--ink);color:white}.close-split{display:grid;grid-template-columns:1.1fr .8fr auto;gap:45px;align-items:end}.close-split h2{font-size:clamp(2.2rem,4vw,4.1rem);letter-spacing:-.06em;line-height:1.02;margin:0}.close-split p:not(.eyebrow){color:#cbd8e8;line-height:1.8;margin:0}.close-split .eyebrow{color:var(--gold)}@media(max-width:850px){.paths-hero-grid,.intro-split{grid-template-columns:1fr;gap:42px}.atlas-card{max-width:430px}.path-card{grid-template-columns:50px 1fr;gap:18px}.path-stage-preview{grid-column:2}.close-split{grid-template-columns:1fr;gap:24px;align-items:start}}@media(max-width:540px){.paths-hero{padding:72px 0 80px}.paths-hero h1{font-size:3.05rem}.path-card{padding:38px 0}.path-copy h2{font-size:2.3rem}.atlas-card{min-height:350px}.close-split .button{justify-self:start}}</style>
