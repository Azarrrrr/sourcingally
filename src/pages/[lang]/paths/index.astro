---
import Layout from '../../../layouts/Layout.astro';
import { buyerPaths } from '../../../data/buyer-paths';
import { buyerPathLocales } from '../../../data/buyer-path-locales';
import generatedPathIndexTranslations from '../../../data/generatedPathIndexTranslations.json';
const pathUi={
 en:{title:'Choose Your Sourcing Path',description:'Explore a practical China sourcing path for your first import, private-label brand, marketplace product, product development, China visit, or existing supplier situation.',eyebrow:'Choose your route',heading:'Start with the sourcing decision you are actually facing.',intro:'Most buyers do not need the same page. Choose the path that matches your project, then move through the practical questions, risks, checklists, and next actions.',find:'Find your path',atlas:'SA / SOURCING ATLAS',follow:'Follow the question before the quotation.',better:'A better starting point',premium:'Premium sourcing advice is not one long sales page.',betterText:'It is a clear route through the work that matters for your situation. Each path connects the decision you are facing to the right service, guide, checklist, and project brief. The exact scope can still change with the product, supplier, quantity, destination, and timeline.',explore:'Explore this route',review:'English route detail is being prepared for reviewed localization.',notSure:'Not sure which route fits?',close:'Build a brief and begin with the questions you already know.',closeText:'The Project Brief Builder does not require you to know every answer. It creates a structured email or WhatsApp draft that makes the first conversation clearer.',action:'Create your project brief'},
 es:{title:'Elija su ruta de abastecimiento',description:'Explore una ruta práctica de abastecimiento en China para su primera importación, marca privada, producto de marketplace, desarrollo de producto, visita a China o situación con un proveedor.',eyebrow:'Elija su ruta',heading:'Empiece por la decisión de abastecimiento que realmente enfrenta.',intro:'No todos los compradores necesitan la misma página. Elija la ruta que se adapte a su proyecto y avance por preguntas prácticas, riesgos, listas de verificación y próximos pasos.',find:'Encuentre su ruta',atlas:'SA / ATLAS DE SOURCING',follow:'Siga la pregunta antes que la cotización.',better:'Un mejor punto de partida',premium:'El asesoramiento de sourcing premium no es una única página de ventas.',betterText:'Es una ruta clara por el trabajo que importa en su situación. Cada ruta conecta su decisión con el servicio, guía, lista de verificación y briefing adecuados. El alcance final puede cambiar según el producto, proveedor, cantidad, destino y calendario.',explore:'Explorar esta ruta',review:'El detalle de la ruta en inglés se está preparando para una localización revisada.',notSure:'¿No sabe qué ruta encaja?',close:'Cree un briefing y empiece con las preguntas que ya conoce.',closeText:'El Creador de proyecto no exige conocer todas las respuestas. Genera un borrador estructurado para email o WhatsApp que aclara la primera conversación.',action:'Crear mi proyecto'},
 pt:{title:'Escolha sua rota de sourcing',description:'Explore uma rota prática de sourcing na China para sua primeira importação, marca própria, produto de marketplace, desenvolvimento de produto, viagem à China ou situação com fornecedor.',eyebrow:'Escolha sua rota',heading:'Comece pela decisão de sourcing que você realmente enfrenta.',intro:'Nem todos os compradores precisam da mesma página. Escolha a rota adequada ao seu projeto e avance pelas perguntas práticas, riscos, listas de verificação e próximos passos.',find:'Encontre sua rota',atlas:'SA / ATLAS DE SOURCING',follow:'Siga a pergunta antes da cotação.',better:'Um ponto de partida melhor',premium:'A orientação premium de sourcing não é uma página de vendas longa.',betterText:'É uma rota clara pelo trabalho que importa para sua situação. Cada rota conecta sua decisão ao serviço, guia, checklist e briefing adequados. O escopo final pode variar conforme produto, fornecedor, quantidade, destino e prazo.',explore:'Explorar esta rota',review:'O detalhe da rota em inglês está sendo preparado para localização revisada.',notSure:'Não sabe qual rota é adequada?',close:'Crie um briefing e comece pelas perguntas que você já conhece.',closeText:'O Criador de projeto não exige que você saiba todas as respostas. Ele gera um rascunho estruturado de e-mail ou WhatsApp para tornar a primeira conversa mais clara.',action:'Criar meu projeto'},
 ru:{title:'Выберите маршрут закупки',description:'Изучите практический маршрут закупок в Китае для первого импорта, частной марки, маркетплейса, разработки продукта, поездки в Китай или ситуации с поставщиком.',eyebrow:'Выберите маршрут',heading:'Начните с решения по закупкам, которое действительно стоит перед вами.',intro:'Не всем покупателям нужна одна и та же страница. Выберите маршрут для вашего проекта и пройдите практические вопросы, риски, чек-листы и следующие действия.',find:'Найти маршрут',atlas:'SA / АТЛАС ЗАКУПОК',follow:'Сначала вопрос, затем котировка.',better:'Более ясная точка старта',premium:'Премиальная помощь в закупках — это не одна длинная продающая страница.',betterText:'Это ясный маршрут по работе, важной в вашей ситуации. Каждый маршрут связывает решение с нужной услугой, гидом, чек-листом и брифом. Окончательный объём зависит от товара, поставщика, количества, направления и сроков.',explore:'Открыть маршрут',review:'Подробности маршрута на английском готовятся к проверенной локализации.',notSure:'Не уверены, какой маршрут подходит?',close:'Создайте бриф и начните с вопросов, которые уже знаете.',closeText:'Конструктор проекта не требует знать все ответы. Он создаёт структурированный черновик письма или WhatsApp для более ясного первого разговора.',action:'Создать бриф'},
 tr:{title:'Tedarik rotanızı seçin',description:'İlk ithalat, özel marka, pazaryeri ürünü, ürün geliştirme, Çin seyahati veya tedarikçi durumu için pratik bir Çin tedarik rotasını keşfedin.',eyebrow:'Rotanızı seçin',heading:'Gerçekte karşılaştığınız tedarik kararıyla başlayın.',intro:'Her alıcı aynı sayfaya ihtiyaç duymaz. Projenize uygun rotayı seçin; pratik sorular, riskler, kontrol listeleri ve sonraki adımlarla ilerleyin.',find:'Rotanızı bulun',atlas:'SA / TEDARİK ATLASI',follow:'Tekliften önce soruyu takip edin.',better:'Daha iyi bir başlangıç noktası',premium:'Premium tedarik rehberliği tek bir uzun satış sayfası değildir.',betterText:'Bu, durumunuz için önemli olan çalışmaya dair net bir rotadır. Her rota kararınızı doğru hizmete, rehbere, kontrol listesine ve proje özetine bağlar. Nihai kapsam ürüne, tedarikçiye, miktara, varış yerine ve takvime göre değişebilir.',explore:'Bu rotayı keşfedin',review:'İngilizce rota ayrıntısı gözden geçirilmiş yerelleştirme için hazırlanıyor.',notSure:'Hangi rotanın uygun olduğundan emin değil misiniz?',close:'Bir proje özeti oluşturun ve bildiğiniz sorularla başlayın.',closeText:'Proje Oluşturucu tüm cevapları bilmenizi gerektirmez. İlk konuşmayı netleştirmek için yapılandırılmış e-posta veya WhatsApp taslağı oluşturur.',action:'Proje özetimi oluştur'}
};
export function getStaticPaths(){return ['en','es','pt','ru','tr','fr','ja','de','ar','id','it'].map(lang=>({params:{lang},props:{lang}}))}
const {lang}=Astro.props;
const frUi={title:'Choisissez votre parcours de sourcing',description:'Explorez un parcours pratique de sourcing en Chine pour une première importation, une marque privée, un produit de marketplace, le développement d’un produit, un voyage en Chine ou une situation avec un fournisseur existant.',eyebrow:'Choisissez votre parcours',heading:'Commencez par la décision de sourcing à laquelle vous faites réellement face.',intro:'Tous les acheteurs n’ont pas besoin de la même page. Choisissez le parcours qui correspond à votre projet, puis avancez à travers les questions pratiques, les risques, les listes de contrôle et les actions suivantes.',find:'Trouver votre parcours',atlas:'SA / ATLAS DE SOURCING',follow:'Suivez la question avant le devis.',better:'Un meilleur point de départ',premium:'Un accompagnement de sourcing haut de gamme n’est pas une longue page de vente.',betterText:'C’est un parcours clair à travers le travail qui compte dans votre situation. Chaque parcours relie votre décision au bon service, guide, liste de contrôle et brief de projet. Le périmètre exact peut encore varier selon le produit, le fournisseur, la quantité, la destination et le calendrier.',explore:'Explorer ce parcours',review:'',notSure:'Vous ne savez pas quel parcours convient ?',close:'Créez un brief et commencez par les questions que vous connaissez déjà.',closeText:'Le Créateur de brief ne vous demande pas de connaître toutes les réponses. Il prépare un brouillon structuré d’e-mail ou de message WhatsApp pour rendre le premier échange plus clair.',action:'Créer mon brief de projet'};
const generatedPathIndex = generatedPathIndexTranslations as Partial<Record<string, Record<string, string>>>;
const localizePathIndexValue = (value: unknown, dictionary?: Record<string, string>): any => typeof value === 'string' ? (dictionary?.[value] ?? value) : Array.isArray(value) ? value.map((entry) => localizePathIndexValue(entry, dictionary)) : value && typeof value === 'object' ? Object.fromEntries(Object.entries(value as Record<string, unknown>).map(([key, entry]) => [key, localizePathIndexValue(entry, dictionary)])) : value;
const u=lang==='fr' ? frUi : (pathUi[lang as keyof typeof pathUi] ?? localizePathIndexValue(pathUi.en, generatedPathIndex[lang]));
const localizedPaths=lang==='en' ? buyerPaths : (buyerPathLocales[lang as keyof typeof buyerPathLocales]?.paths ?? []).map(localPath=>{const source=buyerPaths.find(item=>item.slug===localPath.slug)!; return {...source,...localPath,stages:source.stages.map((stage,index)=>({...stage,...localPath.stages[index]})),risks:source.risks.map((risk,index)=>({...risk,...localPath.risks[index]})),next:source.next.map((item,index)=>({...item,label:localPath.nextLabels[index]}))};});
const visiblePaths=localizedPaths.length ? localizedPaths : buyerPaths;
---
<Layout title={`${u.title} | Sourcing Ally`} description={u.description} lang={lang}>
  <section class="paths-hero"><div class="container paths-hero-grid"><div><p class="eyebrow">{u.eyebrow}</p><h1>{u.heading}</h1><p>{u.intro}</p><a class="button" href="#paths">{u.find} ↓</a></div><div class="atlas-card"><div class="atlas-label"><span>{u.atlas}</span><b>{lang === 'ru' ? '06 МАРШРУТОВ' : lang === 'es' ? '06 RUTAS' : lang === 'pt' ? '06 ROTAS' : lang === 'tr' ? '06 ROTA' : lang === 'fr' ? '06 PARCOURS' : '06 ROUTES'}</b></div><div class="atlas-lines"><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="atlas-dots"><b>01</b><b>02</b><b>03</b><b>04</b><b>05</b><b>06</b></div><small>{u.follow}</small></div></div></section>
  <section class="paths-intro section-pad"><div class="container intro-split"><div><p class="eyebrow">{u.better}</p><h2>{u.premium}</h2></div><p>{u.betterText}</p></div></section>
  <section id="paths" class="paths-list section-pad section-light"><div class="container">{visiblePaths.map((path,index)=><article class:list={['path-card', index % 2 === 1 && 'path-card-alt']}><div class="path-number">{path.number}</div><div class="path-copy"><p class="eyebrow">{path.label}</p><h2>{path.title}</h2><p>{path.description}</p><blockquote>{path.promise}</blockquote><a class="button" href={`/${lang}/paths/${path.slug}/`}>{u.explore} <span>↗</span></a></div><div class="path-stage-preview">{path.stages.map((stage,stageIndex)=><div class:list={['stage-mini', stageIndex === 0 && 'stage-active']}><span>{String(stageIndex+1).padStart(2,'0')}</span><b>{stage.title}</b><i>→</i></div>)}</div></article>)}</div></section>
  <section class="path-close section-pad"><div class="container close-split"><div><p class="eyebrow">{u.notSure}</p><h2>{u.close}</h2></div><p>{u.closeText}</p><a class="button button-light" href={`/${lang}/start-project/`}>{u.action} ↗</a></div></section>
</Layout>
<style>.paths-hero{background:#f4f8ff;padding:95px 0 108px;position:relative;overflow:hidden}.paths-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.paths-hero-grid{display:grid;grid-template-columns:1fr .62fr;gap:80px;align-items:center;position:relative}.paths-hero h1{font-size:clamp(3.2rem,6.3vw,6.1rem);letter-spacing:-.08em;line-height:.96;max-width:860px;margin:0 0 25px}.paths-hero p:not(.eyebrow){font-size:1.12rem;line-height:1.75;color:var(--muted);max-width:650px;margin:0 0 30px}.atlas-card{min-height:420px;background:var(--ink);color:#fff;padding:25px;position:relative;overflow:hidden;box-shadow:20px 20px 0 rgba(247,201,72,.68)}.atlas-card:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px);background-size:34px 34px}.atlas-label,.atlas-card small,.atlas-dots{position:relative;z-index:2}.atlas-label{display:flex;justify-content:space-between;font-size:.65rem;font-weight:800;letter-spacing:.13em;color:var(--gold)}.atlas-lines{position:absolute;inset:90px 26px 70px}.atlas-lines i{position:absolute;height:2px;background:linear-gradient(90deg,var(--gold),transparent);transform-origin:left;opacity:.9}.atlas-lines i:nth-child(1){width:74%;left:5%;top:12%;transform:rotate(28deg)}.atlas-lines i:nth-child(2){width:62%;left:37%;top:30%;transform:rotate(111deg)}.atlas-lines i:nth-child(3){width:64%;left:13%;top:58%;transform:rotate(-10deg)}.atlas-lines i:nth-child(4){width:68%;left:31%;top:77%;transform:rotate(-64deg)}.atlas-lines i:nth-child(5){width:54%;left:18%;top:28%;transform:rotate(92deg)}.atlas-lines i:nth-child(6){width:42%;left:50%;top:56%;transform:rotate(16deg)}.atlas-dots{position:absolute;inset:110px 35px 93px}.atlas-dots b{position:absolute;width:36px;height:36px;display:grid;place-items:center;border-radius:50%;background:var(--gold);color:var(--ink);font-size:.62rem}.atlas-dots b:nth-child(1){top:0;left:4%}.atlas-dots b:nth-child(2){top:18%;right:5%}.atlas-dots b:nth-child(3){top:48%;left:18%}.atlas-dots b:nth-child(4){top:77%;right:16%}.atlas-dots b:nth-child(5){bottom:0;left:39%}.atlas-dots b:nth-child(6){top:42%;left:52%}.atlas-card small{position:absolute;bottom:24px;left:25px;color:#cbd8e8;letter-spacing:.08em;font-size:.62rem}.intro-split{display:grid;grid-template-columns:1fr 1fr;gap:90px}.intro-split h2{font-size:clamp(2.2rem,4.3vw,4.4rem);line-height:1;letter-spacing:-.06em;margin:0}.intro-split>p{font-size:1.03rem;line-height:1.85;color:#405069;margin:0}.paths-list{padding-top:35px}.path-card{display:grid;grid-template-columns:100px 1.05fr .95fr;gap:30px;padding:55px 0;border-bottom:1px solid var(--line);align-items:center}.path-number{font-size:1rem;color:var(--coral);font-weight:800;align-self:start}.path-copy h2{font-size:clamp(2.2rem,4vw,4.1rem);letter-spacing:-.065em;line-height:1.02;margin:0 0 15px}.path-copy>p:not(.eyebrow){color:var(--muted);line-height:1.75;max-width:620px}.translation-review{display:block;color:var(--muted);font-size:.72rem;line-height:1.45;margin-top:12px}.path-copy blockquote{margin:22px 0 28px;border-left:3px solid var(--gold);padding:7px 0 7px 16px;font-size:1.02rem;line-height:1.55;color:var(--ink);font-weight:700}.path-stage-preview{border:1px solid var(--line);border-radius:17px;background:#fff;padding:19px}.stage-mini{display:grid;grid-template-columns:28px 1fr 18px;gap:10px;align-items:center;border-bottom:1px solid var(--line);padding:14px 0;color:#7c8a9c}.stage-mini:last-child{border:0}.stage-mini span{font-size:.65rem;color:var(--coral);font-weight:800}.stage-mini b{font-size:.9rem}.stage-mini i{font-style:normal;color:var(--blue)}.stage-mini.stage-active{color:var(--ink)}.stage-mini.stage-active b{font-size:1.02rem}.path-close{background:var(--ink);color:white}.close-split{display:grid;grid-template-columns:1.1fr .8fr auto;gap:45px;align-items:end}.close-split h2{font-size:clamp(2.2rem,4vw,4.1rem);letter-spacing:-.06em;line-height:1.02;margin:0}.close-split p:not(.eyebrow){color:#cbd8e8;line-height:1.8;margin:0}.close-split .eyebrow{color:var(--gold)}@media(max-width:850px){.paths-hero-grid,.intro-split{grid-template-columns:1fr;gap:42px}.atlas-card{max-width:430px}.path-card{grid-template-columns:50px 1fr;gap:18px}.path-stage-preview{grid-column:2}.close-split{grid-template-columns:1fr;gap:24px;align-items:start}}@media(max-width:540px){.paths-hero{padding:72px 0 80px}.paths-hero h1{font-size:3.05rem}.path-card{padding:38px 0}.path-copy h2{font-size:2.3rem}.atlas-card{min-height:350px}.close-split .button{justify-self:start}}</style>
