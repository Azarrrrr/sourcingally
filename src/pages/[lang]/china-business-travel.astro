---
import OperationalGuidePage from '../../components/OperationalGuidePage.astro';
import { operationalGuideLanguages, type OperationalGuideLanguage } from '../../data/operational-guides';

export function getStaticPaths() {
  return operationalGuideLanguages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: OperationalGuideLanguage };
---
<OperationalGuidePage lang={lang} pageKey="chinaBusinessTravel" sequence="02—02" />
