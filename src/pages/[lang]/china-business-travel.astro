---
import OperationalGuidePage from '../../components/OperationalGuidePage.astro';

export function getStaticPaths() {
  return ['en', 'es', 'pt', 'ru', 'tr', 'fr'].map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: 'en' | 'es' | 'pt' | 'ru' | 'tr' | 'fr' };
---
<OperationalGuidePage lang={lang} pageKey="chinaBusinessTravel" sequence="02—02" />
