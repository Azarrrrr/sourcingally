---
import DecisionSuitePage from '../../components/DecisionSuitePage.astro';
import { decisionLanguages, type DecisionLanguage } from '../../data/decision-suite';
export function getStaticPaths() {
  return decisionLanguages.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: DecisionLanguage };
---
<DecisionSuitePage lang={lang} pageKey="factoryVisits" sequence="03—04" />
