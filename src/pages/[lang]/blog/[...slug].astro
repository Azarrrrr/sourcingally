---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { localeAvailability } from '../../../data/locale-availability';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const locales = ['en','es','pt','ru','tr','fr'] as const;
  const articleKeys = [...new Set(posts.map((post) => post.data.translationKey ?? post.id))];
  const sanityUrl = new URL('https://iksqqwui.api.sanity.io/v2025-02-19/data/query/production');
  sanityUrl.searchParams.set('query', '*[_type == "article" && siteKey == "sourcing-ally"]{slug,locale}');
  const sanityArticles = await fetch(sanityUrl).then(async (response) => response.ok ? ((await response.json()) as { result: { slug?: string; locale?: string }[] }).result : []).catch(() => []);
  const fallbackPost = posts.find((item) => item.data.lang === 'en') ?? posts[0];
  const markdownPaths = locales.flatMap((lang) => articleKeys.flatMap((articleKey) => {
    const post = posts.find((item) => item.data.lang === lang && (item.data.translationKey ?? item.id) === articleKey)
      ?? posts.find((item) => item.data.lang === 'en' && (item.data.translationKey ?? item.id) === articleKey);
    return post ? [{ params: { lang, slug: articleKey }, props: { post, lang, articleKey } }] : [];
  }));
  const sanityProxyPaths = fallbackPost ? locales.map((lang) => ({ params: { lang, slug: 'sanity-article' }, props: { post: posts.find((item) => item.data.lang === lang) ?? fallbackPost, lang, articleKey: 'sanity-article', isSanityProxy: true } })) : [];
  const sanityArticlePaths = fallbackPost ? sanityArticles.filter((article) => article.slug && locales.includes(article.locale as typeof locales[number]) && article.slug !== 'sanity-article').map((article) => ({ params: { lang: article.locale!, slug: article.slug! }, props: { post: posts.find((item) => item.data.lang === article.locale) ?? fallbackPost, lang: article.locale!, articleKey: article.slug!, isSanityProxy: true } })) : [];
  return [...markdownPaths, ...sanityProxyPaths, ...sanityArticlePaths];
}
const { post, lang, articleKey, isSanityProxy = false } = Astro.props; const { Content } = await render(post);
const usesFallbackArticle = lang !== post.data.lang;
const availability = usesFallbackArticle ? localeAvailability[lang as keyof typeof localeAvailability] : undefined;
const localHref = (href: string) => href.replace(/^\/en(?=\/|$)/, `/${lang}`);
const articleUi = {
  en:{journal:'Journal',fieldGuide:'Field guide',writtenBy:'Written by',context:'Based on practical China sourcing questions',inThisGuide:'In this guide',aside:'Read the article, note the decisions it raises, and use the related links at the end to continue your research.',school:'Open Sourcing School ↗',noteTitle:'Keep the next decision visible.',note:'Use this article as a starting framework. Product, destination, customs, testing, and commercial details should be checked for the real project before you pay, produce, ship, or sell.',continue:'Continue your research',choose:'Choose the next decision that fits your project.',readGuide:'Read guide ↗',previous:'Previous',next:'Next'},
  es:{journal:'Revista',fieldGuide:'Guía práctica',writtenBy:'Escrito por',context:'Basado en preguntas prácticas sobre sourcing en China',inThisGuide:'En esta guía',aside:'Lea el artículo, anote las decisiones que plantea y use los enlaces relacionados para continuar su investigación.',school:'Abrir la Escuela de abastecimiento ↗',noteTitle:'Mantenga visible la siguiente decisión.',note:'Use este artículo como punto de partida. Los detalles de producto, destino, aduanas, pruebas y condiciones comerciales deben verificarse para el proyecto real antes de pagar, producir, enviar o vender.',continue:'Continúe su investigación',choose:'Elija la siguiente decisión que se ajuste a su proyecto.',readGuide:'Leer la guía ↗',previous:'Anterior',next:'Siguiente'},
  pt:{journal:'Revista',fieldGuide:'Guia prático',writtenBy:'Escrito por',context:'Baseado em perguntas práticas sobre sourcing na China',inThisGuide:'Neste guia',aside:'Leia o artigo, anote as decisões levantadas e use os links relacionados para continuar sua pesquisa.',school:'Abrir a Escola de sourcing ↗',noteTitle:'Mantenha a próxima decisão visível.',note:'Use este artigo como ponto de partida. Detalhes de produto, destino, alfândega, testes e condições comerciais devem ser verificados para o projeto real antes de pagar, produzir, embarcar ou vender.',continue:'Continue sua pesquisa',choose:'Escolha a próxima decisão que se encaixa no seu projeto.',readGuide:'Ler o guia ↗',previous:'Anterior',next:'Próximo'},
  ru:{journal:'Журнал',fieldGuide:'Практическое руководство',writtenBy:'Автор',context:'Основано на практических вопросах о закупках в Китае',inThisGuide:'В этом руководстве',aside:'Прочитайте статью, отметьте решения, которых она касается, и используйте связанные ссылки для дальнейшего изучения.',school:'Открыть Школу закупок ↗',noteTitle:'Сделайте следующее решение видимым.',note:'Используйте статью как отправную точку. Детали товара, рынка, таможни, тестирования и коммерческих условий нужно проверить для реального проекта до оплаты, производства, отправки или продажи.',continue:'Продолжить изучение',choose:'Выберите следующее решение для своего проекта.',readGuide:'Читать руководство ↗',previous:'Предыдущая',next:'Следующая'},
  tr:{journal:'Dergi',fieldGuide:'Pratik rehber',writtenBy:'Yazan',context:'Çin tedarikiyle ilgili pratik sorular temel alınmıştır',inThisGuide:'Bu rehberde',aside:'Makaleyi okuyun, ortaya çıkan kararları not edin ve araştırmanıza devam etmek için ilgili bağlantıları kullanın.',school:'Tedarik Okulunu açın ↗',noteTitle:'Sonraki kararı görünür tutun.',note:'Bu makaleyi başlangıç çerçevesi olarak kullanın. Ürün, varış yeri, gümrük, test ve ticari ayrıntılar; ödeme, üretim, sevkiyat veya satış öncesinde gerçek proje için doğrulanmalıdır.',continue:'Araştırmaya devam edin',choose:'Projenize uygun sonraki kararı seçin.',readGuide:'Rehberi okuyun ↗',previous:'Önceki',next:'Sonraki'},
  fr:{journal:'Journal',fieldGuide:'Guide pratique',writtenBy:'Écrit par',context:'Basé sur des questions pratiques de sourcing en Chine',inThisGuide:'Dans ce guide',aside:'Lisez l’article, notez les décisions qu’il soulève et utilisez les liens associés pour poursuivre vos recherches.',school:'Ouvrir l’École du sourcing ↗',noteTitle:'Gardez la prochaine décision visible.',note:'Utilisez cet article comme cadre de départ. Les détails de produit, destination, douane, tests et conditions commerciales doivent être vérifiés pour le projet réel avant de payer, produire, expédier ou vendre.',continue:'Poursuivez vos recherches',choose:'Choisissez la prochaine décision adaptée à votre projet.',readGuide:'Lire le guide ↗',previous:'Précédent',next:'Suivant'}
}[lang as 'en'|'es'|'pt'|'ru'|'tr'|'fr'];
const visualCaption = { en:'Illustrative editorial visual — not a client project or factory record.', es:'Visual editorial ilustrativo; no es un proyecto de cliente ni un registro de fábrica.', pt:'Visual editorial ilustrativo; não é um projeto de cliente nem um registro de fábrica.', ru:'Иллюстративный редакционный визуал, а не проект клиента и не запись с фабрики.', tr:'İllüstratif editoryal görsel; müşteri projesi veya fabrika kaydı değildir.', fr:'Visuel éditorial illustratif : il ne s’agit ni d’un projet client ni d’un relevé d’usine.' }[lang as 'en'|'es'|'pt'|'ru'|'tr'|'fr'];
const allPosts = (await getCollection('blog', ({data}) => !data.draft && data.lang === post.data.lang)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const currentIndex = allPosts.findIndex(item=>item.id===post.id); const next = allPosts[currentIndex+1]; const previous = allPosts[currentIndex-1];
const articleJson = { '@context':'https://schema.org', '@type':'Article', headline:post.data.title, description:post.data.description, datePublished:post.data.pubDate.toISOString(), dateModified:(post.data.updatedDate ?? post.data.pubDate).toISOString(), author:{'@type':'Person',name:post.data.author}, publisher:{'@type':'Organization',name:'Sourcing Ally',url:'https://sourcingally.com'}, mainEntityOfPage:`https://sourcingally.com/${lang}/blog/${articleKey}/` };
const categoryLinks: Record<string, {label:string; href:string; note:string}[]> = {
  'Start importing': [{label:'First Import buyer path',href:'/en/paths/first-import/',note:'Follow a practical route from product idea to shipment preparation.'},{label:'Sourcing Questions',href:'/en/questions/',note:'Find direct answers before you send the first supplier inquiry.'},{label:'Project Brief Builder',href:'/en/start-project/',note:'Turn product facts and unknowns into a clearer first message.'}],
  'Choosing a sourcing partner': [{label:'Buyer Paths',href:'/en/paths/',note:'Choose the sourcing situation that best matches your current project.'},{label:'Supplier sourcing service',href:'/en/services/supplier-sourcing/',note:'Understand the local support that can be discussed for supplier research.'},{label:'Sourcing Questions',href:'/en/questions/',note:'Explore specific agent, supplier, factory, and quality questions.'}],
  'Supplier research': [{label:'Supplier sourcing service',href:'/en/services/supplier-sourcing/',note:'Explore practical local support for supplier research and communication.'},{label:'Factory checks',href:'/en/services/supplier-factory-checks/',note:'See what an agreed supplier or factory visit can help establish.'},{label:'China Visit buyer path',href:'/en/paths/china-visit/',note:'Plan a supplier trip around evidence and next actions.'}],
  'Samples and product development': [{label:'Product Development buyer path',href:'/en/paths/product-development/',note:'Connect product concept, samples, and production decisions.'},{label:'Sample sourcing service',href:'/en/services/sample-sourcing/',note:'Explore sample-related support and communication pathways.'},{label:'Quality-control checklist',href:'/en/guides/quality-control-checklist/',note:'Prepare product-specific checks before production completes.'}],
  'MOQ, quotes, and negotiation': [{label:'Brand / Private Label buyer path',href:'/en/paths/brand-private-label/',note:'Understand how quantity, customization, samples, and packaging connect.'},{label:'Product Brief Builder',href:'/en/start-project/',note:'Create a consistent product request before comparing quotes.'},{label:'Sourcing Questions',href:'/en/questions/',note:'Read direct answers about supplier comparisons and MOQ.'}],
  'Quality control': [{label:'Quality control service',href:'/en/services/quality-control/',note:'Explore quality and final-product check support.'},{label:'Existing Supplier buyer path',href:'/en/paths/existing-supplier-rescue/',note:'Bring an unclear active order back to visible facts and actions.'},{label:'Quality-control checklist',href:'/en/guides/quality-control-checklist/',note:'Build a product-specific inspection brief.'}],
  'Shipping and logistics': [{label:'Shipping from China guide',href:'/en/guides/shipping-from-china/',note:'Review shipment preparation questions and handover planning.'},{label:'Marketplace buyer path',href:'/en/paths/marketplace-seller/',note:'Connect packaging, final checks, and fulfilment questions.'},{label:'Disclaimer',href:'/en/disclaimer/',note:'Understand the limits of general shipping and compliance education.'}]
};
const genericLinks = { en:[{label:'Sourcing Questions',href:'/en/questions/',note:'Find direct answers for the next sourcing decision.'},{label:'Buyer Paths',href:'/en/paths/',note:'Choose a route that matches your current situation.'},{label:'Project Brief Builder',href:'/en/start-project/',note:'Create a clearer first message for Sourcing Ally.'}], es:[{label:'Preguntas sobre abastecimiento',href:'/en/questions/',note:'Encuentre respuestas directas para la siguiente decisión.'},{label:'Rutas de compra',href:'/en/paths/',note:'Elija una ruta que corresponda a su proyecto.'},{label:'Creador de proyecto',href:'/en/start-project/',note:'Prepare un primer mensaje más claro.'}], pt:[{label:'Perguntas sobre sourcing',href:'/en/questions/',note:'Encontre respostas diretas para a próxima decisão.'},{label:'Rotas do comprador',href:'/en/paths/',note:'Escolha uma rota adequada ao seu projeto.'},{label:'Criador de projeto',href:'/en/start-project/',note:'Prepare uma primeira mensagem mais clara.'}], ru:[{label:'Вопросы о закупках',href:'/en/questions/',note:'Найдите прямые ответы для следующего решения.'},{label:'Маршруты покупателя',href:'/en/paths/',note:'Выберите путь для своего проекта.'},{label:'Конструктор проекта',href:'/en/start-project/',note:'Подготовьте более ясное первое сообщение.'}], tr:[{label:'Tedarik soruları',href:'/en/questions/',note:'Sonraki karar için doğrudan yanıtlar bulun.'},{label:'Alıcı rotaları',href:'/en/paths/',note:'Projenize uygun rotayı seçin.'},{label:'Proje Oluşturucu',href:'/en/start-project/',note:'Daha net ilk mesaj hazırlayın.'}], fr:[{label:'Questions sur le sourcing',href:'/en/questions/',note:'Trouvez des réponses directes pour la prochaine décision.'},{label:'Parcours acheteurs',href:'/en/paths/',note:'Choisissez un parcours adapté à votre projet.'},{label:'Créateur de brief',href:'/en/start-project/',note:'Préparez un premier message plus clair.'}] };
const deepLinks = categoryLinks[post.data.category] ?? genericLinks[lang as keyof typeof genericLinks];
const officialSources = post.data.category === 'Shipping and logistics' ? [{label:'ICC Incoterms® 2020',href:'https://iccwbo.org/business-solutions/incoterms-rules/incoterms-2020/',note:'Official global trade-term resource.'},{label:'International Trade Administration: Know Your Incoterms',href:'https://www.trade.gov/know-your-incoterms',note:'Government trade-education resource explaining responsibility questions.'}] : [];
---
<Layout title={`${post.data.title} | Sourcing Ally`} description={post.data.description} lang={lang} noindex={isSanityProxy || lang !== post.data.lang}>
  {!usesFallbackArticle && <script type="application/ld+json" set:html={JSON.stringify(articleJson)}></script>}
  {usesFallbackArticle && availability && <section class="article-availability section-pad"><div class="container availability-inner"><p class="eyebrow">Sourcing Ally Journal</p><h1>{availability.articleTitle}</h1><p>{availability.articleCopy}</p><a class="button" href={`/${lang}/questions/`}>{availability.questionsAction}</a></div></section>}
  <article class:list={['article-page',usesFallbackArticle && 'locale-source-only']}><header class="article-header"><div class="container article-wrap"><a class="back-link" href={`/${lang}/blog/`}>← {articleUi.journal}</a><div class="article-meta"><span>{post.data.category}</span><span>{post.data.pubDate.toLocaleDateString(lang, {year:'numeric',month:'long',day:'numeric'})}</span><span>{post.data.readingTime ?? articleUi.fieldGuide}</span></div><h1>{post.data.title}</h1><p class="article-dek">{post.data.description}</p><div class="article-context"><span>{articleUi.writtenBy} {post.data.author}</span><span>{articleUi.context}</span></div></div></header>{post.data.heroImage && <figure class="container article-hero-visual"><img src={post.data.heroImage} alt={`${post.data.title} — ${visualCaption}`} loading="lazy" /><figcaption>{visualCaption}</figcaption></figure>}<div class="container article-layout"><aside class="article-aside"><p class="eyebrow">{articleUi.inThisGuide}</p><p>{articleUi.aside}</p><a class="text-link" href={`/${lang}/guides/`}>{articleUi.school}</a></aside><div class="article-body"><Content /><div class="article-note"><strong>{articleUi.noteTitle}</strong><p>{articleUi.note}</p></div><section class="article-next-path"><p class="eyebrow">{articleUi.continue}</p><h2>{articleUi.choose}</h2><div class="article-deep-links">{deepLinks.map((link,index)=><a href={localHref(link.href)}><span>0{index+1}</span><b>{link.label}</b><p>{link.note}</p><i>↗</i></a>)}</div></section>{officialSources.length > 0 && <section class="official-sources"><p class="eyebrow">Official resources</p><h2>Further reading for current trade-term questions.</h2><p>These links are provided for education. They do not replace advice for your specific transaction, product, route, or destination.</p><ul>{officialSources.map(source=><li><a href={source.href} target="_blank" rel="noreferrer"><b>{source.label}</b><span>{source.note}</span> ↗</a></li>)}</ul></section>}</div></div></article><script define:vars={{lang}}>document.querySelectorAll('.article-body a[href^="/en/"]').forEach((link) => { const href = link.getAttribute('href'); if (href) link.setAttribute('href', href.replace(/^\/en(?=\/|$)/, `/${lang}`)); });</script>{(previous || next) && <nav class:list={['article-nav',usesFallbackArticle && 'locale-source-only']}><div class="container article-nav-inner">{previous ? <a href={`/${lang}/blog/${previous.data.translationKey ?? previous.id}/`}><small>{articleUi.previous}</small><b>{previous.data.title}</b></a> : <span></span>}{next ? <a href={`/${lang}/blog/${next.data.translationKey ?? next.id}/`}><small>{articleUi.next}</small><b>{next.data.title}</b></a> : <span></span>}</div></nav>}
  <section id="live-sanity-detail" class="section-pad" hidden><div class="container" id="live-sanity-detail-content"></div></section>
  <script define:vars={{lang,isSanityProxy}}>(async()=>{document.querySelectorAll('.article-body a[href^="/en/"]').forEach((link)=>{const href=link.getAttribute('href');if(href)link.setAttribute('href',href.replace(/^\/en(?=\/|$)/,`/${lang}`));});if(!isSanityProxy)return;const pathParts=location.pathname.split('/').filter(Boolean);const directSlug=pathParts[0]===lang&&pathParts[1]==='blog'&&pathParts[2]&&pathParts[2]!=='sanity-article'?decodeURIComponent(pathParts[2]):null;const slug=(new URLSearchParams(location.search).get('article')??directSlug)?.replace(/\/+$/,'');const target=document.querySelector('#live-sanity-detail-content');const wrap=document.querySelector('#live-sanity-detail');const escape=value=>String(value??'').replace(/[&<>'"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));if(!slug||!target||!wrap)return;try{const url=new URL('https://iksqqwui.api.sanity.io/v2025-02-19/data/query/production');url.searchParams.set('query','*[_type == "article" && siteKey == "sourcing-ally" && locale == $locale && slug == $slug][0]{title,description,bodyMarkdown,publishedAt,wordCount}');url.searchParams.set('$locale',JSON.stringify(lang));url.searchParams.set('$slug',JSON.stringify(slug));const response=await fetch(url);const article=response.ok?(await response.json()).result:null;if(!article)return;document.querySelector('.article-page')?.setAttribute('hidden','');document.querySelector('.article-nav')?.setAttribute('hidden','');wrap.hidden=false;document.title=`${article.title} | Sourcing Ally`;target.innerHTML=`<article class="article-layout" style="grid-template-columns:1fr;max-width:850px;margin:0 auto;padding-top:0"><div class="article-body"><a class="back-link" href="/${lang}/blog/">← Journal</a><p class="eyebrow">SOURCING ALLY JOURNAL</p><h1>${escape(article.title)}</h1><p class="article-dek">${escape(article.description)}</p><p class="article-meta" style="margin-top:30px">${new Date(article.publishedAt).toLocaleDateString(lang)} · ${Math.max(1,Math.ceil(article.wordCount/220))} min read</p><div style="margin-top:44px">${escape(article.bodyMarkdown).split(/\n\s*\n/).map(block=>block.startsWith('## ')?`<h2>${escape(block.slice(3))}</h2>`:`<p>${escape(block).replace(/\n/g,'<br>')}</p>`).join('')}</div></div></article>`;}catch{/* Existing Markdown content remains visible as the fallback. */}})();</script>
</Layout>
<style>.article-header{background:#f4f8ff;padding:82px 0 90px;position:relative;overflow:hidden}.article-header:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.article-wrap{max-width:950px;position:relative}.back-link{display:inline-block;color:var(--electric,var(--blue));font-size:.84rem;font-weight:700;margin-bottom:45px}.article-meta{display:flex;gap:17px;flex-wrap:wrap;color:var(--coral);font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;font-weight:800}.article-wrap h1{font-size:clamp(2.8rem,6vw,6rem);line-height:.98;letter-spacing:-.075em;max-width:920px;margin:17px 0 24px}.article-dek{font-size:1.2rem;color:var(--muted);line-height:1.75;max-width:760px;margin:0}.article-context{display:flex;gap:22px;flex-wrap:wrap;margin-top:34px;padding-top:17px;border-top:1px solid var(--line);font-size:.75rem;color:#65758b}.article-hero-visual{margin:0 auto;padding-top:42px;max-width:1200px}.article-hero-visual img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:18px;border:1px solid var(--line);box-shadow:14px 16px 0 rgba(40,103,217,.09)}.article-hero-visual figcaption{margin-top:10px;font-size:.7rem;color:var(--muted);line-height:1.5}.article-layout{display:grid;grid-template-columns:.42fr 1fr;gap:90px;padding-top:82px;padding-bottom:80px}.article-aside{position:sticky;top:110px;align-self:start;padding:22px;border:1px solid var(--line);border-radius:16px;background:white}.article-aside p:not(.eyebrow){font-size:.85rem;line-height:1.7;color:var(--muted)}.article-body{font-size:1.08rem;line-height:1.9;color:#34445a}.article-body h2{font-size:2rem;letter-spacing:-.045em;color:var(--ink);margin:48px 0 13px}.article-body h3{font-size:1.35rem;color:var(--ink);margin:34px 0 8px}.article-body p{margin:0 0 22px}.article-body ul,.article-body ol{padding-left:24px}.article-body li{margin:8px 0}.article-note{border-left:4px solid var(--gold);background:#fff8db;padding:19px 23px;margin-top:48px}.article-note p{font-size:.9rem;margin:7px 0 0}.article-next-path{margin-top:58px;padding-top:45px;border-top:1px solid var(--line)}.article-next-path h2,.official-sources h2{font-size:1.9rem;margin-top:0}.article-deep-links{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:20px}.article-deep-links a{position:relative;border:1px solid var(--line);background:#fff;padding:17px;border-radius:12px;min-height:165px;display:flex;flex-direction:column;transition:.2s}.article-deep-links a:hover{transform:translateY(-4px);box-shadow:7px 9px 0 rgba(40,103,217,.1);border-color:var(--blue)}.article-deep-links span{color:var(--coral);font-size:.65rem;font-weight:800}.article-deep-links b{font-size:.95rem;line-height:1.2;margin:14px 0 7px;color:var(--ink)}.article-deep-links p{font-size:.77rem;line-height:1.55;color:var(--muted);margin:0}.article-deep-links i{font-style:normal;color:var(--blue);margin-top:auto}.official-sources{margin-top:47px;padding:24px;background:#eef4fb;border-radius:14px}.official-sources>p:not(.eyebrow){font-size:.88rem;line-height:1.65}.official-sources ul{padding:0;list-style:none}.official-sources li{margin:9px 0}.official-sources a{display:flex;gap:8px;align-items:baseline;color:var(--blue);font-size:.84rem;line-height:1.55}.official-sources a span{color:var(--muted);font-size:.78rem}.article-nav{background:var(--ink);color:white;padding:38px 0}.article-nav-inner{display:grid;grid-template-columns:1fr 1fr;gap:40px}.article-nav a:last-child{text-align:right}.article-nav small{display:block;color:var(--gold);text-transform:uppercase;letter-spacing:.14em;font-size:.65rem;font-weight:800;margin-bottom:8px}.article-nav b{font-size:1rem;line-height:1.25}@media(max-width:800px){.article-layout{grid-template-columns:1fr;gap:30px;padding-top:55px}.article-aside{position:static}.article-nav-inner{gap:18px}.article-deep-links{grid-template-columns:1fr}}@media(max-width:540px){.article-header{padding:65px 0 70px}.article-wrap h1{font-size:3rem}.article-layout{padding-bottom:55px}.article-body{font-size:1rem}}
.article-availability{background:#f4f8ff}.availability-inner{max-width:780px}.availability-inner h1{font-size:clamp(2.8rem,5.5vw,5.2rem);line-height:1;letter-spacing:-.06em;margin:0 0 22px}.availability-inner>p:not(.eyebrow){font-size:1.1rem;line-height:1.75;color:var(--muted);max-width:680px;margin:0 0 30px}</style>
