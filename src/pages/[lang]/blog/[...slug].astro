---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { lang: post.data.lang, slug: post.id }, props: { post } }));
}
const { post } = Astro.props; const { Content } = await render(post);
const allPosts = (await getCollection('blog', ({data}) => !data.draft && data.lang === post.data.lang)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const currentIndex = allPosts.findIndex(item=>item.id===post.id); const next = allPosts[currentIndex+1]; const previous = allPosts[currentIndex-1];
const articleJson = { '@context':'https://schema.org', '@type':'Article', headline:post.data.title, description:post.data.description, datePublished:post.data.pubDate.toISOString(), dateModified:(post.data.updatedDate ?? post.data.pubDate).toISOString(), author:{'@type':'Person',name:post.data.author}, publisher:{'@type':'Organization',name:'Sourcing Ally',url:'https://sourcingally.com'}, mainEntityOfPage:`https://sourcingally.com/${post.data.lang}/blog/${post.id}/` };
---
<Layout title={`${post.data.title} | Sourcing Ally`} description={post.data.description} lang={post.data.lang}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJson)}></script>
  <article class="article-page"><header class="article-header"><div class="container article-wrap"><a class="back-link" href={`/${post.data.lang}/blog/`}>← Journal</a><div class="article-meta"><span>{post.data.category}</span><span>{post.data.pubDate.toLocaleDateString(post.data.lang, {year:'numeric',month:'long',day:'numeric'})}</span><span>{post.data.readingTime ?? 'Field guide'}</span></div><h1>{post.data.title}</h1><p class="article-dek">{post.data.description}</p><div class="article-context"><span>Written by {post.data.author}</span><span>Based on practical China sourcing questions</span></div></div></header><div class="container article-layout"><aside class="article-aside"><p class="eyebrow">In this guide</p><p>Read the article, note the decisions it raises, and use the related links at the end to continue your research.</p><a class="text-link" href={`/${post.data.lang}/guides/`}>Open Sourcing School ↗</a></aside><div class="article-body"><Content /><div class="article-note"><strong>Keep the next decision visible.</strong><p>Use this article as a starting framework. Product, destination, customs, testing, and commercial details should be checked for the real project before you pay, produce, ship, or sell.</p></div></div></div></article>{(previous || next) && <nav class="article-nav"><div class="container article-nav-inner">{previous ? <a href={`/${post.data.lang}/blog/${previous.id}/`}><small>Previous</small><b>{previous.data.title}</b></a> : <span></span>}{next ? <a href={`/${post.data.lang}/blog/${next.id}/`}><small>Next</small><b>{next.data.title}</b></a> : <span></span>}</div></nav>}
</Layout>
<style>.article-header{background:#f4f8ff;padding:82px 0 90px;position:relative;overflow:hidden}.article-header:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.article-wrap{max-width:950px;position:relative}.back-link{display:inline-block;color:var(--electric,var(--blue));font-size:.84rem;font-weight:700;margin-bottom:45px}.article-meta{display:flex;gap:17px;flex-wrap:wrap;color:var(--coral);font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;font-weight:800}.article-wrap h1{font-size:clamp(2.8rem,6vw,6rem);line-height:.98;letter-spacing:-.075em;max-width:920px;margin:17px 0 24px}.article-dek{font-size:1.2rem;color:var(--muted);line-height:1.75;max-width:760px;margin:0}.article-context{display:flex;gap:22px;flex-wrap:wrap;margin-top:34px;padding-top:17px;border-top:1px solid var(--line);font-size:.75rem;color:#65758b}.article-layout{display:grid;grid-template-columns:.42fr 1fr;gap:90px;padding-top:82px;padding-bottom:80px}.article-aside{position:sticky;top:110px;align-self:start;padding:22px;border:1px solid var(--line);border-radius:16px;background:white}.article-aside p:not(.eyebrow){font-size:.85rem;line-height:1.7;color:var(--muted)}.article-body{font-size:1.08rem;line-height:1.9;color:#34445a}.article-body h2{font-size:2rem;letter-spacing:-.045em;color:var(--ink);margin:48px 0 13px}.article-body h3{font-size:1.35rem;color:var(--ink);margin:34px 0 8px}.article-body p{margin:0 0 22px}.article-body ul,.article-body ol{padding-left:24px}.article-body li{margin:8px 0}.article-note{border-left:4px solid var(--gold);background:#fff8db;padding:19px 23px;margin-top:48px}.article-note p{font-size:.9rem;margin:7px 0 0}.article-nav{background:var(--ink);color:white;padding:38px 0}.article-nav-inner{display:grid;grid-template-columns:1fr 1fr;gap:40px}.article-nav a:last-child{text-align:right}.article-nav small{display:block;color:var(--gold);text-transform:uppercase;letter-spacing:.14em;font-size:.65rem;font-weight:800;margin-bottom:8px}.article-nav b{font-size:1rem;line-height:1.25}@media(max-width:800px){.article-layout{grid-template-columns:1fr;gap:30px;padding-top:55px}.article-aside{position:static}.article-nav-inner{gap:18px}}@media(max-width:540px){.article-header{padding:65px 0 70px}.article-wrap h1{font-size:3rem}.article-layout{padding-bottom:55px}.article-body{font-size:1rem}}
</style>
