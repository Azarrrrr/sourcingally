---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { lang: post.data.lang, slug: post.id }, props: { post } }));
}
const { post } = Astro.props; const { Content } = await render(post);
const allPosts = (await getCollection('blog', ({data}) => !data.draft && data.lang === post.data.lang)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const currentIndex = allPosts.findIndex(item=>item.id===post.id); const next = allPosts[currentIndex+1]; const previous = allPosts[currentIndex-1];
const articleJson = { '@context':'https://schema.org', '@type':'Article', headline:post.data.title, description:post.data.description, datePublished:post.data.pubDate.toISOString(), dateModified:(post.data.updatedDate ?? post.data.pubDate).toISOString(), author:{'@type':'Person',name:post.data.author}, publisher:{'@type':'Organization',name:'Sourcing Ally',url:'https://sourcingally.com'}, mainEntityOfPage:`https://sourcingally.com/${post.data.lang}/blog/${post.id}/` };
const categoryLinks: Record<string, {label:string; href:string; note:string}[]> = {
  'Start importing': [{label:'First Import buyer path',href:'/en/paths/first-import/',note:'Follow a practical route from product idea to shipment preparation.'},{label:'Sourcing Questions',href:'/en/questions/',note:'Find direct answers before you send the first supplier inquiry.'},{label:'Project Brief Builder',href:'/en/start-project/',note:'Turn product facts and unknowns into a clearer first message.'}],
  'Choosing a sourcing partner': [{label:'Buyer Paths',href:'/en/paths/',note:'Choose the sourcing situation that best matches your current project.'},{label:'Supplier sourcing service',href:'/en/services/supplier-sourcing/',note:'Understand the local support that can be discussed for supplier research.'},{label:'Sourcing Questions',href:'/en/questions/',note:'Explore specific agent, supplier, factory, and quality questions.'}],
  'Supplier research': [{label:'Supplier sourcing service',href:'/en/services/supplier-sourcing/',note:'Explore practical local support for supplier research and communication.'},{label:'Factory checks',href:'/en/services/supplier-factory-checks/',note:'See what an agreed supplier or factory visit can help establish.'},{label:'China Visit buyer path',href:'/en/paths/china-visit/',note:'Plan a supplier trip around evidence and next actions.'}],
  'Samples and product development': [{label:'Product Development buyer path',href:'/en/paths/product-development/',note:'Connect product concept, samples, and production decisions.'},{label:'Sample sourcing service',href:'/en/services/sample-sourcing/',note:'Explore sample-related support and communication pathways.'},{label:'Quality-control checklist',href:'/en/guides/quality-control-checklist/',note:'Prepare product-specific checks before production completes.'}],
  'MOQ, quotes, and negotiation': [{label:'Brand / Private Label buyer path',href:'/en/paths/brand-private-label/',note:'Understand how quantity, customization, samples, and packaging connect.'},{label:'Product Brief Builder',href:'/en/start-project/',note:'Create a consistent product request before comparing quotes.'},{label:'Sourcing Questions',href:'/en/questions/',note:'Read direct answers about supplier comparisons and MOQ.'}],
  'Quality control': [{label:'Quality control service',href:'/en/services/quality-control/',note:'Explore quality and final-product check support.'},{label:'Existing Supplier buyer path',href:'/en/paths/existing-supplier-rescue/',note:'Bring an unclear active order back to visible facts and actions.'},{label:'Quality-control checklist',href:'/en/guides/quality-control-checklist/',note:'Build a product-specific inspection brief.'}],
  'Shipping and logistics': [{label:'Shipping from China guide',href:'/en/guides/shipping-from-china/',note:'Review shipment preparation questions and handover planning.'},{label:'Marketplace buyer path',href:'/en/paths/marketplace-seller/',note:'Connect packaging, final checks, and fulfilment questions.'},{label:'Disclaimer',href:'/en/disclaimer/',note:'Understand the limits of general shipping and compliance education.'}]
};
const deepLinks = categoryLinks[post.data.category] ?? [{label:'Sourcing Questions',href:'/en/questions/',note:'Find direct answers for the next sourcing decision.'},{label:'Buyer Paths',href:'/en/paths/',note:'Choose a route that matches your current situation.'},{label:'Project Brief Builder',href:'/en/start-project/',note:'Create a clearer first message for Sourcing Ally.'}];
const officialSources = post.data.category === 'Shipping and logistics' ? [{label:'ICC Incoterms® 2020',href:'https://iccwbo.org/business-solutions/incoterms-rules/incoterms-2020/',note:'Official global trade-term resource.'},{label:'International Trade Administration: Know Your Incoterms',href:'https://www.trade.gov/know-your-incoterms',note:'Government trade-education resource explaining responsibility questions.'}] : [];
---
<Layout title={`${post.data.title} | Sourcing Ally`} description={post.data.description} lang={post.data.lang}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJson)}></script>
  <article class="article-page"><header class="article-header"><div class="container article-wrap"><a class="back-link" href={`/${post.data.lang}/blog/`}>← Journal</a><div class="article-meta"><span>{post.data.category}</span><span>{post.data.pubDate.toLocaleDateString(post.data.lang, {year:'numeric',month:'long',day:'numeric'})}</span><span>{post.data.readingTime ?? 'Field guide'}</span></div><h1>{post.data.title}</h1><p class="article-dek">{post.data.description}</p><div class="article-context"><span>Written by {post.data.author}</span><span>Based on practical China sourcing questions</span></div></div></header><div class="container article-layout"><aside class="article-aside"><p class="eyebrow">In this guide</p><p>Read the article, note the decisions it raises, and use the related links at the end to continue your research.</p><a class="text-link" href={`/${post.data.lang}/guides/`}>Open Sourcing School ↗</a></aside><div class="article-body"><Content /><div class="article-note"><strong>Keep the next decision visible.</strong><p>Use this article as a starting framework. Product, destination, customs, testing, and commercial details should be checked for the real project before you pay, produce, ship, or sell.</p></div><section class="article-next-path"><p class="eyebrow">Continue your research</p><h2>Choose the next decision that fits your project.</h2><div class="article-deep-links">{deepLinks.map((link,index)=><a href={link.href}><span>0{index+1}</span><b>{link.label}</b><p>{link.note}</p><i>↗</i></a>)}</div></section>{officialSources.length > 0 && <section class="official-sources"><p class="eyebrow">Official resources</p><h2>Further reading for current trade-term questions.</h2><p>These links are provided for education. They do not replace advice for your specific transaction, product, route, or destination.</p><ul>{officialSources.map(source=><li><a href={source.href} target="_blank" rel="noreferrer"><b>{source.label}</b><span>{source.note}</span> ↗</a></li>)}</ul></section>}</div></div></article>{(previous || next) && <nav class="article-nav"><div class="container article-nav-inner">{previous ? <a href={`/${post.data.lang}/blog/${previous.id}/`}><small>Previous</small><b>{previous.data.title}</b></a> : <span></span>}{next ? <a href={`/${post.data.lang}/blog/${next.id}/`}><small>Next</small><b>{next.data.title}</b></a> : <span></span>}</div></nav>}
</Layout>
<style>.article-header{background:#f4f8ff;padding:82px 0 90px;position:relative;overflow:hidden}.article-header:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.article-wrap{max-width:950px;position:relative}.back-link{display:inline-block;color:var(--electric,var(--blue));font-size:.84rem;font-weight:700;margin-bottom:45px}.article-meta{display:flex;gap:17px;flex-wrap:wrap;color:var(--coral);font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;font-weight:800}.article-wrap h1{font-size:clamp(2.8rem,6vw,6rem);line-height:.98;letter-spacing:-.075em;max-width:920px;margin:17px 0 24px}.article-dek{font-size:1.2rem;color:var(--muted);line-height:1.75;max-width:760px;margin:0}.article-context{display:flex;gap:22px;flex-wrap:wrap;margin-top:34px;padding-top:17px;border-top:1px solid var(--line);font-size:.75rem;color:#65758b}.article-layout{display:grid;grid-template-columns:.42fr 1fr;gap:90px;padding-top:82px;padding-bottom:80px}.article-aside{position:sticky;top:110px;align-self:start;padding:22px;border:1px solid var(--line);border-radius:16px;background:white}.article-aside p:not(.eyebrow){font-size:.85rem;line-height:1.7;color:var(--muted)}.article-body{font-size:1.08rem;line-height:1.9;color:#34445a}.article-body h2{font-size:2rem;letter-spacing:-.045em;color:var(--ink);margin:48px 0 13px}.article-body h3{font-size:1.35rem;color:var(--ink);margin:34px 0 8px}.article-body p{margin:0 0 22px}.article-body ul,.article-body ol{padding-left:24px}.article-body li{margin:8px 0}.article-note{border-left:4px solid var(--gold);background:#fff8db;padding:19px 23px;margin-top:48px}.article-note p{font-size:.9rem;margin:7px 0 0}.article-next-path{margin-top:58px;padding-top:45px;border-top:1px solid var(--line)}.article-next-path h2,.official-sources h2{font-size:1.9rem;margin-top:0}.article-deep-links{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:20px}.article-deep-links a{position:relative;border:1px solid var(--line);background:#fff;padding:17px;border-radius:12px;min-height:165px;display:flex;flex-direction:column;transition:.2s}.article-deep-links a:hover{transform:translateY(-4px);box-shadow:7px 9px 0 rgba(40,103,217,.1);border-color:var(--blue)}.article-deep-links span{color:var(--coral);font-size:.65rem;font-weight:800}.article-deep-links b{font-size:.95rem;line-height:1.2;margin:14px 0 7px;color:var(--ink)}.article-deep-links p{font-size:.77rem;line-height:1.55;color:var(--muted);margin:0}.article-deep-links i{font-style:normal;color:var(--blue);margin-top:auto}.official-sources{margin-top:47px;padding:24px;background:#eef4fb;border-radius:14px}.official-sources>p:not(.eyebrow){font-size:.88rem;line-height:1.65}.official-sources ul{padding:0;list-style:none}.official-sources li{margin:9px 0}.official-sources a{display:flex;gap:8px;align-items:baseline;color:var(--blue);font-size:.84rem;line-height:1.55}.official-sources a span{color:var(--muted);font-size:.78rem}.article-nav{background:var(--ink);color:white;padding:38px 0}.article-nav-inner{display:grid;grid-template-columns:1fr 1fr;gap:40px}.article-nav a:last-child{text-align:right}.article-nav small{display:block;color:var(--gold);text-transform:uppercase;letter-spacing:.14em;font-size:.65rem;font-weight:800;margin-bottom:8px}.article-nav b{font-size:1rem;line-height:1.25}@media(max-width:800px){.article-layout{grid-template-columns:1fr;gap:30px;padding-top:55px}.article-aside{position:static}.article-nav-inner{gap:18px}.article-deep-links{grid-template-columns:1fr}}@media(max-width:540px){.article-header{padding:65px 0 70px}.article-wrap h1{font-size:3rem}.article-layout{padding-bottom:55px}.article-body{font-size:1rem}}
</style>
