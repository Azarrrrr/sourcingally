---
import Layout from '../../../layouts/Layout.astro';

const locales = ['en','es','pt','ru','tr','fr','ja','de','ar','id','it'] as const;
type PublishedArticle = { title: string; slug: string; description: string; bodyMarkdown?: string; publishedAt: string; wordCount?: number; locale: string };
export async function getStaticPaths() {
  const endpoint = 'https://iksqqwui.api.sanity.io/v2025-02-19/data/query/production';
  const query = '*[_type == "article" && siteKey == "sourcing-ally" && defined(locale) && defined(slug)]{title,slug,description,bodyMarkdown,publishedAt,wordCount,locale}';
  const response = await fetch(`${endpoint}?query=${encodeURIComponent(query)}`);
  if (!response.ok) throw new Error(`Unable to load published SourcingAlly articles: ${response.status}`);
  const articles = ((await response.json()) as { result: PublishedArticle[] }).result;
  const supportedLocales = ['en','es','pt','ru','tr','fr','ja','de','ar','id','it'];
  return articles.filter((article) => supportedLocales.includes(article.locale)).map((article) => ({ params: { lang: article.locale, slug: article.slug }, props: { article } }));
}
const { article } = Astro.props as { article: PublishedArticle };
const lang = article.locale;
const blocks = (article.bodyMarkdown ?? '').split(/\n\s*\n/).map((block) => block.trim()).filter(Boolean);
const headings = blocks.filter((block) => block.startsWith('## ')).map((block) => block.slice(3));
const date = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(article.publishedAt));
const minutes = Math.max(1, Math.ceil((Number(article.wordCount) || 220) / 220));
const back = lang === 'es' ? 'Volver al diario' : lang === 'pt' ? 'Voltar ao diário' : lang === 'ru' ? 'Вернуться в журнал' : lang === 'tr' ? 'Günlüğe dön' : lang === 'fr' ? 'Retour au journal' : 'Back to journal';
---
<Layout title={`${article.title} | Sourcing Ally`} description={article.description} lang={lang}>
  <main>
    <article>
      <header class="article-header"><div class="container article-wrap"><a class="back-link" href={`/${lang}/blog/`}>← {back}</a><p class="article-meta">SOURCING ALLY JOURNAL · {date} · {minutes} min read</p><h1>{article.title}</h1><p class="article-dek">{article.description}</p></div></header>
      <div class="container article-layout"><div class="article-body">{blocks.map((block, index) => block.startsWith('## ') ? <h2 id={`field-guide-section-${headings.indexOf(block.slice(3)) + 1}`}>{block.slice(3)}</h2> : block.split('\n').every((line) => line.startsWith('- ')) ? <ul>{block.split('\n').map((line) => <li>{line.slice(2)}</li>)}</ul> : <p>{block}</p>)}</div>{headings.length > 0 && <aside class="article-aside"><p class="eyebrow">FIELD GUIDE</p><strong>In this article</strong><ol>{headings.map((heading, index) => <li><a href={`#field-guide-section-${index + 1}`}>{String(index + 1).padStart(2, '0')} · {heading}</a></li>)}</ol><a class="back-link" href={`/${lang}/blog/`}>{back} →</a></aside>}</div>
    </article>
  </main>
</Layout>
<style>.article-header{background:#f4f8ff;padding:82px 0 90px;position:relative;overflow:hidden}.article-header:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.article-wrap{max-width:950px;position:relative}.back-link{display:inline-block;color:var(--electric,var(--blue));font-size:.84rem;font-weight:700;margin-bottom:30px}.article-meta{color:var(--coral);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;font-weight:800}.article-wrap h1{font-size:clamp(2.8rem,6vw,6rem);line-height:.98;letter-spacing:-.075em;max-width:920px;margin:17px 0 24px}.article-dek{font-size:1.2rem;color:var(--muted);line-height:1.75;max-width:760px;margin:0}.article-layout{display:grid;grid-template-columns:minmax(0,1fr) 265px;gap:70px;padding-top:82px;padding-bottom:80px;max-width:1160px}.article-body{font-size:1.08rem;line-height:1.9;color:#34445a}.article-body h2{font-size:2rem;letter-spacing:-.045em;color:var(--ink);margin:48px 0 13px}.article-body p{margin:0 0 22px}.article-body ul{padding-left:24px}.article-body li{margin:8px 0}.article-aside{position:sticky;top:92px;align-self:start;height:fit-content;padding:20px;border-left:3px solid var(--electric,var(--blue));background:#f4f8ff}.article-aside>strong{display:block;margin:8px 0 15px;color:var(--ink);font-size:.95rem}.article-aside ol{display:grid;gap:9px;margin:0 0 20px;padding:0;list-style:none}.article-aside li a{color:var(--muted);font-size:.78rem;line-height:1.35;text-decoration:none}.article-aside li a:hover{color:var(--electric,var(--blue))}@media(max-width:760px){.article-layout{grid-template-columns:1fr;gap:0;padding-top:55px}.article-aside{display:none}}</style>
