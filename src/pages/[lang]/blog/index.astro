---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { localeAvailability } from '../../../data/locale-availability';
import { getSanityArticle, listSanityArticles } from '../../../lib/sanityPublic';
import '../../../styles/fieldGuide.css';
import '../../../styles/journalArchiveUpgrade.css';
const labels = { en:{title:'Sourcing Ally Journal',description:'Practical notes about sourcing and importing from China.',kicker:'The journal',heading:'Field notes, sourcing lessons, and useful context.',intro:'A growing editorial resource for buyers who want to understand what happens between a product idea and a shipment from China.',read:'Read article',minutes:'min read',previous:'Previous',next:'Next',page:'Page'}, es:{title:'Diario de Sourcing Ally',description:'Notas prácticas sobre compras e importación desde China.',kicker:'El diario',heading:'Notas de campo y lecciones de compras.',intro:'Una biblioteca editorial para compradores que quieren entender el proceso.',read:'Leer artículo',minutes:'min de lectura',previous:'Anterior',next:'Siguiente',page:'Página'}, pt:{title:'Diário da Sourcing Ally',description:'Notas práticas sobre compras e importação da China.',kicker:'O diário',heading:'Notas de campo e lições de compras.',intro:'Uma biblioteca editorial para compradores que querem entender o processo.',read:'Ler artigo',minutes:'min de leitura',previous:'Anterior',next:'Seguinte',page:'Página'}, ru:{title:'Журнал Sourcing Ally',description:'Практические заметки о закупках и импорте из Китая.',kicker:'Журнал',heading:'Полевые заметки и уроки закупок.',intro:'Редакционная библиотека для покупателей, которые хотят понимать процесс.',read:'Читать статью',minutes:'мин. чтения',previous:'Назад',next:'Далее',page:'Страница'}, tr:{title:'Sourcing Ally Günlüğü',description:'Çin’den tedarik ve ithalat hakkında pratik notlar.',kicker:'Günlük',heading:'Saha notları ve tedarik dersleri.',intro:'Süreci anlamak isteyen alıcılar için editoryal bir kaynak.',read:'Yazıyı okuyun',minutes:'dk okuma',previous:'Önceki',next:'Sonraki',page:'Sayfa'} };
export function getStaticPaths(){return ['en','es','pt','ru','tr','fr','ja','de','ar','id','it'].map(lang=>({params:{lang},props:{lang}}))}
const {lang}=Astro.props; const t=labels[lang as keyof typeof labels] ?? labels.en;
const localizedPosts=(await getCollection('blog', ({data})=>!data.draft && data.lang===lang)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const englishFallbackPosts=(await getCollection('blog', ({data})=>!data.draft && data.lang==='en')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const usesFallback = lang !== 'en' && localizedPosts.length === 0;
const availability = lang === 'en' ? undefined : localeAvailability[lang as keyof typeof localeAvailability];
const posts = usesFallback ? [] : localizedPosts;
const featured=posts.find(post=>post.data.featured) ?? posts[0]; const rest=posts.filter(post=>post.id!==featured?.id);
const categories=[...new Set(posts.map(post=>post.data.category))];
let generatedSanityArticles: Awaited<ReturnType<typeof listSanityArticles>> = [];
try { generatedSanityArticles = await listSanityArticles(lang); } catch { /* The existing static journal remains available during build-time network failures. */ }
const generatedSanitySlugs = generatedSanityArticles.map((article) => article.slug);
---
<Layout title={t.title} description={t.description} lang={lang} noindex={usesFallback}>
  {usesFallback && availability && <section class="journal-availability section-pad"><div class="container availability-inner"><p class="eyebrow">{t.kicker}</p><h1>{availability.journalTitle}</h1><p>{availability.journalCopy}</p><a class="button" href={`/${lang}/questions/`}>{availability.journalAction}</a></div></section>}
  <section class:list={['journal-hero',usesFallback && 'locale-source-only']}><div class="container journal-hero-grid"><div><p class="eyebrow">{t.kicker}</p><h1>{t.heading}</h1><p class="hero-intro">{t.intro}</p></div><div class="journal-mark"><span>SA / LIVE</span><b>READ<br/>THE<br/>DETAILS</b><i></i></div></div></section>
  <section id="sanity-journal" class="section-pad" data-lang={lang} hidden><div class="container" id="sanity-journal-content"></div></section>
  <section class:list={['journal-toolbar','section-pad',usesFallback && 'locale-source-only']}><div class="container toolbar-inner"><div><p class="eyebrow">Explore by topic</p><div class="topic-pills">{categories.map(category=><span>{category}</span>)}</div></div><p class="toolbar-note">The Journal is written as a growing knowledge library. Evergreen guides remain useful; dated field notes show what is changing.</p></div></section>
  {featured && <section class:list={['featured-post','section-pad','section-light',usesFallback && 'locale-source-only']}><div class="container featured-post-grid"><div class="featured-art"><span>FEATURED</span><b>{featured.data.category}</b><i>↗</i></div><div><p class="post-meta">{featured.data.pubDate.toLocaleDateString(lang, {month:'long',day:'numeric'})} · {featured.data.readingTime ?? 'Guide'}</p><h2>{featured.data.title}</h2><p class="featured-description">{featured.data.description}</p><a class="button" href={`/${lang}/blog/${featured.data.translationKey ?? featured.id}/`}>{t.read} ↗</a></div></div></section>}
  <section class:list={['journal-grid-section','section-pad',usesFallback && 'locale-source-only']}><div class="container"><div class="section-heading"><div><p class="eyebrow">Latest thinking</p><h2>Keep a useful question open.</h2></div><p>Each article should leave you with a better brief, a sharper supplier question, or a clearer next decision.</p></div><div class="journal-grid">{rest.length ? rest.map(post=><a class="journal-card" href={`/${lang}/blog/${post.data.translationKey ?? post.id}/`}><div class="post-meta"><span>{post.data.category}</span> · {post.data.pubDate.toLocaleDateString(lang, {month:'short',day:'numeric'})}</div><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="journal-card-bottom"><small>{post.data.readingTime ?? 'Read the guide'}</small><span>Open ↗</span></div></a>) : <p>New guides appear here as they are published to the shared knowledge library.</p>}</div></div></section>
  <section class:list={['journal-how',usesFallback && 'locale-source-only']}><div class="container journal-how-grid"><div><p class="eyebrow">Decision standard</p><h2>Information you can compare.</h2></div><div><p>Each guide is written to clarify a sourcing decision, document the evidence worth keeping, and make the next conversation with a supplier more precise. Articles become available in the journal as soon as they are published for the selected language.</p><a class="text-link" href={`/${lang}/guides/how-to-import-from-china/`}>Read the sourcing school ↗</a></div></div></section>
  <script define:vars={{lang,t,generatedSanitySlugs,generatedSanityArticles}}>
    ;(async()=>{
    const target=document.querySelector('#sanity-journal-content'); const wrap=document.querySelector('#sanity-journal'); const searchParams=new URLSearchParams(location.search); const pathParts=location.pathname.split('/').filter(Boolean); const directSlug=pathParts[0]===lang && pathParts[1]==='blog' && pathParts[2] ? decodeURIComponent(pathParts[2]) : null; const articleSlug=(searchParams.get('article') ?? directSlug)?.replace(/\/+$/, ''); const pageSize=12; // The production build embeds the indexed Sanity list so the public archive stays reliable without a browser-side list request.
    const attachFieldGuide=()=>{const article=target?.querySelector('.article-body')?.closest('article');const body=article?.querySelector('.article-body');if(!article||!body||article.dataset.fieldGuide==='ready')return;const headings=[...body.querySelectorAll('h2')];if(!headings.length)return;article.dataset.fieldGuide='ready';headings.forEach((heading,index)=>heading.id=`field-guide-${index+1}`);const list=headings.map((heading,index)=>`<li><a href="#field-guide-${index+1}"><span>${String(index+1).padStart(2,'0')}</span>${escape(heading.textContent)}</a></li>`).join('');const layout=document.createElement('div');layout.className='field-guide-layout';const mobile=document.createElement('details');mobile.className='field-guide-mobile';mobile.innerHTML=`<summary>${escape(lang==='es'?'En este artículo':lang==='pt'?'Neste artigo':lang==='ru'?'В этой статье':lang==='tr'?'Bu makalede':'In this article')}<span>${headings.length}</span></summary><ol>${list}</ol>`;const panel=document.createElement('aside');panel.className='field-guide-panel';panel.innerHTML=`<span>${escape(lang==='es'?'Guía de campo':'Field Guide')}</span><strong>${escape(lang==='es'?'En este artículo':'In this article')}</strong><ol>${list}</ol><a href="/${lang}/blog/">${escape(lang==='es'?'Seguir leyendo':'Keep reading')} →</a>`;body.parentElement?.insertBefore(layout,body);layout.append(mobile,body,panel)};if(typeof MutationObserver!=='undefined')new MutationObserver(attachFieldGuide).observe(target,{childList:true,subtree:true});
    const endpoint='https://iksqqwui.api.sanity.io/v2025-02-19/data/query/production'; const run=async(query,params)=>{const url=new URL(endpoint);url.searchParams.set('query',query);Object.entries(params).forEach(([key,value])=>url.searchParams.set(`$${key}`,JSON.stringify(value)));const response=await fetch(url);if(!response.ok)throw new Error();return (await response.json()).result}; const escape=value=>String(value??'').replace(/[&<>'"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char])); const detailHref=slug=>generatedSanitySlugs.includes(slug)?`/${lang}/blog/${encodeURIComponent(slug)}/`:`/${lang}/blog/sanity-article/?article=${encodeURIComponent(slug)}`; const formatDate=value=>new Intl.DateTimeFormat(lang==='pt'?'pt-BR':lang,{month:'long',day:'numeric',timeZone:'UTC'}).format(new Date(value)); const readingMinutes=wordCount=>Math.max(1,Math.ceil((Number(wordCount)||220)/220)); const normalizeSearch=value=>String(value??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase(); const visiblePages=(totalPages,currentPage)=>{if(totalPages<=7)return Array.from({length:totalPages},(_,index)=>index+1);const pages=new Set([1,totalPages,currentPage-1,currentPage,currentPage+1]);if(currentPage<=4)[2,3,4,5].forEach(page=>pages.add(page));if(currentPage>=totalPages-3)[totalPages-1,totalPages-2,totalPages-3,totalPages-4].forEach(page=>pages.add(page));const sorted=[...pages].filter(page=>page>=1&&page<=totalPages).sort((a,b)=>a-b);return sorted.flatMap((page,index)=>index&&page-sorted[index-1]>1?['ellipsis',page]:[page])};
    try{if(articleSlug){const article=await run('*[_type == "article" && siteKey == "sourcing-ally" && locale == $locale && slug == $slug][0]{title,description,bodyMarkdown,publishedAt,wordCount}',{locale:lang,slug:articleSlug});if(article){wrap.hidden=false;document.querySelectorAll('main > section:not(#sanity-journal)').forEach(node=>node.hidden=true);target.innerHTML=`<article class="container" style="max-width:850px"><a class="text-link" href="/${lang}/blog/">← ${escape(t.read)}</a><p class="eyebrow" style="margin-top:30px">SOURCING ALLY JOURNAL / ${formatDate(article.publishedAt)} · ${readingMinutes(article.wordCount)} ${escape(t.minutes)}</p><h1 style="font-size:clamp(2.7rem,6vw,5.6rem);line-height:.98;letter-spacing:-.07em">${escape(article.title)}</h1><p class="hero-intro">${escape(article.description)}</p><div class="article-body" style="margin-top:44px">${escape(article.bodyMarkdown).split(/\n\s*\n/).map(block=>block.startsWith('## ')?`<h2>${escape(block.slice(3))}</h2>`:`<p>${escape(block).replace(/\n/g,'<br>')}</p>`).join('')}</div></article>`;}}else{const articles=generatedSanityArticles; if(articles.length){const searchTerm=searchParams.get('search')??'';const needle=normalizeSearch(searchTerm);const filteredArticles=articles.filter(article=>!needle||normalizeSearch(`${article.title} ${article.description}`).includes(needle));const totalPages=Math.max(1,Math.ceil(filteredArticles.length/pageSize));const candidate=Number.parseInt(searchParams.get('page')??'1',10);const currentPage=Math.min(Math.max(Number.isFinite(candidate)?candidate:1,1),totalPages);const currentArticles=filteredArticles.slice((currentPage-1)*pageSize,currentPage*pageSize);const pageHref=page=>{const params=new URLSearchParams();if(searchTerm)params.set('search',searchTerm);if(page>1)params.set('page',String(page));return `/${lang}/blog/${params.toString()?`?${params}`:''}`};const pageButtons=visiblePages(totalPages,currentPage).map(item=>item==='ellipsis'?`<span class="journal-page-ellipsis" aria-hidden="true">…</span>`:`<a class="journal-page-number ${item===currentPage?'is-current':''}" ${item===currentPage?'aria-current="page"':''} href="${pageHref(item)}" aria-label="${escape(t.page)} ${item}">${item}</a>`).join('');const searchTools=`<form class="journal-archive-tools" data-journal-search action="/${lang}/blog/" method="get" role="search"><label class="journal-archive-search"><span aria-hidden="true">⌕</span><input name="search" type="search" value="${escape(searchTerm)}" placeholder="Search published field notes" autocomplete="off"></label><button type="submit">Search</button>${searchTerm?`<a href="/${lang}/blog/">Clear</a>`:''}<p class="journal-archive-count">${searchTerm?`${filteredArticles.length} matching notes`:`${articles.length} published notes`}</p></form>`;wrap.hidden=false;document.querySelectorAll('.featured-post,.journal-grid-section,.journal-toolbar').forEach(node=>node.hidden=true);target.innerHTML=`<div class="section-heading"><div><p class="eyebrow">JOURNAL</p><h2>Latest published articles</h2></div><p>${escape(t.intro)}</p></div>${searchTools}${currentArticles.length?`<div class="journal-grid">${currentArticles.map(article=>`<a class="journal-card" href="${detailHref(article.slug)}"><div class="post-meta">${formatDate(article.publishedAt)} · ${readingMinutes(article.wordCount)} ${escape(t.minutes)}</div><h3>${escape(article.title)}</h3><p>${escape(article.description)}</p><div class="journal-card-bottom"><small>FIELD NOTE</small><span>${escape(t.read)} ↗</span></div></a>`).join('')}</div>`:`<p class="journal-no-results">No published notes match that search. <a href="/${lang}/blog/">Clear the search</a>.</p>`}${filteredArticles.length>pageSize?`<nav class="journal-pagination" aria-label="${escape(t.page)}"><a class="${currentPage===1?'is-disabled':''}" ${currentPage===1?'aria-disabled="true"':`href="${pageHref(currentPage-1)}"`}>← ${escape(t.previous)}</a><div class="journal-page-numbers">${pageButtons}</div><a class="${currentPage===totalPages?'is-disabled':''}" ${currentPage===totalPages?'aria-disabled="true"':`href="${pageHref(currentPage+1)}"`}>${escape(t.next)} →</a></nav>`:''}`;}}}catch{ /* The local Markdown collection remains available if the build-time journal data is unavailable. */ }
    })();
  </script>
  <script is:inline>
    (() => {
      const target = document.querySelector('#sanity-journal-content');
      const enhanceArchive = () => {
        const grid = target?.querySelector('.journal-grid');
        if (!grid || target?.querySelector('[data-journal-search]') || grid.dataset.archiveControls === 'ready') return;
        grid.dataset.archiveControls = 'ready';
        const cards = [...grid.querySelectorAll('.journal-card')];
        if (!cards.length) return;
        const tools = document.createElement('div');
        tools.className = 'journal-archive-tools';
        tools.innerHTML = `<label class="journal-archive-search"><span aria-hidden="true">⌕</span><input type="search" placeholder="Search published field notes" autocomplete="off"></label><p class="journal-archive-count">${cards.length} published notes</p>`;
        grid.before(tools);
        const input = tools.querySelector('input');
        const count = tools.querySelector('.journal-archive-count');
        input?.addEventListener('input', () => {
          const needle = input.value.trim().toLowerCase();
          let visible = 0;
          cards.forEach((card) => { const matches = card.textContent.toLowerCase().includes(needle); card.hidden = !matches; if (matches) visible += 1; });
          if (count) count.textContent = `${visible} ${visible === 1 ? 'published note' : 'published notes'}`;
        });
      };
      new MutationObserver(enhanceArchive).observe(target, { childList: true, subtree: true });
      enhanceArchive();
    })();
  </script>
</Layout>
<style>.journal-hero{padding:95px 0 110px;background:#f4f8ff;position:relative;overflow:hidden}.journal-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.42}.journal-hero-grid{display:grid;grid-template-columns:1fr .55fr;gap:80px;align-items:center;position:relative}.journal-hero h1{font-size:clamp(3rem,6vw,6.1rem);line-height:.97;letter-spacing:-.075em;max-width:850px;margin:0 0 24px}.journal-hero .hero-intro{max-width:700px;color:var(--muted);font-size:1.15rem;line-height:1.75}.journal-stat{display:flex;gap:16px;align-items:center;margin-top:42px;padding-top:18px;border-top:1px solid var(--line);max-width:510px}.journal-stat span{font-size:.66rem;letter-spacing:.13em;color:var(--coral);font-weight:800}.journal-stat b{font-size:.82rem}.journal-mark{justify-self:end;width:330px;height:330px;background:var(--gold);border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;position:relative;box-shadow:16px 16px 0 rgba(40,103,217,.13);transform:rotate(-7deg)}.journal-mark span{position:absolute;top:45px;right:52px;font-size:.67rem;color:var(--coral);font-weight:800}.journal-mark b{font-size:3rem;line-height:.86;letter-spacing:-.08em;align-self:flex-start;margin-left:70px}.journal-mark i{position:absolute;width:72%;height:36%;border:1px solid rgba(13,43,80,.3);border-radius:50%;transform:rotate(-30deg)}.journal-toolbar{background:white;padding:45px 0}.toolbar-inner{display:flex;justify-content:space-between;gap:40px;align-items:end}.topic-pills{display:flex;flex-wrap:wrap;gap:7px}.topic-pills span{border:1px solid var(--line);border-radius:99px;padding:8px 13px;font-size:.74rem;color:var(--blue);font-weight:700}.toolbar-note{color:var(--muted);font-size:.85rem;line-height:1.7;max-width:350px;margin:0}.featured-post{background:#eef4fb}.featured-post-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:85px;align-items:center}.featured-art{aspect-ratio:1.45;background:linear-gradient(145deg,var(--ink),var(--electric,var(--blue)));border-radius:24px;position:relative;overflow:hidden;color:white;display:flex;flex-direction:column;justify-content:space-between;padding:25px;box-shadow:17px 17px 0 rgba(247,201,72,.6)}.featured-art:after{content:"";position:absolute;width:360px;height:360px;border:1px solid rgba(255,255,255,.3);border-radius:50%;right:-100px;bottom:-170px}.featured-art span{font-size:.68rem;letter-spacing:.16em;color:var(--gold);font-weight:800}.featured-art b{font-size:1.4rem;max-width:230px;line-height:1.1;position:relative;z-index:2}.featured-art i{position:absolute;right:23px;top:23px;font-size:2rem}.featured-post h2{font-size:clamp(2.2rem,4vw,4.4rem);line-height:1.02;letter-spacing:-.06em;margin:14px 0}.featured-description{color:var(--muted);font-size:1rem;line-height:1.75;max-width:620px;margin-bottom:26px}.post-meta{color:var(--coral);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;font-weight:800}.journal-grid-section{background:white}.journal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.journal-card{border:1px solid var(--line);border-radius:18px;padding:25px;min-height:270px;display:flex;flex-direction:column;transition:.25s;color:inherit;text-decoration:none}.journal-card:hover{transform:translateY(-6px);box-shadow:10px 12px 0 rgba(40,103,217,.1);border-color:var(--electric,var(--blue))}.journal-card h3{font-size:1.3rem;line-height:1.12;letter-spacing:-.04em;margin:17px 0 10px}.journal-card p{color:var(--muted);font-size:.88rem;line-height:1.7;margin:0}.journal-card-bottom{margin-top:auto;display:flex;justify-content:space-between;align-items:center;padding-top:20px}.journal-card-bottom small{color:var(--muted);font-size:.7rem}.journal-card-bottom span,.text-link{color:var(--electric,var(--blue));font-weight:750;font-size:.82rem}.journal-pagination{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);margin-top:34px;padding-top:20px;font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.journal-pagination a{color:var(--electric,var(--blue));text-decoration:none}.journal-pagination .is-disabled{opacity:.35;pointer-events:none}.journal-page-numbers{display:flex;flex-wrap:wrap;gap:7px;justify-content:center}.journal-page-number{align-items:center;border:1px solid var(--line);display:inline-flex;height:38px;justify-content:center;min-width:38px}.journal-page-number.is-current{background:var(--ink);border-color:var(--ink);color:white}.journal-page-ellipsis{align-items:center;display:inline-flex;justify-content:center;min-width:18px}.journal-how{background:var(--ink);color:white;padding:75px 0}.journal-how-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px}.journal-how h2{font-size:clamp(2.2rem,4vw,4rem);line-height:1.02;letter-spacing:-.06em;margin:0}.journal-how p{color:#cbd8e8;line-height:1.8}.journal-how .eyebrow{color:var(--gold)}@media(max-width:800px){.journal-hero-grid,.featured-post-grid,.journal-how-grid{grid-template-columns:1fr;gap:45px}.journal-mark{justify-self:start;width:280px;height:280px}.toolbar-inner{align-items:flex-start;flex-direction:column}.journal-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.journal-hero{padding:75px 0 80px}.journal-hero h1{font-size:3.1rem}.journal-grid{grid-template-columns:1fr}.journal-mark b{font-size:2.4rem}.journal-pagination{font-size:.64rem}.journal-pagination>a{font-size:0}.journal-pagination>a::first-letter{font-size:1rem}.journal-page-numbers{gap:5px}.journal-page-number{height:36px;min-width:36px}}
.journal-availability{background:#f4f8ff}.availability-inner{max-width:780px}.availability-inner h1{font-size:clamp(2.8rem,5.5vw,5.2rem);line-height:1;letter-spacing:-.06em;margin:0 0 22px}.availability-inner>p:not(.eyebrow){font-size:1.1rem;line-height:1.75;color:var(--muted);max-width:680px;margin:0 0 30px}</style>
