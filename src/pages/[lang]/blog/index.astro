---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/fieldGuide.css';
import '../../../styles/journalArchiveUpgrade.css';

const labels = {
  en: { title: 'Sourcing Ally Journal', heading: 'Field notes, sourcing lessons, and useful context.', intro: 'Published sourcing notes for buyers who want clearer supplier, product, and shipment decisions.', read: 'Read article', empty: 'No published articles are available in this language yet.' },
  es: { title: 'Diario de Sourcing Ally', heading: 'Notas de campo y lecciones de compras.', intro: 'Notas publicadas para decisiones más claras de proveedor, producto y envío.', read: 'Leer artículo', empty: 'Todavía no hay artículos publicados en este idioma.' },
  pt: { title: 'Diário da Sourcing Ally', heading: 'Notas de campo e lições de compras.', intro: 'Notas publicadas para decisões mais claras de fornecedor, produto e envio.', read: 'Ler artigo', empty: 'Ainda não há artigos publicados neste idioma.' },
  ru: { title: 'Журнал Sourcing Ally', heading: 'Полевые заметки и уроки закупок.', intro: 'Опубликованные материалы для более ясных решений о поставщиках, товарах и отгрузках.', read: 'Читать статью', empty: 'На этом языке пока нет опубликованных статей.' },
  tr: { title: 'Sourcing Ally Günlüğü', heading: 'Saha notları ve tedarik dersleri.', intro: 'Tedarikçi, ürün ve sevkiyat kararları için yayımlanmış notlar.', read: 'Yazıyı okuyun', empty: 'Bu dilde henüz yayımlanmış makale yok.' },
  fr: { title: 'Journal Sourcing Ally', heading: 'Notes de terrain et leçons de sourcing.', intro: 'Des articles publiés pour des décisions plus claires sur les fournisseurs, les produits et les expéditions.', read: 'Lire l’article', empty: 'Aucun article n’est encore publié dans cette langue.' },
};
export function getStaticPaths() { return ['en','es','pt','ru','tr','fr','ja','de','ar','id','it'].map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props;
const t = labels[lang as keyof typeof labels] ?? labels.en;
const endpoint = 'https://iksqqwui.api.sanity.io/v2025-02-19/data/query/production';
const query = '*[_type == "article" && siteKey == "sourcing-ally" && locale == $locale] | order(publishedAt desc){title,slug,description,publishedAt,wordCount}';
const url = new URL(endpoint); url.searchParams.set('query', query); url.searchParams.set('$locale', JSON.stringify(lang));
const response = await fetch(url);
if (!response.ok) throw new Error(`Unable to load published SourcingAlly articles: ${response.status}`);
const articles = ((await response.json()) as { result: { title: string; slug: string; description: string; publishedAt: string; wordCount?: number }[] }).result;
const date = (value: string) => new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang, { month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(value));
const minutes = (wordCount?: number) => Math.max(1, Math.ceil((Number(wordCount) || 220) / 220));
---
<Layout title={t.title} description={t.intro} lang={lang}>
  <main>
    <section class="journal-hero"><div class="container journal-hero-grid"><div><p class="eyebrow">SOURCING ALLY / JOURNAL</p><h1>{t.heading}</h1><p class="hero-intro">{t.intro}</p></div><div class="journal-mark"><span>SA / LIVE</span><b>READ<br/>THE<br/>DETAILS</b></div></div></section>
    <section class="section-pad journal-grid-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">PUBLISHED LIBRARY</p><h2>{articles.length} published notes</h2></div><p>{t.intro}</p></div>{articles.length ? <div class="journal-grid">{articles.map((article) => <a class="journal-card" href={`/${lang}/blog/${article.slug}/`}><div class="post-meta">{date(article.publishedAt)} · {minutes(article.wordCount)} min read</div><h3>{article.title}</h3><p>{article.description}</p><div class="journal-card-bottom"><small>FIELD NOTE</small><span>{t.read} ↗</span></div></a>)}</div> : <p class="journal-empty">{t.empty}</p>}</div></section>
  </main>
</Layout>
<style>.journal-hero{padding:95px 0 110px;background:#f4f8ff;position:relative;overflow:hidden}.journal-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.42}.journal-hero-grid{display:grid;grid-template-columns:1fr .55fr;gap:80px;align-items:center;position:relative}.journal-hero h1{font-size:clamp(3rem,6vw,6.1rem);line-height:.97;letter-spacing:-.075em;max-width:850px;margin:0 0 24px}.hero-intro{max-width:700px;color:var(--muted);font-size:1.15rem;line-height:1.75}.journal-mark{justify-self:end;width:330px;height:330px;background:var(--gold);border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;position:relative;box-shadow:16px 16px 0 rgba(40,103,217,.13);transform:rotate(-7deg)}.journal-mark span{position:absolute;top:45px;right:52px;font-size:.67rem;color:var(--coral);font-weight:800}.journal-mark b{font-size:3rem;line-height:.86;letter-spacing:-.08em;align-self:flex-start;margin-left:70px}.journal-grid-section{background:white}.journal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.journal-card{border:1px solid var(--line);border-radius:18px;padding:25px;min-height:270px;display:flex;flex-direction:column;transition:.25s;color:inherit;text-decoration:none}.journal-card:hover{transform:translateY(-6px);box-shadow:10px 12px 0 rgba(40,103,217,.1);border-color:var(--electric,var(--blue))}.journal-card h3{font-size:1.3rem;line-height:1.12;letter-spacing:-.04em;margin:17px 0 10px}.journal-card p{color:var(--muted);font-size:.88rem;line-height:1.7;margin:0}.post-meta{color:var(--coral);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;font-weight:800}.journal-card-bottom{margin-top:auto;display:flex;justify-content:space-between;align-items:center;padding-top:20px}.journal-card-bottom small{color:var(--muted);font-size:.7rem}.journal-card-bottom span{color:var(--electric,var(--blue));font-weight:750;font-size:.82rem}.journal-empty{border-left:3px solid var(--coral);padding-left:20px;color:var(--muted)}@media(max-width:800px){.journal-hero-grid{grid-template-columns:1fr;gap:45px}.journal-mark{justify-self:start;width:280px;height:280px}.journal-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.journal-hero{padding:75px 0 80px}.journal-hero h1{font-size:3.1rem}.journal-grid{grid-template-columns:1fr}.journal-mark b{font-size:2.4rem}}</style>
