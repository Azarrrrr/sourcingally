---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { localeAvailability } from '../../../data/locale-availability';
import { getSanityArticle, listSanityArticles } from '../../../lib/sanityPublic';
const labels = { en:{title:'Sourcing Ally Journal',description:'Practical notes about sourcing and importing from China.',kicker:'The journal',heading:'Field notes, sourcing lessons, and useful context.',intro:'A growing editorial resource for buyers who want to understand what happens between a product idea and a shipment from China.',read:'Read article'}, es:{title:'Diario de Sourcing Ally',description:'Notas prácticas sobre compras e importación desde China.',kicker:'El diario',heading:'Notas de campo y lecciones de compras.',intro:'Una biblioteca editorial para compradores que quieren entender el proceso.',read:'Leer artículo'}, pt:{title:'Diário da Sourcing Ally',description:'Notas práticas sobre compras e importação da China.',kicker:'O diário',heading:'Notas de campo e lições de compras.',intro:'Uma biblioteca editorial para compradores que querem entender o processo.',read:'Ler artigo'}, ru:{title:'Журнал Sourcing Ally',description:'Практические заметки о закупках и импорте из Китая.',kicker:'Журнал',heading:'Полевые заметки и уроки закупок.',intro:'Редакционная библиотека для покупателей, которые хотят понимать процесс.',read:'Читать статью'}, tr:{title:'Sourcing Ally Günlüğü',description:'Çin’den tedarik ve ithalat hakkında pratik notlar.',kicker:'Günlük',heading:'Saha notları ve tedarik dersleri.',intro:'Süreci anlamak isteyen alıcılar için editoryal bir kaynak.',read:'Yazıyı okuyun'} };
export function getStaticPaths(){return ['en','es','pt','ru','tr','fr'].map(lang=>({params:{lang},props:{lang}}))}
const {lang}=Astro.props; const t=labels[lang as keyof typeof labels] ?? labels.en;
const localizedPosts=(await getCollection('blog', ({data})=>!data.draft && data.lang===lang)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const englishFallbackPosts=(await getCollection('blog', ({data})=>!data.draft && data.lang==='en')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const usesFallback = lang !== 'en' && localizedPosts.length === 0;
const availability = lang === 'en' ? undefined : localeAvailability[lang as keyof typeof localeAvailability];
const posts = usesFallback ? [] : localizedPosts;
const featured=posts.find(post=>post.data.featured) ?? posts[0]; const rest=posts.filter(post=>post.id!==featured?.id);
const categories=[...new Set(posts.map(post=>post.data.category))];
let generatedSanitySlugs: string[] = [];
try { generatedSanitySlugs = (await listSanityArticles(lang)).map((article) => article.slug); } catch { /* The existing static journal remains available during build-time network failures. */ }
---
<Layout title={t.title} description={t.description} lang={lang} noindex={usesFallback}>
  {usesFallback && availability && <section class="journal-availability section-pad"><div class="container availability-inner"><p class="eyebrow">{t.kicker}</p><h1>{availability.journalTitle}</h1><p>{availability.journalCopy}</p><a class="button" href={`/${lang}/questions/`}>{availability.journalAction}</a></div></section>}
  <section class:list={['journal-hero',usesFallback && 'locale-source-only']}><div class="container journal-hero-grid"><div><p class="eyebrow">{t.kicker}</p><h1>{t.heading}</h1><p class="hero-intro">{t.intro}</p><div class="journal-stat"><span>SANITY-MANAGED</span><b>New published articles appear here without a website rebuild.</b></div></div><div class="journal-mark"><span>SA / 01</span><b>READ<br/>THE<br/>DETAILS</b><i></i></div></div></section>
  <section id="sanity-journal" class="section-pad" data-lang={lang} hidden><div class="container" id="sanity-journal-content"></div></section>
  <section class:list={['journal-toolbar','section-pad',usesFallback && 'locale-source-only']}><div class="container toolbar-inner"><div><p class="eyebrow">Explore by topic</p><div class="topic-pills">{categories.map(category=><span>{category}</span>)}</div></div><p class="toolbar-note">The Journal is written as a growing knowledge library. Evergreen guides remain useful; dated field notes show what is changing.</p></div></section>
  {featured && <section class:list={['featured-post','section-pad','section-light',usesFallback && 'locale-source-only']}><div class="container featured-post-grid"><div class="featured-art"><span>FEATURED</span><b>{featured.data.category}</b><i>↗</i></div><div><p class="post-meta">{featured.data.pubDate.toLocaleDateString(lang, {year:'numeric',month:'long',day:'numeric'})} · {featured.data.readingTime ?? 'Guide'}</p><h2>{featured.data.title}</h2><p class="featured-description">{featured.data.description}</p><a class="button" href={`/${lang}/blog/${featured.data.translationKey ?? featured.id}/`}>{t.read} ↗</a></div></div></section>}
  <section class:list={['journal-grid-section','section-pad',usesFallback && 'locale-source-only']}><div class="container"><div class="section-heading"><div><p class="eyebrow">Latest thinking</p><h2>Keep a useful question open.</h2></div><p>Each article should leave you with a better brief, a sharper supplier question, or a clearer next decision.</p></div><div class="journal-grid">{rest.length ? rest.map(post=><article class="journal-card"><div class="post-meta"><span>{post.data.category}</span> · {post.data.pubDate.toLocaleDateString(lang, {year:'numeric',month:'short',day:'numeric'})}</div><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="journal-card-bottom"><small>{post.data.readingTime ?? 'Read the guide'}</small><a href={`/${lang}/blog/${post.data.translationKey ?? post.id}/`}>Open ↗</a></div></article>) : <p>More articles are coming soon. Add a Markdown file to the GitHub blog collection to publish the next article.</p>}</div></div></section>
  <section class:list={['journal-how',usesFallback && 'locale-source-only']}><div class="container journal-how-grid"><div><p class="eyebrow">For the future editor</p><h2>Write in GitHub. Publish through Cloudflare.</h2></div><div><p>Add a Markdown file under <code>src/content/blog/</code>, include the frontmatter fields in the project README, and push to the main branch. Cloudflare Pages can rebuild the static site automatically. The English article is canonical; translations should be human-reviewed and linked only when ready.</p><a class="text-link" href={`/${lang}/guides/how-to-import-from-china/`}>Read the sourcing school ↗</a></div></div></section>
  <script define:vars={{lang,t,generatedSanitySlugs}}>
    ;(async()=>{
    const target=document.querySelector('#sanity-journal-content'); const wrap=document.querySelector('#sanity-journal'); const pathParts=location.pathname.split('/').filter(Boolean); const directSlug=pathParts[0]===lang && pathParts[1]==='blog' && pathParts[2] ? decodeURIComponent(pathParts[2]) : null; const articleSlug=(new URLSearchParams(location.search).get('article') ?? directSlug)?.replace(/\/+$/, '');
    const endpoint='https://iksqqwui.api.sanity.io/v2025-02-19/data/query/production'; const run=async(query,params)=>{const url=new URL(endpoint);url.searchParams.set('query',query);Object.entries(params).forEach(([key,value])=>url.searchParams.set(`$${key}`,JSON.stringify(value)));const response=await fetch(url);if(!response.ok)throw new Error();return (await response.json()).result}; const escape=value=>String(value??'').replace(/[&<>'"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char])); const detailHref=slug=>generatedSanitySlugs.includes(slug)?`/${lang}/blog/${encodeURIComponent(slug)}/`:`/${lang}/blog/sanity-article/?article=${encodeURIComponent(slug)}`;
    try{if(articleSlug){const article=await run('*[_type == "article" && siteKey == "sourcing-ally" && locale == $locale && slug == $slug][0]{title,description,bodyMarkdown,publishedAt,wordCount}',{locale:lang,slug:articleSlug});if(article){wrap.hidden=false;document.querySelectorAll('main > section:not(#sanity-journal)').forEach(node=>node.hidden=true);target.innerHTML=`<article class="container" style="max-width:850px"><a class="text-link" href="/${lang}/blog/">← ${escape(t.read)}</a><p class="eyebrow" style="margin-top:30px">SOURCING ALLY JOURNAL</p><h1 style="font-size:clamp(2.7rem,6vw,5.6rem);line-height:.98;letter-spacing:-.07em">${escape(article.title)}</h1><p class="hero-intro">${escape(article.description)}</p><div class="article-body" style="margin-top:44px">${escape(article.bodyMarkdown).split(/\n\s*\n/).map(block=>block.startsWith('## ')?`<h2>${escape(block.slice(3))}</h2>`:`<p>${escape(block).replace(/\n/g,'<br>')}</p>`).join('')}</div></article>`;}}else{const articles=await run('*[_type == "article" && siteKey == "sourcing-ally" && locale == $locale] | order(publishedAt desc){title,slug,description,publishedAt,wordCount}',{locale:lang});if(articles.length){wrap.hidden=false;document.querySelectorAll('.featured-post,.journal-grid-section,.journal-toolbar').forEach(node=>node.hidden=true);target.innerHTML=`<div class="section-heading"><div><p class="eyebrow">SANITY JOURNAL</p><h2>Latest published articles</h2></div><p>${escape(t.intro)}</p></div><div class="journal-grid">${articles.map(article=>`<article class="journal-card"><div class="post-meta">${new Date(article.publishedAt).toLocaleDateString(lang)} · ${Math.max(1,Math.ceil(article.wordCount/220))} min</div><h3>${escape(article.title)}</h3><p>${escape(article.description)}</p><div class="journal-card-bottom"><small>SANITY</small><a href="${detailHref(article.slug)}">${escape(t.read)} ↗</a></div></article>`).join('')}</div>`;}}}catch{ /* Local Markdown collection remains available as the documented fallback. */ }
    })();
  </script>
</Layout>
<style>.journal-hero{padding:95px 0 110px;background:#f4f8ff;position:relative;overflow:hidden}.journal-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.42}.journal-hero-grid{display:grid;grid-template-columns:1fr .55fr;gap:80px;align-items:center;position:relative}.journal-hero h1{font-size:clamp(3rem,6vw,6.1rem);line-height:.97;letter-spacing:-.075em;max-width:850px;margin:0 0 24px}.journal-hero .hero-intro{max-width:700px;color:var(--muted);font-size:1.15rem;line-height:1.75}.journal-stat{display:flex;gap:16px;align-items:center;margin-top:42px;padding-top:18px;border-top:1px solid var(--line);max-width:510px}.journal-stat span{font-size:.66rem;letter-spacing:.13em;color:var(--coral);font-weight:800}.journal-stat b{font-size:.82rem}.journal-mark{justify-self:end;width:330px;height:330px;background:var(--gold);border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;position:relative;box-shadow:16px 16px 0 rgba(40,103,217,.13);transform:rotate(-7deg)}.journal-mark span{position:absolute;top:45px;right:52px;font-size:.67rem;color:var(--coral);font-weight:800}.journal-mark b{font-size:3rem;line-height:.86;letter-spacing:-.08em;align-self:flex-start;margin-left:70px}.journal-mark i{position:absolute;width:72%;height:36%;border:1px solid rgba(13,43,80,.3);border-radius:50%;transform:rotate(-30deg)}.journal-toolbar{background:white;padding:45px 0}.toolbar-inner{display:flex;justify-content:space-between;gap:40px;align-items:end}.topic-pills{display:flex;flex-wrap:wrap;gap:7px}.topic-pills span{border:1px solid var(--line);border-radius:99px;padding:8px 13px;font-size:.74rem;color:var(--blue);font-weight:700}.toolbar-note{color:var(--muted);font-size:.85rem;line-height:1.7;max-width:350px;margin:0}.featured-post{background:#eef4fb}.featured-post-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:85px;align-items:center}.featured-art{aspect-ratio:1.45;background:linear-gradient(145deg,var(--ink),var(--electric,var(--blue)));border-radius:24px;position:relative;overflow:hidden;color:white;display:flex;flex-direction:column;justify-content:space-between;padding:25px;box-shadow:17px 17px 0 rgba(247,201,72,.6)}.featured-art:after{content:"";position:absolute;width:360px;height:360px;border:1px solid rgba(255,255,255,.3);border-radius:50%;right:-100px;bottom:-170px}.featured-art span{font-size:.68rem;letter-spacing:.16em;color:var(--gold);font-weight:800}.featured-art b{font-size:1.4rem;max-width:230px;line-height:1.1;position:relative;z-index:2}.featured-art i{position:absolute;right:23px;top:23px;font-size:2rem}.featured-post h2{font-size:clamp(2.2rem,4vw,4.4rem);line-height:1.02;letter-spacing:-.06em;margin:14px 0}.featured-description{color:var(--muted);font-size:1rem;line-height:1.75;max-width:620px;margin-bottom:26px}.post-meta{color:var(--coral);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;font-weight:800}.journal-grid-section{background:white}.journal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.journal-card{border:1px solid var(--line);border-radius:18px;padding:25px;min-height:270px;display:flex;flex-direction:column;transition:.25s}.journal-card:hover{transform:translateY(-6px);box-shadow:10px 12px 0 rgba(40,103,217,.1);border-color:var(--electric,var(--blue))}.journal-card h3{font-size:1.3rem;line-height:1.12;letter-spacing:-.04em;margin:17px 0 10px}.journal-card p{color:var(--muted);font-size:.88rem;line-height:1.7;margin:0}.journal-card-bottom{margin-top:auto;display:flex;justify-content:space-between;align-items:center;padding-top:20px}.journal-card-bottom small{color:var(--muted);font-size:.7rem}.journal-card-bottom a,.text-link{color:var(--electric,var(--blue));font-weight:750;font-size:.82rem}.journal-how{background:var(--ink);color:white;padding:75px 0}.journal-how-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px}.journal-how h2{font-size:clamp(2.2rem,4vw,4rem);line-height:1.02;letter-spacing:-.06em;margin:0}.journal-how p{color:#cbd8e8;line-height:1.8}.journal-how code{color:var(--gold)}.journal-how .eyebrow{color:var(--gold)}@media(max-width:800px){.journal-hero-grid,.featured-post-grid,.journal-how-grid{grid-template-columns:1fr;gap:45px}.journal-mark{justify-self:start;width:280px;height:280px}.toolbar-inner{align-items:flex-start;flex-direction:column}.journal-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.journal-hero{padding:75px 0 80px}.journal-hero h1{font-size:3.1rem}.journal-grid{grid-template-columns:1fr}.journal-mark b{font-size:2.4rem}}
.journal-availability{background:#f4f8ff}.availability-inner{max-width:780px}.availability-inner h1{font-size:clamp(2.8rem,5.5vw,5.2rem);line-height:1;letter-spacing:-.06em;margin:0 0 22px}.availability-inner>p:not(.eyebrow){font-size:1.1rem;line-height:1.75;color:var(--muted);max-width:680px;margin:0 0 30px}</style>
