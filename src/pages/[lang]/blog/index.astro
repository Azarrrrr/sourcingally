---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const labels = {
  en: { title: 'Sourcing Ally Journal', description: 'Practical notes about sourcing and importing from China.', kicker: 'The journal', heading: 'Useful context for your next China sourcing project.', intro: 'Guides and observations from the ground in China. Each article is stored as a Markdown file in the GitHub repository, so you can add and update posts through Git.', read: 'Read article' },
  es: { title: 'Diario de Sourcing Ally', description: 'Notas prácticas sobre compras e importación desde China.', kicker: 'El diario', heading: 'Contexto útil para tu próximo proyecto de compras en China.', intro: 'Guías y observaciones desde China. Cada artículo se guarda como un archivo Markdown en GitHub para que puedas añadir y actualizar publicaciones mediante Git.', read: 'Leer artículo' },
  pt: { title: 'Diário da Sourcing Ally', description: 'Notas práticas sobre compras e importação da China.', kicker: 'O diário', heading: 'Informações úteis para seu próximo projeto de compras na China.', intro: 'Guias e observações diretamente da China. Cada artigo é armazenado como Markdown no GitHub para que você possa atualizar o blog por meio do Git.', read: 'Ler artigo' },
  ru: { title: 'Журнал Sourcing Ally', description: 'Практические заметки о закупках и импорте из Китая.', kicker: 'Журнал', heading: 'Полезная информация для вашего следующего проекта в Китае.', intro: 'Гиды и наблюдения с места в Китае. Каждая статья хранится в виде Markdown-файла в GitHub, поэтому блог можно обновлять через Git.', read: 'Читать статью' },
  tr: { title: 'Sourcing Ally Günlüğü', description: 'Çin’den tedarik ve ithalat hakkında pratik notlar.', kicker: 'Günlük', heading: 'Bir sonraki Çin tedarik projeniz için faydalı bilgiler.', intro: 'Çin’den rehberler ve gözlemler. Her yazı GitHub deposunda Markdown dosyası olarak tutulur; böylece blogu Git üzerinden güncelleyebilirsiniz.', read: 'Yazıyı okuyun' }
};
export function getStaticPaths(){return ['en','es','pt','ru','tr'].map(lang=>({params:{lang},props:{lang}}))}
const {lang}=Astro.props; const t=labels[lang as keyof typeof labels] ?? labels.en;
const posts=(await getCollection('blog', ({data})=>!data.draft && data.lang===lang)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<Layout title={t.title} description={t.description} lang={lang}>
  <section class="section-pad blog-hero"><div class="container narrow"><p class="eyebrow">{t.kicker}</p><h1>{t.heading}</h1><p class="hero-intro">{t.intro}</p></div></section>
  <section class="section-pad section-light"><div class="container blog-list">{posts.length ? posts.map(post=><article class="post-card"><div class="post-meta">{post.data.pubDate.toLocaleDateString(lang, {year:'numeric',month:'long',day:'numeric'})} · {post.data.author}</div><h2>{post.data.title}</h2><p>{post.data.description}</p><a class="text-link" href={`/${lang}/blog/${post.id}/`}>{t.read} <span>↗</span></a></article>) : <p>No posts published in this language yet.</p>}</div></section>
</Layout>
<style>.narrow{max-width:820px}.blog-hero{padding-bottom:78px}.blog-hero h1{font-size:clamp(2.8rem,5vw,5rem);line-height:1.02;letter-spacing:-.06em;max-width:820px;margin:0 0 25px}.blog-list{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.post-card{background:white;border:1px solid var(--line);border-radius:var(--radius);padding:30px;min-height:260px;display:flex;flex-direction:column}.post-meta{color:var(--red);font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;font-weight:700}.post-card h2{font-size:1.55rem;line-height:1.15;letter-spacing:-.035em;margin:20px 0 10px}.post-card p{color:var(--muted);margin:0 0 25px}.post-card .text-link{margin-top:auto}@media(max-width:650px){.blog-list{grid-template-columns:1fr}}</style>
