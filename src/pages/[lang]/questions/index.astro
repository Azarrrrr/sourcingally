---
import Layout from '../../../layouts/Layout.astro';
import { questionGroups, allQuestions } from '../../../data/questions';
export function getStaticPaths(){return ['en','es','pt','ru','tr'].map(lang=>({params:{lang},props:{lang}}))}
const {lang}=Astro.props;
const questionJson = { '@context':'https://schema.org', '@type':'ItemList', name:'Sourcing Questions | Sourcing Ally', itemListElement:allQuestions.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.question,url:`https://sourcingally.com/en/questions/${item.slug}/`})) };
---
<Layout title="Sourcing Questions | Sourcing Ally" description="Clear answers to common questions about sourcing, suppliers, samples, factory checks, quality, China cities, shipping, and importing." lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(questionJson)}></script>
  <section class="questions-hero"><div class="container questions-hero-grid"><div><p class="eyebrow">Sourcing Questions</p><h1>Clear answers for the decisions that come before an order.</h1><p class="hero-intro">Start with the question you actually need to answer. Each page gives a short direct response, practical context, limitations, and the next relevant guide.</p><div class="question-hero-actions"><a class="button" href="#topics">Explore questions ↓</a><a class="text-link" href="/en/start-project/">Build your project brief ↗</a></div></div><div class="question-panel"><div class="question-panel-top"><span>SA / KNOWLEDGE</span><b>01—15</b></div><div class="question-panel-main"><i>?</i><strong>Ask better questions.<br/>Make clearer decisions.</strong></div><div class="question-panel-bottom"><span>UPDATED AS GUIDES EVOLVE</span><b>↘</b></div></div></div></section>
  <section class="question-intro section-pad"><div class="container intro-grid"><div><p class="eyebrow">How to use this library</p><h2>Useful answers are specific about what they can—and cannot—tell you.</h2></div><div><p>China sourcing questions often depend on the product, quantity, materials, destination market, supplier, commercial terms, and timeline. These answers help you structure the decision and identify the next question. They are general education, not a substitute for a project agreement or professional legal, customs, testing, or tax advice.</p><div class="intro-tags"><span>Direct answer</span><span>Practical context</span><span>Limits & exceptions</span><span>Next guide</span></div></div></div></section>
  <section id="topics" class="question-library section-pad section-light"><div class="container"><div class="section-heading"><div><p class="eyebrow">Browse by buyer journey</p><h2>Fifteen questions. Five connected decisions.</h2></div><p>Do not read everything at once. Start with the part of your sourcing project that is currently uncertain.</p></div><div class="question-groups">{questionGroups.map((group,groupIndex)=><section class="question-group"><div class="group-head"><span>0{groupIndex+1}</span><div><h3>{group.title}</h3><p>{group.intro}</p></div></div><div class="question-list">{group.questions.map((item,index)=><a href={`/en/questions/${item.slug}/`} class="question-row"><span>{String(index+1).padStart(2,'0')}</span><div><b>{item.question}</b><p>{item.shortAnswer}</p></div><i>↗</i></a>)}</div></section>)}</div></div></section>
  <section class="question-method"><div class="container method-grid"><div><p class="eyebrow">A simple research method</p><h2>Write the product brief before you request the quote.</h2><p>The fastest way to improve supplier conversations is to define the product, quantity, destination, timing, materials, packaging, reference images, and the decision you need help with.</p></div><div class="method-steps"><div><span>01</span><b>Define the requirement</b><p>State what must be made, checked, or decided.</p></div><div><span>02</span><b>Compare consistent information</b><p>Give suppliers the same written brief and questions.</p></div><div><span>03</span><b>Record the next decision</b><p>Keep approvals, changes, and open questions visible.</p></div><a class="button button-light" href="/en/start-project/">Create your project brief ↗</a></div></div></section>
  <section class="section-pad question-close"><div class="container close-grid"><div><p class="eyebrow">Need a more specific answer?</p><h2>Tell us what you are sourcing and what you need to decide.</h2></div><p>Email the product name, quantity, destination, timing, and your main question. Sourcing Ally can discuss whether the requested local support is suitable for the project.</p><a class="button" href="mailto:sourcingally@gmail.com">Email Sourcing Ally ↗</a></div></section>
</Layout>
<style>.questions-hero{padding:96px 0 110px;background:#f4f8ff;position:relative;overflow:hidden}.questions-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.questions-hero-grid{display:grid;grid-template-columns:1fr .63fr;gap:80px;align-items:center;position:relative}.questions-hero h1{font-size:clamp(3.1rem,6.4vw,6.25rem);line-height:.96;letter-spacing:-.075em;max-width:880px;margin:0 0 27px}.questions-hero .hero-intro{font-size:1.14rem;line-height:1.75;max-width:680px;color:var(--muted)}.question-hero-actions{display:flex;gap:23px;align-items:center;margin-top:32px}.question-panel{max-width:410px;min-height:390px;background:var(--ink);color:white;justify-self:end;padding:25px;position:relative;display:flex;flex-direction:column;box-shadow:18px 18px 0 rgba(247,201,72,.65);overflow:hidden}.question-panel:before{content:"";position:absolute;width:330px;height:330px;border:1px solid rgba(255,255,255,.23);border-radius:50%;right:-90px;top:75px}.question-panel:after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px);background-size:32px 32px;opacity:.5}.question-panel>*{position:relative;z-index:2}.question-panel-top,.question-panel-bottom{display:flex;justify-content:space-between;gap:15px;color:var(--gold);font-size:.65rem;letter-spacing:.14em;font-weight:800}.question-panel-main{margin:auto 0}.question-panel-main i{display:block;color:var(--gold);font-style:normal;font-size:7.5rem;line-height:.65;font-weight:700}.question-panel-main strong{display:block;font-size:2.25rem;line-height:.98;letter-spacing:-.06em;max-width:280px;margin-top:25px}.question-panel-bottom b{font-size:1.3rem}.question-intro{background:white}.intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:95px}.intro-grid h2{font-size:clamp(2.25rem,4vw,4rem);letter-spacing:-.06em;line-height:1.03;margin:0}.intro-grid p:not(.eyebrow){color:#405069;line-height:1.85;font-size:1.02rem;margin:0}.intro-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}.intro-tags span{border:1px solid var(--line);border-radius:99px;padding:8px 12px;color:var(--blue);font-size:.7rem;font-weight:750}.question-library{background:#eef4fb}.question-groups{display:grid;grid-template-columns:1fr 1fr;gap:18px}.question-group{background:white;border:1px solid var(--line);border-radius:18px;padding:25px}.group-head{display:grid;grid-template-columns:50px 1fr;gap:16px;padding-bottom:19px;border-bottom:1px solid var(--line)}.group-head>span{color:var(--coral);font-size:.74rem;font-weight:800;padding-top:4px}.group-head h3{margin:0 0 7px;font-size:1.35rem;letter-spacing:-.04em}.group-head p{margin:0;color:var(--muted);font-size:.86rem;line-height:1.6}.question-list{margin-top:7px}.question-row{display:grid;grid-template-columns:30px 1fr 25px;gap:10px;padding:16px 0;border-bottom:1px solid var(--line);transition:.2s}.question-row:last-child{border-bottom:0}.question-row:hover{padding-left:7px}.question-row>span{font-size:.66rem;color:var(--coral);font-weight:800;padding-top:4px}.question-row b{font-size:.96rem;line-height:1.35}.question-row p{margin:6px 0 0;color:var(--muted);line-height:1.55;font-size:.8rem}.question-row i{font-size:1rem;color:var(--blue)}.question-method{background:var(--ink);padding:84px 0;color:white}.method-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px}.method-grid h2{font-size:clamp(2.3rem,4vw,4.4rem);line-height:1.02;letter-spacing:-.06em;margin:0 0 18px}.method-grid>div>p:not(.eyebrow){line-height:1.75;color:#cbd8e8;max-width:530px}.method-grid .eyebrow{color:var(--gold)}.method-steps>div{display:grid;grid-template-columns:55px 1fr;gap:15px;border-top:1px solid rgba(255,255,255,.18);padding:15px 0}.method-steps span{color:var(--gold);font-size:.72rem;font-weight:800}.method-steps b{font-size:1rem}.method-steps p{grid-column:2;margin:-7px 0 0;color:#cbd8e8;font-size:.85rem}.method-steps .button{margin-top:30px}.question-close{background:white}.close-grid{display:grid;grid-template-columns:1.1fr .8fr auto;gap:55px;align-items:end}.close-grid h2{font-size:clamp(2.2rem,4vw,4rem);line-height:1.03;letter-spacing:-.06em;margin:0}.close-grid>p{color:var(--muted);line-height:1.75;margin:0}@media(max-width:880px){.questions-hero-grid,.intro-grid,.method-grid{grid-template-columns:1fr;gap:45px}.question-panel{justify-self:start}.question-groups{grid-template-columns:1fr}.close-grid{grid-template-columns:1fr;gap:24px;align-items:start}}@media(max-width:560px){.questions-hero{padding:75px 0 80px}.questions-hero h1{font-size:3.05rem}.question-hero-actions{align-items:flex-start;flex-direction:column}.question-panel{width:100%;max-width:320px;min-height:330px}.question-panel-main strong{font-size:1.8rem}.question-groups{gap:12px}.question-group{padding:19px}.intro-grid{gap:30px}}
</style>
