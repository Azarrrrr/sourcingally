---
import Layout from '../../../layouts/Layout.astro';
import { allQuestions, questionGroups } from '../../../data/questions';
import { questionLocales } from '../../../data/questions-locales';
import generatedQuestionTemplateTranslations from '../../../data/generatedQuestionTemplateTranslations.json';
export function getStaticPaths(){return ['en','es','pt','ru','tr','fr','ja','de','ar','id','it'].flatMap(lang=>allQuestions.map(question=>({params:{lang,slug:question.slug},props:{lang,slug:question.slug}})))}
const {slug,lang}=Astro.props;
const isSource=lang==='en';
const sourceQuestion=allQuestions.find(item=>item.slug===slug);
if (!sourceQuestion) throw new Error(`Unknown sourcing question: ${slug}`);
const sourceGroup=questionGroups.find(group=>group.questions.some(item=>item.slug===slug));
const localizedGroups=lang==='en' ? questionGroups : (questionLocales[lang as keyof typeof questionLocales]?.groups ?? questionGroups);
const localizedGroup=localizedGroups.find(group=>group.questions.some(item=>item.slug===slug));
const localQuestion=localizedGroup?.questions.find(item=>item.slug===slug);
const question={...sourceQuestion,...localQuestion,related:sourceQuestion.related.map((related,index)=>({...related,label:localQuestion?.relatedLabels?.[index] ?? related.label}))};
const siblings=(sourceGroup?.questions.filter(item=>item.slug!==slug).slice(0,2) ?? []).map(sourceSibling=>{const localSibling=localizedGroup?.questions.find(item=>item.slug===sourceSibling.slug); return {...sourceSibling,...localSibling,related:sourceSibling.related.map((related,index)=>({...related,label:localSibling?.relatedLabels?.[index] ?? related.label}))};});
const copy={
 en:{title:'Sourcing Questions',back:'← Sourcing Questions',direct:'Short answer',index:'Read the context. Check the limits. Take the next practical step.',onPage:'On this page',context:'Context',limits:'What changes the answer',next:'Next steps',related:'Related questions',reviewed:'Last reviewed: 13 August 2026',contextTitle:'What this means in a real sourcing project.',limitsTitle:'Do not treat a general answer as a project decision.',limitsCopy:'The right approach can change with the product, quantity, materials, supplier, destination market, commercial terms, timing, and information already available. Use the answer to form a better brief, then confirm the details that apply to the actual order.',nextLabel:'A useful next step',nextTitle:'Move from a question to a written decision.',steps:[['Write the facts you already know.','Product, quantity, destination, timing, and the decision you need to make.'],['Record the detail that is uncertain.','For example, supplier capability, sample quality, packaging, travel plan, or inspection scope.'],['Open the related guide before you contact anyone.','It will help you ask a more specific question and compare answers consistently.']],note:'Important note',disclaimer:'This page is general education. It is not legal, customs, tax, testing, safety, engineering, or other professional advice for a real shipment or product. Review the',disclaimerLink:'Sourcing Ally Disclaimer',continue:'Continue learning',relatedTitle:'Related questions and guides.',relatedCopy:'Use the next page to make the current answer more useful for your product and project.',guide:'Related guide',question:'Related question'},
 es:{title:'Preguntas sobre abastecimiento',back:'← Preguntas sobre abastecimiento',direct:'Respuesta breve',index:'Lea el contexto. Compruebe los límites. Dé el siguiente paso práctico.',onPage:'En esta página',context:'Contexto',limits:'Qué cambia la respuesta',next:'Siguientes pasos',related:'Preguntas relacionadas',reviewed:'Última revisión: 13 de agosto de 2026',contextTitle:'Qué significa esto en un proyecto de compras real.',limitsTitle:'No trate una respuesta general como una decisión de proyecto.',limitsCopy:'El enfoque correcto puede cambiar según el producto, la cantidad, los materiales, el proveedor, el mercado de destino, las condiciones comerciales, el calendario y la información disponible. Use la respuesta para preparar un mejor briefing y después confirme los datos que correspondan al pedido real.',nextLabel:'Un siguiente paso útil',nextTitle:'Pase de una pregunta a una decisión por escrito.',steps:[['Escriba los hechos que ya conoce.','Producto, cantidad, destino, calendario y la decisión que necesita tomar.'],['Anote el detalle que sigue siendo incierto.','Por ejemplo, la capacidad del proveedor, la calidad de la muestra, el embalaje, el plan de viaje o el alcance de la inspección.'],['Abra la guía relacionada antes de contactar a alguien.','Le ayudará a formular una pregunta más específica y a comparar respuestas de manera consistente.']],notice:'La respuesta detallada de esta página permanece en inglés mientras se revisa una traducción profesional al español. La estructura de navegación y los siguientes pasos ya están localizados.',note:'Nota importante',disclaimer:'Esta página es material educativo general. No es asesoramiento legal, aduanero, fiscal, de pruebas, seguridad, ingeniería ni otro asesoramiento profesional para un envío o producto real. Revise el',disclaimerLink:'Aviso legal de Sourcing Ally',continue:'Seguir aprendiendo',relatedTitle:'Preguntas y guías relacionadas.',relatedCopy:'Use la siguiente página para que la respuesta actual resulte más útil para su producto y proyecto.',guide:'Guía relacionada',question:'Pregunta relacionada'},
 pt:{title:'Perguntas sobre sourcing',back:'← Perguntas sobre sourcing',direct:'Resposta curta',index:'Leia o contexto. Verifique os limites. Dê o próximo passo prático.',onPage:'Nesta página',context:'Contexto',limits:'O que muda a resposta',next:'Próximos passos',related:'Perguntas relacionadas',reviewed:'Última revisão: 13 de agosto de 2026',contextTitle:'O que isso significa em um projeto de sourcing real.',limitsTitle:'Não trate uma resposta geral como uma decisão de projeto.',limitsCopy:'A abordagem correta pode mudar conforme o produto, quantidade, materiais, fornecedor, mercado de destino, termos comerciais, prazo e informações disponíveis. Use a resposta para criar um briefing melhor e depois confirme os detalhes aplicáveis ao pedido real.',nextLabel:'Um próximo passo útil',nextTitle:'Transforme uma pergunta em uma decisão escrita.',steps:[['Escreva os fatos que você já conhece.','Produto, quantidade, destino, prazo e a decisão que precisa tomar.'],['Registre o detalhe que ainda é incerto.','Por exemplo, capacidade do fornecedor, qualidade da amostra, embalagem, plano de viagem ou escopo da inspeção.'],['Abra o guia relacionado antes de contatar alguém.','Ele ajudará você a fazer uma pergunta mais específica e comparar respostas de modo consistente.']],notice:'A resposta detalhada desta página permanece em inglês enquanto uma tradução profissional para o português é revisada. A navegação e os próximos passos já estão localizados.',note:'Nota importante',disclaimer:'Esta página é educação geral. Não é aconselhamento jurídico, aduaneiro, fiscal, de testes, segurança, engenharia ou outro aconselhamento profissional para um envio ou produto real. Leia o',disclaimerLink:'Aviso legal da Sourcing Ally',continue:'Continue aprendendo',relatedTitle:'Perguntas e guias relacionados.',relatedCopy:'Use a próxima página para tornar a resposta atual mais útil para seu produto e projeto.',guide:'Guia relacionado',question:'Pergunta relacionada'},
 ru:{title:'Вопросы о закупках',back:'← Вопросы о закупках',direct:'Краткий ответ',index:'Прочитайте контекст. Проверьте ограничения. Сделайте следующий практический шаг.',onPage:'На этой странице',context:'Контекст',limits:'Что меняет ответ',next:'Следующие шаги',related:'Связанные вопросы',reviewed:'Последняя проверка: 13 августа 2026',contextTitle:'Что это означает в реальном проекте по закупкам.',limitsTitle:'Не воспринимайте общий ответ как решение по проекту.',limitsCopy:'Правильный подход может меняться в зависимости от товара, количества, материалов, поставщика, рынка назначения, коммерческих условий, сроков и уже доступной информации. Используйте ответ для подготовки лучшего брифа, а затем подтвердите детали для реального заказа.',nextLabel:'Полезный следующий шаг',nextTitle:'Перейдите от вопроса к письменному решению.',steps:[['Запишите факты, которые уже известны.','Товар, количество, рынок назначения, сроки и решение, которое вам необходимо принять.'],['Зафиксируйте неопределённую деталь.','Например, возможности поставщика, качество образца, упаковку, план поездки или объём инспекции.'],['Откройте связанное руководство до обращения к кому-либо.','Оно поможет задать более конкретный вопрос и последовательно сравнить ответы.']],notice:'Подробный ответ на этой странице пока остаётся на английском языке, пока проходит проверку профессиональный перевод на русский. Навигация и следующие шаги уже локализованы.',note:'Важная информация',disclaimer:'Эта страница носит общий образовательный характер. Она не является юридической, таможенной, налоговой, испытательной, инженерной или иной профессиональной консультацией для реальной поставки или товара. Ознакомьтесь с',disclaimerLink:'отказом от ответственности Sourcing Ally',continue:'Продолжить изучение',relatedTitle:'Связанные вопросы и руководства.',relatedCopy:'Используйте следующую страницу, чтобы текущий ответ стал полезнее для вашего товара и проекта.',guide:'Связанное руководство',question:'Связанный вопрос'},
 tr:{title:'Tedarik soruları',back:'← Tedarik soruları',direct:'Kısa yanıt',index:'Bağlamı okuyun. Sınırları kontrol edin. Bir sonraki pratik adımı atın.',onPage:'Bu sayfada',context:'Bağlam',limits:'Yanıtı ne değiştirir',next:'Sonraki adımlar',related:'İlgili sorular',reviewed:'Son inceleme: 13 Ağustos 2026',contextTitle:'Bunun gerçek bir tedarik projesinde anlamı nedir?',limitsTitle:'Genel bir yanıtı proje kararı olarak değerlendirmeyin.',limitsCopy:'Doğru yaklaşım; ürüne, miktara, malzemelere, tedarikçiye, hedef pazara, ticari koşullara, zamanlamaya ve mevcut bilgilere göre değişebilir. Yanıtı daha iyi bir proje özeti oluşturmak için kullanın, ardından gerçek sipariş için geçerli ayrıntıları doğrulayın.',nextLabel:'Yararlı bir sonraki adım',nextTitle:'Bir soruyu yazılı bir karara dönüştürün.',steps:[['Halihazırda bildiğiniz gerçekleri yazın.','Ürün, miktar, hedef, zamanlama ve vermeniz gereken karar.'],['Belirsiz kalan ayrıntıyı kaydedin.','Örneğin tedarikçi kapasitesi, numune kalitesi, ambalaj, seyahat planı veya denetim kapsamı.'],['Birisiyle iletişime geçmeden önce ilgili rehberi açın.','Daha belirli bir soru sormanıza ve yanıtları tutarlı biçimde karşılaştırmanıza yardımcı olur.']],notice:'Bu sayfadaki ayrıntılı yanıt, profesyonel Türkçe çeviri incelenirken İngilizce olarak kalır. Gezinme ve sonraki adımlar zaten Türkçeleştirilmiştir.',note:'Önemli not',disclaimer:'Bu sayfa genel eğitim amaçlıdır. Gerçek bir sevkiyat veya ürün için hukuki, gümrük, vergi, test, güvenlik, mühendislik veya başka bir profesyonel tavsiye değildir. Harekete geçmeden önce',disclaimerLink:'Sourcing Ally sorumluluk reddini',continue:'Öğrenmeye devam edin',relatedTitle:'İlgili sorular ve rehberler.',relatedCopy:'Mevcut yanıtı ürününüz ve projeniz için daha yararlı hâle getirmek üzere sonraki sayfayı kullanın.',guide:'İlgili rehber',question:'İlgili soru'}
} as const;
const fr={title:'Questions de sourcing',back:'← Questions de sourcing',direct:'Réponse courte',index:'Lisez le contexte. Vérifiez les limites. Passez à l’étape pratique suivante.',onPage:'Sur cette page',context:'Contexte',limits:'Ce qui peut modifier la réponse',next:'Étapes suivantes',related:'Questions liées',reviewed:'Dernière révision : 13 août 2026',contextTitle:'Ce que cela signifie dans un projet de sourcing réel.',limitsTitle:'Ne considérez pas une réponse générale comme une décision de projet.',limitsCopy:'La bonne approche peut varier selon le produit, la quantité, les matériaux, le fournisseur, le marché de destination, les conditions commerciales, le calendrier et les informations déjà disponibles. Utilisez la réponse pour préparer un meilleur brief, puis confirmez les détails applicables à la commande réelle.',nextLabel:'Une étape suivante utile',nextTitle:'Passez d’une question à une décision écrite.',steps:[['Notez les faits déjà connus.','Le produit, la quantité, la destination, le calendrier et la décision à prendre.'],['Consignez le détail encore incertain.','Par exemple, la capacité du fournisseur, la qualité de l’échantillon, l’emballage, le plan de déplacement ou le périmètre de l’inspection.'],['Ouvrez le guide associé avant de contacter qui que ce soit.','Il vous aidera à poser une question plus précise et à comparer les réponses de manière cohérente.']],note:'Information importante',disclaimer:'Cette page fournit des informations générales. Elle ne constitue pas un avis juridique, douanier, fiscal, de test, de sécurité, d’ingénierie ni un autre avis professionnel pour une expédition ou un produit réels. Consultez la',disclaimerLink:'clause de non-responsabilité de Sourcing Ally',continue:'Continuer à apprendre',relatedTitle:'Questions et guides associés.',relatedCopy:'Utilisez la page suivante pour rendre la réponse actuelle plus utile à votre produit et à votre projet.',guide:'Guide associé',question:'Question associée'};
const generatedQuestionTemplate = generatedQuestionTemplateTranslations as Partial<Record<string, Record<string, string>>>;
const localizeTemplateValue = (value: unknown, dictionary?: Record<string, string>): any => {
  if (!dictionary) return value;
  if (typeof value === 'string') return dictionary[value] ?? value;
  if (Array.isArray(value)) return value.map((entry) => localizeTemplateValue(entry, dictionary));
  if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value as Record<string, unknown>).map(([key, entry]) => [key, localizeTemplateValue(entry, dictionary)]));
  return value;
};
const content = lang === 'fr' ? fr : (copy[lang as keyof typeof copy] || localizeTemplateValue(copy.en, generatedQuestionTemplate[lang]) || copy.en);
const answerBadge = lang === 'ja' ? 'SA / 回答' : lang === 'de' ? 'SA / ANTWORT' : lang === 'ar' ? 'SA / إجابة' : lang === 'id' ? 'SA / JAWABAN' : lang === 'it' ? 'SA / RISPOSTA' : lang === 'ru' ? 'SA / ОТВЕТ' : lang === 'es' ? 'SA / RESPUESTA' : lang === 'pt' ? 'SA / RESPOSTA' : lang === 'tr' ? 'SA / YANIT' : lang === 'fr' ? 'SA / RÉPONSE' : 'SA / ANSWER';
const faqJson = { '@context':'https://schema.org', '@type':'FAQPage', mainEntity:[{'@type':'Question',name:question.question,acceptedAnswer:{'@type':'Answer',text:question.shortAnswer}}] };
const breadcrumbJson = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Sourcing Ally',item:`https://sourcingally.com/${lang}/`},{'@type':'ListItem',position:2,name:content.title,item:`https://sourcingally.com/${lang}/questions/`},{'@type':'ListItem',position:3,name:question.question,item:`https://sourcingally.com/${lang}/questions/${question.slug}/`} ]};
const localHref=(href:string)=>href.replace(/^\/en/,`/${lang}`);
---
<Layout title={`${question.question} | Sourcing Ally`} description={question.shortAnswer} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify([faqJson,breadcrumbJson])}></script>
  <article class="answer-page"><header class="answer-hero"><div class="container answer-hero-grid"><div><a class="back-link" href={`/${lang}/questions/`}>{content.back}</a><p class="eyebrow">{question.category}</p><h1>{question.question}</h1><p class="answer-direct"><span>{content.direct}</span>{question.shortAnswer}</p></div><aside class="answer-index"><span>{answerBadge}</span><b>{question.category}</b><i>?</i><small>{content.index}</small></aside></div></header><div class="container answer-layout"><aside class="answer-aside"><p class="eyebrow">{content.onPage}</p><a href="#context">{content.context}</a><a href="#limits">{content.limits}</a><a href="#next">{content.next}</a><a href="#related">{content.related}</a><p class="aside-note">{content.reviewed}</p></aside><div class="answer-body"><section id="context"><p class="eyebrow">{content.context}</p><h2>{content.contextTitle}</h2><p>{question.answer}</p></section><section id="limits" class="answer-limits"><p class="eyebrow">{content.limits}</p><h2>{content.limitsTitle}</h2><p>{content.limitsCopy}</p></section><section id="next"><p class="eyebrow">{content.nextLabel}</p><h2>{content.nextTitle}</h2><ol class="answer-steps">{content.steps.map(step=><li><b>{step[0]}</b><span>{step[1]}</span></li>)}</ol></section><section class="answer-disclaimer"><strong>{content.note}</strong><p>{content.disclaimer} <a href={`/${lang}/disclaimer/`}>{content.disclaimerLink}</a>.</p></section></div></div></article><section id="related" class="related-answers section-pad section-light"><div class="container"><div class="section-heading"><div><p class="eyebrow">{content.continue}</p><h2>{content.relatedTitle}</h2></div><p>{content.relatedCopy}</p></div><div class="answer-links">{question.related.map(item=><a href={localHref(item.href)}><span>{content.guide}</span><b>{item.label}</b><i>↗</i></a>)}{siblings.map(item=><a href={`/${lang}/questions/${item.slug}/`}><span>{content.question}</span><b>{item.question}</b><i>↗</i></a>)}</div></div></section>
</Layout>
<style>.answer-hero{background:#f4f8ff;padding:82px 0 90px;position:relative;overflow:hidden}.answer-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.answer-hero-grid{display:grid;grid-template-columns:1fr .48fr;gap:75px;align-items:end;position:relative}.back-link{display:inline-block;color:var(--blue);font-size:.84rem;font-weight:750;margin-bottom:43px}.answer-hero h1{font-size:clamp(2.9rem,6vw,5.9rem);line-height:.98;letter-spacing:-.04em;max-width:880px;margin:0 0 28px}.answer-direct{border-left:4px solid var(--gold);padding:13px 0 13px 18px;max-width:720px;color:#405069;font-size:1.13rem;line-height:1.7;margin:0}.answer-direct span{display:block;color:var(--coral);font-size:.67rem;text-transform:uppercase;letter-spacing:.13em;font-weight:800;margin-bottom:7px}.translation-notice{max-width:720px;margin:18px 0 0;padding:12px 15px;border-left:4px solid var(--coral);background:#fff8db;color:#405069;font-size:.86rem;line-height:1.65}.answer-index{background:var(--ink);color:white;padding:23px;min-height:270px;display:flex;flex-direction:column;position:relative;overflow:hidden;box-shadow:14px 14px 0 rgba(247,201,72,.6)}.answer-index:before{content:"";position:absolute;width:280px;height:280px;border:1px solid rgba(255,255,255,.2);border-radius:50%;right:-130px;top:45px}.answer-index>*{position:relative;z-index:2}.answer-index span{font-size:.65rem;color:var(--gold);letter-spacing:.13em;font-weight:800}.answer-index b{font-size:1rem;margin-top:18px}.answer-index i{font-style:normal;font-size:6.5rem;line-height:.8;color:var(--gold);margin:20px 0}.answer-index small{line-height:1.6;color:#cbd8e8}.answer-layout{display:grid;grid-template-columns:.35fr 1fr;gap:90px;padding-top:78px;padding-bottom:78px}.answer-aside{position:sticky;top:105px;align-self:start;border:1px solid var(--line);background:white;border-radius:14px;padding:20px;display:flex;flex-direction:column;gap:12px}.answer-aside a{font-size:.84rem;color:var(--blue);font-weight:700}.aside-note{border-top:1px solid var(--line);padding-top:14px;color:var(--muted);font-size:.73rem;line-height:1.5}.answer-body{max-width:800px}.answer-body section{margin-bottom:52px}.answer-body h2{font-size:clamp(1.9rem,3.4vw,3rem);letter-spacing:-.03em;line-height:1.05;margin:0 0 15px}.answer-body p{color:#405069;line-height:1.9;font-size:1.04rem;margin:0}.answer-limits{background:#eef4fb;border-radius:18px;padding:27px}.answer-steps{list-style:none;padding:0;margin:0;counter-reset:step}.answer-steps li{counter-increment:step;display:grid;grid-template-columns:45px 1fr;gap:10px;border-top:1px solid var(--line);padding:17px 0}.answer-steps li:before{content:counter(step,decimal-leading-zero);color:var(--coral);font-size:.72rem;font-weight:800;padding-top:4px}.answer-steps li b{display:block;margin-bottom:5px}.answer-steps li span{grid-column:2;color:var(--muted);font-size:.9rem;line-height:1.65}.answer-disclaimer{background:#fff8db;border-left:4px solid var(--gold);padding:19px 22px}.answer-disclaimer p{font-size:.87rem;margin-top:6px}.answer-disclaimer a{color:var(--blue);font-weight:700}.related-answers{background:#eef4fb}.answer-links{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.answer-links a{border:1px solid var(--line);background:white;border-radius:16px;padding:20px;min-height:180px;display:flex;flex-direction:column;transition:.2s}.answer-links a:hover{transform:translateY(-5px);box-shadow:8px 9px 0 rgba(40,103,217,.1);border-color:var(--blue)}.answer-links span{font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:var(--coral);font-weight:800}.answer-links b{margin-top:16px;font-size:1rem;line-height:1.25}.answer-links i{margin-top:auto;color:var(--blue);font-style:normal}@media(max-width:850px){.answer-hero-grid,.answer-layout{grid-template-columns:1fr;gap:38px}.answer-index{max-width:340px}.answer-aside{position:static}.answer-links{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.answer-hero{padding:65px 0 70px}.answer-hero h1{font-size:3rem}.answer-layout{padding-top:55px;padding-bottom:55px}.answer-links{grid-template-columns:1fr}.answer-index{min-height:220px}.answer-index i{font-size:5.5rem}}</style>
