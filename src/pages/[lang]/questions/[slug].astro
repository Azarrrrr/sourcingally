---
import Layout from '../../../layouts/Layout.astro';
import { allQuestions } from '../../../data/questions';
export function getStaticPaths(){return allQuestions.map(question=>({params:{lang:'en',slug:question.slug},props:{question}}))}
const {question}=Astro.props;
const siblings=allQuestions.filter(item=>item.category===question.category && item.slug!==question.slug).slice(0,2);
const faqJson = { '@context':'https://schema.org', '@type':'FAQPage', mainEntity:[{'@type':'Question',name:question.question,acceptedAnswer:{'@type':'Answer',text:question.shortAnswer}}] };
const breadcrumbJson = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Sourcing Ally',item:'https://sourcingally.com/en/'},{'@type':'ListItem',position:2,name:'Sourcing Questions',item:'https://sourcingally.com/en/questions/'},{'@type':'ListItem',position:3,name:question.question,item:`https://sourcingally.com/en/questions/${question.slug}/`} ]};
---
<Layout title={`${question.question} | Sourcing Ally`} description={question.shortAnswer} lang="en">
  <script type="application/ld+json" set:html={JSON.stringify([faqJson,breadcrumbJson])}></script>
  <article class="answer-page"><header class="answer-hero"><div class="container answer-hero-grid"><div><a class="back-link" href="/en/questions/">← Sourcing Questions</a><p class="eyebrow">{question.category}</p><h1>{question.question}</h1><p class="answer-direct"><span>Short answer</span>{question.shortAnswer}</p></div><aside class="answer-index"><span>SA / ANSWER</span><b>{question.category}</b><i>?</i><small>Read the context. Check the limits. Take the next practical step.</small></aside></div></header><div class="container answer-layout"><aside class="answer-aside"><p class="eyebrow">On this page</p><a href="#context">Context</a><a href="#limits">What changes the answer</a><a href="#next">Next steps</a><a href="#related">Related questions</a><p class="aside-note">Last reviewed: 13 August 2026</p></aside><div class="answer-body"><section id="context"><p class="eyebrow">Context</p><h2>What this means in a real sourcing project.</h2><p>{question.answer}</p></section><section id="limits" class="answer-limits"><p class="eyebrow">What changes the answer</p><h2>Do not treat a general answer as a project decision.</h2><p>The right approach can change with the product, quantity, materials, supplier, destination market, commercial terms, timing, and information already available. Use the answer to form a better brief, then confirm the details that apply to the actual order.</p></section><section id="next"><p class="eyebrow">A useful next step</p><h2>Move from a question to a written decision.</h2><ol class="answer-steps"><li><b>Write the facts you already know.</b><span>Product, quantity, destination, timing, and the decision you need to make.</span></li><li><b>Record the detail that is uncertain.</b><span>For example, supplier capability, sample quality, packaging, travel plan, or inspection scope.</span></li><li><b>Open the related guide before you contact anyone.</b><span>It will help you ask a more specific question and compare answers consistently.</span></li></ol></section><section class="answer-disclaimer"><strong>Important note</strong><p>This page is general education. It is not legal, customs, tax, testing, safety, engineering, or other professional advice for a real shipment or product. Review the <a href="/en/disclaimer/">Sourcing Ally Disclaimer</a> before acting on compliance or shipping information.</p></section></div></div></article><section id="related" class="related-answers section-pad section-light"><div class="container"><div class="section-heading"><div><p class="eyebrow">Continue learning</p><h2>Related questions and guides.</h2></div><p>Use the next page to make the current answer more useful for your product and project.</p></div><div class="answer-links">{question.related.map(item=><a href={item.href}><span>Related guide</span><b>{item.label}</b><i>↗</i></a>)}{siblings.map(item=><a href={`/en/questions/${item.slug}/`}><span>Related question</span><b>{item.question}</b><i>↗</i></a>)}</div></div></section>
</Layout>
<style>.answer-hero{background:#f4f8ff;padding:82px 0 90px;position:relative;overflow:hidden}.answer-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.answer-hero-grid{display:grid;grid-template-columns:1fr .48fr;gap:75px;align-items:end;position:relative}.back-link{display:inline-block;color:var(--blue);font-size:.84rem;font-weight:750;margin-bottom:43px}.answer-hero h1{font-size:clamp(2.9rem,6vw,5.9rem);line-height:.98;letter-spacing:-.075em;max-width:880px;margin:0 0 28px}.answer-direct{border-left:4px solid var(--gold);padding:13px 0 13px 18px;max-width:720px;color:#405069;font-size:1.13rem;line-height:1.7;margin:0}.answer-direct span{display:block;color:var(--coral);font-size:.67rem;text-transform:uppercase;letter-spacing:.13em;font-weight:800;margin-bottom:7px}.answer-index{background:var(--ink);color:white;padding:23px;min-height:270px;display:flex;flex-direction:column;position:relative;overflow:hidden;box-shadow:14px 14px 0 rgba(247,201,72,.6)}.answer-index:before{content:"";position:absolute;width:280px;height:280px;border:1px solid rgba(255,255,255,.2);border-radius:50%;right:-130px;top:45px}.answer-index>*{position:relative;z-index:2}.answer-index span{font-size:.65rem;color:var(--gold);letter-spacing:.13em;font-weight:800}.answer-index b{font-size:1rem;margin-top:18px}.answer-index i{font-style:normal;font-size:6.5rem;line-height:.8;color:var(--gold);margin:20px 0}.answer-index small{line-height:1.6;color:#cbd8e8}.answer-layout{display:grid;grid-template-columns:.35fr 1fr;gap:90px;padding-top:78px;padding-bottom:78px}.answer-aside{position:sticky;top:105px;align-self:start;border:1px solid var(--line);background:white;border-radius:14px;padding:20px;display:flex;flex-direction:column;gap:12px}.answer-aside a{font-size:.84rem;color:var(--blue);font-weight:700}.aside-note{border-top:1px solid var(--line);padding-top:14px;color:var(--muted);font-size:.73rem;line-height:1.5}.answer-body{max-width:800px}.answer-body section{margin-bottom:52px}.answer-body h2{font-size:clamp(1.9rem,3.4vw,3rem);letter-spacing:-.055em;line-height:1.05;margin:0 0 15px}.answer-body p{color:#405069;line-height:1.9;font-size:1.04rem;margin:0}.answer-limits{background:#eef4fb;border-radius:18px;padding:27px}.answer-steps{list-style:none;padding:0;margin:0;counter-reset:step}.answer-steps li{counter-increment:step;display:grid;grid-template-columns:45px 1fr;gap:10px;border-top:1px solid var(--line);padding:17px 0}.answer-steps li:before{content:counter(step,decimal-leading-zero);color:var(--coral);font-size:.72rem;font-weight:800;padding-top:4px}.answer-steps li b{display:block;margin-bottom:5px}.answer-steps li span{grid-column:2;color:var(--muted);font-size:.9rem;line-height:1.65}.answer-disclaimer{background:#fff8db;border-left:4px solid var(--gold);padding:19px 22px}.answer-disclaimer p{font-size:.87rem;margin-top:6px}.answer-disclaimer a{color:var(--blue);font-weight:700}.related-answers{background:#eef4fb}.answer-links{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.answer-links a{border:1px solid var(--line);background:white;border-radius:16px;padding:20px;min-height:180px;display:flex;flex-direction:column;transition:.2s}.answer-links a:hover{transform:translateY(-5px);box-shadow:8px 9px 0 rgba(40,103,217,.1);border-color:var(--blue)}.answer-links span{font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:var(--coral);font-weight:800}.answer-links b{margin-top:16px;font-size:1rem;line-height:1.25}.answer-links i{margin-top:auto;color:var(--blue);font-style:normal}@media(max-width:850px){.answer-hero-grid,.answer-layout{grid-template-columns:1fr;gap:38px}.answer-index{max-width:340px}.answer-aside{position:static}.answer-links{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.answer-hero{padding:65px 0 70px}.answer-hero h1{font-size:3rem}.answer-layout{padding-top:55px;padding-bottom:55px}.answer-links{grid-template-columns:1fr}.answer-index{min-height:220px}.answer-index i{font-size:5.5rem}}
</style>
