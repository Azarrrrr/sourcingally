const sectionUi={en:{process:'How it works',lead:'Good sourcing is more than finding a low price. It is about asking the right questions, seeing what is happening on the ground, and keeping communication moving.',contact:'Start a conversation'},es:{process:'Cómo funciona',lead:'Un buen sourcing no consiste solo en encontrar un precio bajo. Consiste en hacer las preguntas correctas, ver lo que ocurre sobre el terreno y mantener la comunicación en movimiento.',contact:'Inicie una conversación'},pt:{process:'Como funciona',lead:'Um bom sourcing é mais do que encontrar um preço baixo. Trata-se de fazer as perguntas certas, ver o que acontece no local e manter a comunicação em andamento.',contact:'Comece uma conversa'},ru:{process:'Как это работает',lead:'Хорошие закупки — это не только поиск низкой цены. Это правильные вопросы, понимание происходящего на месте и непрерывная коммуникация.',contact:'Начните разговор'},tr:{process:'Nasıl çalışır',lead:'İyi tedarik yalnızca düşük fiyat bulmak değildir. Doğru soruları sormak, sahada neler olduğunu görmek ve iletişimi sürdürmektir.',contact:'Bir görüşme başlatın'}};
export function getStaticPaths() { return ['en', 'es', 'pt', 'ru', 'tr'].map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations] ?? translations.en;
const c = commandTranslations[lang as keyof typeof commandTranslations] ?? commandTranslations.en;
const a = atlasTranslations[lang as keyof typeof atlasTranslations] ?? atlasTranslations.en;
const s = sectionUi[lang as keyof typeof sectionUi] ?? sectionUi.en;
---
<Layout title={t.title} description={t.description} lang={lang}>
  <section class="command-hero">
    <div class="command-grid-bg" aria-hidden="true"></div>
    <div class="container command-hero-wrap">
      <div class="command-kicker"><span>{c.mark}</span><span>{c.world}</span></div>
      <div class="command-title-row"><div><p class="eyebrow">{t.eyebrow}</p><h1>{c.headline}</h1></div><div class="command-founder"><img src="/images/azar-pamir-cutout-transparent.png" alt="Azar Pamir, founder of Sourcing Ally" /><p><b>Azar Pamir</b><span>{c.founder}</span></p></div></div>
      <div class="command-intro-row"><p>{t.intro}</p><div class="command-actions"><a class="button" href={`/${lang}/start-project/`}>{c.brief} <span>↗</span></a><a class="text-link" href={`/${lang}/questions/`}>{c.questions} <span>↗</span></a></div></div>
      <div class="command-console" id="command-console"><div class="console-head"><span>{c.choose}</span><b>01—03</b></div><div class="console-paths"><a href={`/${lang}/paths/first-import/`}><span>01</span><div><small>{c.firstLabel}</small><b>{c.first}</b><p>{c.firstText}</p></div><i>↗</i></a><a href={`/${lang}/paths/brand-private-label/`}><span>02</span><div><small>{c.buildLabel}</small><b>{c.build}</b><p>{c.buildText}</p></div><i>↗</i></a><a href={`/${lang}/paths/existing-supplier-rescue/`}><span>03</span><div><small>{c.activeLabel}</small><b>{c.active}</b><p>{c.activeText}</p></div><i>↗</i></a></div><div class="console-footer"><span><i></i> {c.based}</span><a href={`/${lang}/service-matcher/`}>{c.matcher} ↗</a></div></div>
      <div class="command-scroll"><span>{c.scroll}</span><i></i></div>
    </div>
  </section>
  <section class="atlas-scroll" aria-label="The Sourcing Ally sourcing journey"><div class="container atlas-scroll-grid"><div class="atlas-copy"><p class="eyebrow">{a.eyebrow}</p><h2>{a.title}</h2><p>{a.intro}</p><a class="text-link" href={`/${lang}/paths/`}>{a.link} <span>↗</span></a></div><div class="atlas-journey"><div class="journey-line"><span></span></div>{a.stages.map((stage,index)=><article data-atlas-step><b>{String(index+1).padStart(2,'0')}</b><div><small>{stage[0]}</small><h3>{stage[1]}</h3><p>{stage[2]}</p></div></article>)}</div></div></section>
  <section id="services" class="section-pad section-light"><div class="container"><div class="section-heading"><p class="eyebrow">{a.what}</p><h2>{t.servicesTitle}</h2><p>{t.servicesIntro}</p></div><div class="service-grid">{t.services.map(([number, title, text]) => <article class="service-card"><span class="service-number">{number}</span><h3>{title}</h3><p>{text}</p><a href={`/${lang}/services/`} aria-label={`${title} services`}>{a.exploreServices} <span>↗</span></a></article>)}</div><div class="home-hubs"><a href={`/${lang}/products/`}><span>{a.products}</span><b>{a.productsSub} ↗</b></a><a href={`/${lang}/cities/`}><span>{a.cities}</span><b>{a.citiesSub} ↗</b></a><a href={`/${lang}/guides/`}><span>{a.school}</span><b>{a.schoolSub} ↗</b></a></div></div></section>
  <section id="process" class="section-pad process-section"><div class="container process-grid"><div><p class="eyebrow">{s.process}</p><h2>{t.processTitle}</h2><p class="process-lead">{s.lead}</p></div><div class="steps">{t.process.map(([number, title, text]) => <div class="step"><span class="step-number">{number}</span><div><h3>{title}</h3><p>{text}</p></div></div>)}</div></div></section>
  <section id="about" class="section-pad about-section"><div class="container about-grid"><div class="about-image"><img src="/images/azar-pamir-cutout-transparent.png" alt="Azar Pamir, founder of Sourcing Ally" /></div><div class="about-copy"><p class="eyebrow">{t.aboutEyebrow}</p><h2>{t.aboutTitle}</h2><p>{t.aboutText}</p><p>{t.aboutText2}</p><div class="location-tags"><span>Shenzhen</span><span>Guangzhou</span><span>Foshan</span><span>Dongguan</span><span>Zhongshan</span><span>Huizhou</span></div></div></div></section>
  <section id="contact" class="contact-section"><div class="container contact-inner"><div><p class="eyebrow">{s.contact}</p><h2>{t.contactTitle}</h2><p>{t.contactText}</p><p class="limitation">{t.limitation}</p></div><a class="button button-light" href="mailto:sourcingally@gmail.com">{t.contactButton} <span>↗</span></a></div></section>
  <script>
    const atlasSteps = [...document.querySelectorAll('[data-atlas-step]')];
    const atlasLine = document.querySelector('.journey-line span');
    if (atlasSteps.length && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const index = atlasSteps.indexOf(entry.target);
          atlasSteps.forEach((step, i) => step.classList.toggle('is-visible', i <= index));
          if (atlasLine) atlasLine.style.height = `${Math.max(0, index) * 20}%`;
        });
      }, { threshold: .6 });
      atlasSteps.forEach(step => observer.observe(step));
    }
  </script>
  <style>.command-hero{position:relative;overflow:hidden;background:linear-gradient(135deg,#f8fbff 0%,#edf4ff 56%,#fff9e9 100%);padding:26px 0 34px;min-height:0;display:flex;align-items:center}.command-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to bottom,black 0%,rgba(0,0,0,.55) 75%,transparent 100%)}.command-hero-wrap{position:relative;width:min(1040px,calc(100% - 96px));margin-inline:auto}.command-kicker{display:flex;justify-content:space-between;border-bottom:1px solid rgba(40,103,217,.18);padding-bottom:14px;color:var(--blue);font-size:.65rem;letter-spacing:.14em;font-weight:800}.command-title-row{display:grid;grid-template-columns:170px minmax(0,1fr) 170px;gap:20px;align-items:end;padding:38px 0 18px}.command-title-row>div:first-child{grid-column:2;text-align:center}.command-founder{grid-column:3}.command-title-row h1{font-size:clamp(3rem,6.1vw,6rem);line-height:.93;letter-spacing:-.055em;max-width:730px;margin:0 auto}.command-founder{display:flex;align-items:flex-end;gap:8px;border-left:1px solid rgba(40,103,217,.2);padding-left:14px;min-height:104px}.command-founder img{width:75px;height:108px;object-fit:contain;object-position:bottom;filter:drop-shadow(0 14px 13px rgba(13,43,80,.15))}.command-founder p{margin:0 0 13px;display:flex;flex-direction:column;gap:4px}.command-founder b{font-size:.86rem}.command-founder span{font-size:.7rem;color:var(--muted);line-height:1.4}.command-intro-row{display:grid;grid-template-columns:minmax(0,620px) auto;gap:32px;align-items:end;max-width:840px;margin-inline:auto;padding-bottom:28px}.command-intro-row>p{color:#405069;font-size:1rem;line-height:1.65;max-width:630px;margin:0}.command-actions{display:flex;gap:22px;align-items:center}.command-console{background:var(--ink);color:white;box-shadow:20px 20px 0 rgba(247,201,72,.7);position:relative;overflow:hidden;padding-inline:18px}.command-console:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.075) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.075) 1px,transparent 1px);background-size:34px 34px;opacity:.7}.command-console>*{position:relative;z-index:2}.console-head,.console-footer{display:flex;justify-content:space-between;gap:18px;padding:12px 0;font-size:.65rem;font-weight:800;letter-spacing:.12em}.console-head{color:var(--gold);border-bottom:1px solid rgba(255,255,255,.18)}.console-footer{border-top:1px solid rgba(255,255,255,.18);color:#cbd8e8;align-items:center;letter-spacing:0;font-weight:600}.console-footer span{display:flex;align-items:center;gap:8px;font-size:.75rem}.console-footer span i{display:block;width:7px;height:7px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 5px rgba(247,201,72,.18)}.console-footer a{color:var(--gold);font-size:.75rem;font-weight:800}.console-paths{display:grid;grid-template-columns:repeat(3,1fr)}.console-paths a{min-height:148px;padding:17px;border-right:1px solid rgba(255,255,255,.18);transition:background .25s ease,transform .25s ease;display:grid;grid-template-columns:32px 1fr 18px;gap:12px;align-items:start}.console-paths a:last-child{border:0}.console-paths a:hover{background:rgba(255,255,255,.08);transform:translateY(-5px)}.console-paths>a>span{color:var(--gold);font-size:.7rem;font-weight:800}.console-paths small{display:block;color:var(--coral);font-size:.59rem;font-weight:800;letter-spacing:.11em;margin-bottom:7px}.console-paths b{display:block;font-size:.98rem;line-height:1.13}.console-paths p{color:#cbd8e8;font-size:.74rem;line-height:1.5;margin:7px 0 0}.console-paths i{color:var(--gold);font-size:.9rem;font-style:normal}.command-scroll{display:flex;align-items:center;gap:10px;margin-top:22px;color:var(--blue);font-size:.62rem;font-weight:800;letter-spacing:.13em}.command-scroll i{height:27px;width:1px;background:var(--blue);position:relative;overflow:hidden}.command-scroll i:after{content:"";position:absolute;top:-40%;left:0;width:100%;height:50%;background:var(--gold);animation:commandScroll 2s infinite ease-in-out}@keyframes commandScroll{to{top:110%}}@media(max-width:900px){.command-hero{min-height:auto;padding:25px 0 45px}.command-hero-wrap{width:min(820px,calc(100% - 64px))}.command-title-row{grid-template-columns:1fr 165px;gap:25px}.command-title-row>div:first-child{grid-column:auto;text-align:left}.command-founder{grid-column:auto}.command-title-row h1{font-size:clamp(2.8rem,6.8vw,4.8rem);margin:0}.command-intro-row{grid-template-columns:1fr;gap:25px}.command-actions{justify-content:flex-start}.console-paths a{min-height:165px;padding:16px}.console-footer{flex-direction:column;align-items:flex-start}}@media(max-width:630px){.command-hero-wrap{width:min(540px,calc(100% - 32px))}.command-kicker{font-size:.54rem}.command-kicker span:last-child{display:none}.command-title-row{grid-template-columns:1fr;padding:30px 0 15px}.command-founder{display:none}.command-title-row h1{font-size:3.05rem}.command-intro-row>p{font-size:1rem}.command-actions{flex-direction:column;align-items:flex-start}.console-paths{grid-template-columns:1fr}.console-paths a{min-height:0;border-right:0;border-bottom:1px solid rgba(255,255,255,.18)}.console-paths a:last-child{border-bottom:0}.command-console{box-shadow:10px 11px 0 rgba(247,201,72,.7)}.console-footer a{line-height:1.5}.command-scroll{margin-top:25px}}.atlas-scroll{background:var(--ink);color:white;padding:115px 0;position:relative;overflow:hidden}.atlas-scroll:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:46px 46px;opacity:.6}.atlas-scroll-grid{display:grid;grid-template-columns:.85fr 1fr;gap:120px;position:relative;align-items:start}.atlas-copy{position:sticky;top:130px}.atlas-copy .eyebrow{color:var(--gold)}.atlas-copy h2{font-size:clamp(2.7rem,5.2vw,5.5rem);letter-spacing:-.075em;line-height:.96;margin:0 0 21px}.atlas-copy p:not(.eyebrow){color:#cbd8e8;line-height:1.85;max-width:500px;margin:0 0 26px}.atlas-copy .text-link{color:var(--gold)}.atlas-journey{position:relative;padding-left:80px}.journey-line{position:absolute;width:2px;left:20px;top:0;bottom:0;background:rgba(255,255,255,.2)}.journey-line span{position:absolute;left:0;top:0;width:100%;height:0;background:var(--gold);transition:height .6s cubic-bezier(.2,.8,.2,1)}.atlas-journey article{min-height:185px;display:grid;grid-template-columns:70px 1fr;gap:18px;align-items:start;opacity:.38;transform:translateY(23px);transition:opacity .45s ease,transform .45s ease;padding:0 0 42px;position:relative}.atlas-journey article:before{content:"";position:absolute;width:17px;height:17px;left:-68px;top:5px;border-radius:50%;background:var(--ink);border:2px solid rgba(255,255,255,.45);transition:.35s}.atlas-journey article.is-visible{opacity:1;transform:none}.atlas-journey article.is-visible:before{background:var(--gold);border-color:var(--gold);box-shadow:0 0 0 9px rgba(247,201,72,.13)}.atlas-journey article>b{font-size:2.4rem;color:var(--gold);letter-spacing:-.07em;line-height:.8}.atlas-journey small{display:block;color:var(--coral);font-size:.67rem;letter-spacing:.14em;font-weight:800;margin-bottom:8px}.atlas-journey h3{font-size:1.75rem;letter-spacing:-.04em;margin:0 0 7px}.atlas-journey p{color:#cbd8e8;line-height:1.65;margin:0;max-width:500px}@media(max-width:800px){.atlas-scroll{padding:75px 0}.atlas-scroll-grid{grid-template-columns:1fr;gap:50px}.atlas-copy{position:static}.atlas-journey{padding-left:58px}.journey-line{left:15px}.atlas-journey article:before{left:-51px}.atlas-copy h2{font-size:3rem}.atlas-journey article{min-height:135px}.atlas-journey article>b{font-size:1.9rem}}</style>
</Layout>
