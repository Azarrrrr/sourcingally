---
import Layout from '../../layouts/Layout.astro';

const translations = {
  en: {
    title: 'Sourcing Ally | Your sourcing partner in China',
    description: 'Sourcing Ally helps international buyers find suppliers, verify products, coordinate packaging, and communicate with factories in China.',
    eyebrow: 'China sourcing, made clearer',
    headline: 'Your trusted eyes and ears in China.',
    intro: 'Sourcing Ally helps international buyers find the right suppliers, check quality, and move projects forward with a partner on the ground in Shenzhen.',
    primary: 'Tell us what you need', secondary: 'Explore our process',
    servicesTitle: 'From first supplier search to final check.',
    servicesIntro: 'Practical, on-the-ground support for international buyers importing from China.',
    services: [
      ['01', 'Supplier sourcing', 'We research and contact potential suppliers based on your product requirements, budget, and timeline.'],
      ['02', 'Sample & factory checks', 'We arrange samples, visit factories when needed, and help you understand what you are buying before production.'],
      ['03', 'Quality control', 'We check products at the sample, production, and final stages according to the requirements you confirm with us.'],
      ['04', 'Packaging & translation', 'We coordinate packaging details and help bridge communication between you and your Chinese suppliers.'],
    ],
    processTitle: 'A simple process. Clear communication.',
    process: [['01', 'Share your requirements', 'Tell us about the product, quantity, specifications, target market, and timing.'], ['02', 'Review options', 'We look for suitable suppliers and share the relevant information so you can make an informed decision.'], ['03', 'Move forward with confidence', 'We support samples, factory communication, checks, packaging, and other agreed tasks.']],
    aboutEyebrow: 'On the ground in Shenzhen',
    aboutTitle: 'A local partner for international business.',
    aboutText: 'I’m Azar Pamir, founder of Sourcing Ally. From Shenzhen, I help clients communicate with suppliers, visit factories, check products, and manage the details that are difficult to handle from abroad.',
    aboutText2: 'Our home base makes it easy to work across Shenzhen, Guangzhou, Foshan, Dongguan, Zhongshan, and Huizhou. For projects farther away, we can also travel within China when the work requires it.',
    contactTitle: 'Have a product in mind?', contactText: 'Send us your requirements and we will discuss how we can help. Our sourcing service fee starts at 5%, with the final fee depending on the scope of work.', contactButton: 'Contact Sourcing Ally', limitation: 'We do not handle dangerous goods or military-related products.'
  },
  es: { title: 'Sourcing Ally | Tu socio de compras en China', description: 'Sourcing Ally ayuda a compradores internacionales a encontrar proveedores, verificar productos y coordinar proyectos en China.', eyebrow: 'Compras en China, con claridad', headline: 'Tus ojos y oídos de confianza en China.', intro: 'Sourcing Ally ayuda a compradores internacionales a encontrar proveedores, comprobar la calidad y avanzar con un socio local en Shenzhen.', primary: 'Cuéntanos lo que necesitas', secondary: 'Conoce nuestro proceso', servicesTitle: 'Desde la búsqueda del proveedor hasta la revisión final.', servicesIntro: 'Apoyo práctico y local para compradores internacionales que importan desde China.', services: [['01','Búsqueda de proveedores','Investigamos y contactamos proveedores según tus requisitos, presupuesto y calendario.'],['02','Muestras y fábricas','Coordinamos muestras, visitamos fábricas cuando es necesario y te ayudamos a entender el producto antes de producir.'],['03','Control de calidad','Comprobamos los productos en las etapas acordadas según tus requisitos.'],['04','Embalaje y traducción','Coordinamos los detalles del embalaje y facilitamos la comunicación con tus proveedores chinos.']], processTitle: 'Un proceso sencillo. Comunicación clara.', process: [['01','Comparte tus requisitos','Cuéntanos el producto, la cantidad, las especificaciones, el mercado y los plazos.'],['02','Revisa las opciones','Buscamos proveedores adecuados y compartimos la información relevante.'],['03','Avanza con confianza','Apoyamos las muestras, las visitas, las comprobaciones, el embalaje y otras tareas acordadas.']], aboutEyebrow: 'En Shenzhen', aboutTitle: 'Un socio local para negocios internacionales.', aboutText: 'Soy Azar Pamir, fundador de Sourcing Ally. Desde Shenzhen ayudo a mis clientes a comunicarse con proveedores, visitar fábricas, revisar productos y gestionar los detalles difíciles de controlar desde el extranjero.', aboutText2: 'Nuestra ubicación facilita el trabajo en Shenzhen, Guangzhou, Foshan, Dongguan, Zhongshan y Huizhou. Para proyectos más lejanos, también podemos viajar dentro de China cuando sea necesario.', contactTitle: '¿Tienes un producto en mente?', contactText: 'Envíanos tus requisitos y hablaremos de cómo podemos ayudarte. Nuestra comisión de sourcing parte del 5% y el importe final depende del alcance del trabajo.', contactButton: 'Contactar con Sourcing Ally', limitation: 'No gestionamos mercancías peligrosas ni productos relacionados con el ámbito militar.' },
  pt: { title: 'Sourcing Ally | Seu parceiro de compras na China', description: 'A Sourcing Ally ajuda compradores internacionais a encontrar fornecedores, verificar produtos e coordenar projetos na China.', eyebrow: 'Compras na China, com clareza', headline: 'Seus olhos e ouvidos de confiança na China.', intro: 'A Sourcing Ally ajuda compradores internacionais a encontrar fornecedores, verificar a qualidade e avançar com um parceiro local em Shenzhen.', primary: 'Conte-nos o que você precisa', secondary: 'Conheça nosso processo', servicesTitle: 'Da busca do fornecedor à verificação final.', servicesIntro: 'Suporte prático e local para compradores internacionais que importam da China.', services: [['01','Busca de fornecedores','Pesquisamos e contatamos fornecedores de acordo com seus requisitos, orçamento e prazo.'],['02','Amostras e fábricas','Organizamos amostras, visitamos fábricas quando necessário e ajudamos você a entender o produto antes da produção.'],['03','Controle de qualidade','Verificamos os produtos nas etapas combinadas, de acordo com os requisitos confirmados.'],['04','Embalagem e tradução','Coordenamos os detalhes da embalagem e facilitamos a comunicação com seus fornecedores chineses.']], processTitle: 'Um processo simples. Comunicação clara.', process: [['01','Compartilhe seus requisitos','Conte-nos sobre o produto, quantidade, especificações, mercado e prazo.'],['02','Avalie as opções','Procuramos fornecedores adequados e compartilhamos as informações relevantes.'],['03','Avance com confiança','Apoiamos amostras, visitas, verificações, embalagem e outras tarefas combinadas.']], aboutEyebrow: 'Em Shenzhen', aboutTitle: 'Um parceiro local para negócios internacionais.', aboutText: 'Sou Azar Pamir, fundador da Sourcing Ally. Em Shenzhen, ajudo clientes a se comunicar com fornecedores, visitar fábricas, verificar produtos e cuidar dos detalhes difíceis de administrar do exterior.', aboutText2: 'Nossa base facilita o trabalho em Shenzhen, Guangzhou, Foshan, Dongguan, Zhongshan e Huizhou. Para projetos mais distantes, também podemos viajar pela China quando necessário.', contactTitle: 'Você já tem um produto em mente?', contactText: 'Envie seus requisitos e conversaremos sobre como podemos ajudar. Nossa taxa de sourcing começa em 5%, e o valor final depende do escopo do trabalho.', contactButton: 'Falar com a Sourcing Ally', limitation: 'Não trabalhamos com mercadorias perigosas ou produtos relacionados ao setor militar.' },
  ru: { title: 'Sourcing Ally | Ваш партнёр по закупкам в Китае', description: 'Sourcing Ally помогает международным покупателям находить поставщиков, проверять товары и координировать проекты в Китае.', eyebrow: 'Закупки в Китае — понятно и надёжно', headline: 'Ваши доверенные глаза и уши в Китае.', intro: 'Sourcing Ally помогает международным покупателям находить поставщиков, проверять качество и вести проекты с партнёром на месте в Шэньчжэне.', primary: 'Расскажите о задаче', secondary: 'Узнать о процессе', servicesTitle: 'От поиска поставщика до финальной проверки.', servicesIntro: 'Практическая поддержка на месте для международных покупателей, импортирующих из Китая.', services: [['01','Поиск поставщиков','Мы ищем и связываемся с поставщиками с учётом ваших требований, бюджета и сроков.'],['02','Образцы и фабрики','Организуем образцы, при необходимости посещаем фабрики и помогаем понять, что вы покупаете.'],['03','Контроль качества','Проверяем товары на согласованных этапах в соответствии с вашими требованиями.'],['04','Упаковка и перевод','Координируем детали упаковки и помогаем наладить общение с китайскими поставщиками.']], processTitle: 'Простой процесс. Понятное общение.', process: [['01','Расскажите о требованиях','Опишите товар, количество, характеристики, рынок и сроки.'],['02','Изучите варианты','Мы подберём подходящих поставщиков и предоставим важную информацию.'],['03','Двигайтесь уверенно','Поддержим работу с образцами, фабриками, проверками, упаковкой и другими согласованными задачами.']], aboutEyebrow: 'На месте в Шэньчжэне', aboutTitle: 'Местный партнёр для международного бизнеса.', aboutText: 'Меня зовут Азар Памир, я основатель Sourcing Ally. В Шэньчжэне я помогаю клиентам общаться с поставщиками, посещать фабрики, проверять товары и контролировать детали, которыми сложно заниматься из-за границы.', aboutText2: 'Наше расположение удобно для работы в Шэньчжэне, Гуанчжоу, Фошане, Дунгуане, Чжуншане и Хуэйчжоу. Для более удалённых проектов мы также можем путешествовать по Китаю.', contactTitle: 'У вас уже есть идея продукта?', contactText: 'Отправьте нам требования, и мы обсудим, чем можем помочь. Наша комиссия за sourcing начинается от 5%, а итоговая сумма зависит от объёма работы.', contactButton: 'Связаться с Sourcing Ally', limitation: 'Мы не работаем с опасными товарами и продукцией военного назначения.' },
  tr: { title: 'Sourcing Ally | Çin’deki tedarik ortağınız', description: 'Sourcing Ally, uluslararası alıcıların Çin’de tedarikçi bulmasına, ürünleri kontrol etmesine ve projeleri yönetmesine yardımcı olur.', eyebrow: 'Çin’den tedarik, daha anlaşılır', headline: 'Çin’deki güvenilir gözünüz ve kulağınız.', intro: 'Sourcing Ally, uluslararası alıcıların doğru tedarikçileri bulmasına, kaliteyi kontrol etmesine ve Shenzhen’deki yerel bir ortakla ilerlemesine yardımcı olur.', primary: 'İhtiyacınızı anlatın', secondary: 'Süreci inceleyin', servicesTitle: 'İlk tedarikçi aramasından son kontrole kadar.', servicesIntro: 'Çin’den ithalat yapan uluslararası alıcılar için sahada pratik destek.', services: [['01','Tedarikçi bulma','Ürün gereksinimlerinize, bütçenize ve takviminize göre tedarikçileri araştırır ve iletişime geçeriz.'],['02','Numune ve fabrika kontrolleri','Numuneleri düzenler, gerektiğinde fabrikaları ziyaret eder ve üretimden önce ürünü anlamanıza yardımcı oluruz.'],['03','Kalite kontrolü','Ürünleri, sizinle onayladığımız gereksinimlere göre belirlenen aşamalarda kontrol ederiz.'],['04','Ambalaj ve çeviri','Ambalaj ayrıntılarını koordine eder ve Çinli tedarikçilerinizle iletişimi kolaylaştırırız.']], processTitle: 'Basit süreç. Açık iletişim.', process: [['01','Gereksinimlerinizi paylaşın','Ürünü, miktarı, özellikleri, hedef pazarı ve zaman planını anlatın.'],['02','Seçenekleri değerlendirin','Uygun tedarikçileri arar ve karar vermeniz için önemli bilgileri paylaşırız.'],['03','Güvenle ilerleyin','Numune, fabrika, kontrol, ambalaj ve üzerinde anlaşılan diğer görevlerde destek oluruz.']], aboutEyebrow: 'Shenzhen’de sahada', aboutTitle: 'Uluslararası işletmeler için yerel ortak.', aboutText: 'Ben Azar Pamir, Sourcing Ally’nin kurucusuyum. Shenzhen’den müşterilerimin tedarikçilerle iletişim kurmasına, fabrikaları ziyaret etmesine, ürünleri kontrol etmesine ve yurt dışından yönetilmesi zor ayrıntıları takip etmesine yardımcı oluyorum.', aboutText2: 'Merkezimiz Shenzhen, Guangzhou, Foshan, Dongguan, Zhongshan ve Huizhou bölgelerinde çalışmayı kolaylaştırır. Daha uzak projeler için gerektiğinde Çin içinde seyahat edebiliriz.', contactTitle: 'Aklınızda bir ürün var mı?', contactText: 'Gereksinimlerinizi gönderin ve nasıl yardımcı olabileceğimizi konuşalım. Sourcing hizmet ücretimiz %5’ten başlar; nihai ücret iş kapsamına göre belirlenir.', contactButton: 'Sourcing Ally ile iletişime geçin', limitation: 'Tehlikeli ürünler veya askeri amaçlı ürünlerle çalışmıyoruz.' }
};

export function getStaticPaths() { return ['en', 'es', 'pt', 'ru', 'tr'].map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations] ?? translations.en;
---
<Layout title={t.title} description={t.description} lang={lang}>
  <section class="hero section-pad">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.headline}</h1>
        <p class="hero-intro">{t.intro}</p>
        <div class="hero-actions"><a class="button" href={`/${lang}/#contact`}>{t.primary} <span>↗</span></a><a class="text-link" href={`/${lang}/#process`}>{t.secondary} <span>↓</span></a></div>
        <div class="hero-note"><span class="note-dot"></span><span>Based in Shenzhen · Serving clients internationally</span></div>
      </div>
      <div class="hero-card"><div class="sun-shape"></div><img src="/images/azar-pamir-cutout-transparent.png" alt="Azar Pamir, founder of Sourcing Ally" /><div class="hero-card-label"><b>Sourcing Ally</b><span>On the ground in China</span></div></div>
    </div>
  </section>
  <section class="atlas-scroll" aria-label="The Sourcing Ally sourcing journey"><div class="container atlas-scroll-grid"><div class="atlas-copy"><p class="eyebrow">The Sourcing Atlas</p><h2>One project. Six decisions that need to stay connected.</h2><p>Scroll through the route. Each stage has a different question, a different kind of evidence, and a different next action.</p><a class="text-link" href={`/${lang}/paths/`}>Choose your sourcing path <span>↗</span></a></div><div class="atlas-journey"><div class="journey-line"><span></span></div><article data-atlas-step><b>01</b><div><small>SOURCE</small><h3>Define the product</h3><p>Turn an idea into a brief that suppliers can actually answer.</p></div></article><article data-atlas-step><b>02</b><div><small>COMPARE</small><h3>Check the assumptions</h3><p>Compare supplier responses against the same requirement.</p></div></article><article data-atlas-step><b>03</b><div><small>TEST</small><h3>Use the sample</h3><p>Test what matters before a full batch is made.</p></div></article><article data-atlas-step><b>04</b><div><small>CONTROL</small><h3>Plan the checks</h3><p>Make the quality and packaging questions visible early.</p></div></article><article data-atlas-step><b>05</b><div><small>MOVE</small><h3>Prepare the handover</h3><p>Connect product, packaging, documents, and shipment questions.</p></div></article><article data-atlas-step><b>06</b><div><small>LEARN</small><h3>Keep the record</h3><p>Use the evidence to make the next order clearer.</p></div></article></div></div></section>
  <section id="services" class="section-pad section-light"><div class="container"><div class="section-heading"><p class="eyebrow">What we do</p><h2>{t.servicesTitle}</h2><p>{t.servicesIntro}</p></div><div class="service-grid">{t.services.map(([number, title, text]) => <article class="service-card"><span class="service-number">{number}</span><h3>{title}</h3><p>{text}</p><a href={`/${lang}/services/`} aria-label={`${title} services`}>Explore services <span>↗</span></a></article>)}</div><div class="home-hubs"><a href={`/${lang}/products/`}><span>Product guides</span><b>Research your product category ↗</b></a><a href={`/${lang}/cities/`}><span>China cities</span><b>Learn where products are made ↗</b></a><a href={`/${lang}/guides/`}><span>Sourcing school</span><b>Learn how importing works ↗</b></a></div></div></section>
  <section id="process" class="section-pad process-section"><div class="container process-grid"><div><p class="eyebrow">How it works</p><h2>{t.processTitle}</h2><p class="process-lead">Good sourcing is more than finding a low price. It is about asking the right questions, seeing what is happening on the ground, and keeping communication moving.</p></div><div class="steps">{t.process.map(([number, title, text]) => <div class="step"><span class="step-number">{number}</span><div><h3>{title}</h3><p>{text}</p></div></div>)}</div></div></section>
  <section id="about" class="section-pad about-section"><div class="container about-grid"><div class="about-image"><img src="/images/azar-pamir-cutout-transparent.png" alt="Azar Pamir, founder of Sourcing Ally" /></div><div class="about-copy"><p class="eyebrow">{t.aboutEyebrow}</p><h2>{t.aboutTitle}</h2><p>{t.aboutText}</p><p>{t.aboutText2}</p><div class="location-tags"><span>Shenzhen</span><span>Guangzhou</span><span>Foshan</span><span>Dongguan</span><span>Zhongshan</span><span>Huizhou</span></div></div></div></section>
  <section id="contact" class="contact-section"><div class="container contact-inner"><div><p class="eyebrow">Start a conversation</p><h2>{t.contactTitle}</h2><p>{t.contactText}</p><p class="limitation">{t.limitation}</p></div><a class="button button-light" href="mailto:sourcingally@gmail.com">{t.contactButton} <span>↗</span></a></div></section>
  <script>
    const atlasSteps = [...document.querySelectorAll('[data-atlas-step]')];
    const atlasLine = document.querySelector('.journey-line span');
    if (atlasSteps.length && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const index = atlasSteps.indexOf(entry.target);
          atlasSteps.forEach((step, i) => step.classList.toggle('is-visible', i <= index));
          if (atlasLine) atlasLine.style.height = `${Math.max(0, index) * 20}%`;
        });
      }, { threshold: .6 });
      atlasSteps.forEach(step => observer.observe(step));
    }
  </script>
  <style>.atlas-scroll{background:var(--ink);color:white;padding:115px 0;position:relative;overflow:hidden}.atlas-scroll:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:46px 46px;opacity:.6}.atlas-scroll-grid{display:grid;grid-template-columns:.85fr 1fr;gap:120px;position:relative;align-items:start}.atlas-copy{position:sticky;top:130px}.atlas-copy .eyebrow{color:var(--gold)}.atlas-copy h2{font-size:clamp(2.7rem,5.2vw,5.5rem);letter-spacing:-.075em;line-height:.96;margin:0 0 21px}.atlas-copy p:not(.eyebrow){color:#cbd8e8;line-height:1.85;max-width:500px;margin:0 0 26px}.atlas-copy .text-link{color:var(--gold)}.atlas-journey{position:relative;padding-left:80px}.journey-line{position:absolute;width:2px;left:20px;top:0;bottom:0;background:rgba(255,255,255,.2)}.journey-line span{position:absolute;left:0;top:0;width:100%;height:0;background:var(--gold);transition:height .6s cubic-bezier(.2,.8,.2,1)}.atlas-journey article{min-height:185px;display:grid;grid-template-columns:70px 1fr;gap:18px;align-items:start;opacity:.38;transform:translateY(23px);transition:opacity .45s ease,transform .45s ease;padding:0 0 42px;position:relative}.atlas-journey article:before{content:"";position:absolute;width:17px;height:17px;left:-68px;top:5px;border-radius:50%;background:var(--ink);border:2px solid rgba(255,255,255,.45);transition:.35s}.atlas-journey article.is-visible{opacity:1;transform:none}.atlas-journey article.is-visible:before{background:var(--gold);border-color:var(--gold);box-shadow:0 0 0 9px rgba(247,201,72,.13)}.atlas-journey article>b{font-size:2.4rem;color:var(--gold);letter-spacing:-.07em;line-height:.8}.atlas-journey small{display:block;color:var(--coral);font-size:.67rem;letter-spacing:.14em;font-weight:800;margin-bottom:8px}.atlas-journey h3{font-size:1.75rem;letter-spacing:-.04em;margin:0 0 7px}.atlas-journey p{color:#cbd8e8;line-height:1.65;margin:0;max-width:500px}@media(max-width:800px){.atlas-scroll{padding:75px 0}.atlas-scroll-grid{grid-template-columns:1fr;gap:50px}.atlas-copy{position:static}.atlas-journey{padding-left:58px}.journey-line{left:15px}.atlas-journey article:before{left:-51px}.atlas-copy h2{font-size:3rem}.atlas-journey article{min-height:135px}.atlas-journey article>b{font-size:1.9rem}}</style>
</Layout>
