---
import Layout from '../../layouts/Layout.astro';
export function getStaticPaths(){return ['en','es','pt','ru','tr'].map(lang=>({params:{lang}}))}
---
<Layout title="China Sourcing Service Matcher | Sourcing Ally" description="Answer a few practical questions to explore the Sourcing Ally service, guide, or project-brief path that may fit your current sourcing situation." lang="en">
<section class="matcher-hero"><div class="container matcher-hero-grid"><div><a class="back-link" href="/en/paths/">← Buyer paths</a><p class="eyebrow">Sourcing Service Matcher</p><h1>Start with the decision—not a generic service list.</h1><p>Answer three short questions. This local tool suggests the most relevant Sourcing Ally starting point. It does not store or submit your answers.</p></div><aside><span>SA / MATCHER</span><strong>03<br/>QUESTIONS</strong><p>One clearer next step.</p></aside></div></section>
<section class="matcher-workspace section-pad"><div class="container matcher-grid"><form id="matcher-form" class="matcher-form"><div class="match-step is-open" data-match-step="0"><span>01</span><div><p class="eyebrow">Your starting point</p><h2>What is the main situation?</h2><div class="match-options"><label><input type="radio" name="situation" value="start" checked><b>I have a product idea or first order</b><small>I need a clearer supplier, sample, or product starting point.</small></label><label><input type="radio" name="situation" value="existing"><b>I already have a supplier or active order</b><small>I need help with a sample, quality, packaging, communication, or progress question.</small></label><label><input type="radio" name="situation" value="visit"><b>I am planning a China supplier or market visit</b><small>I need a useful route, purpose, and visit checklist.</small></label></div></div></div><div class="match-step" data-match-step="1"><span>02</span><div><p class="eyebrow">The local question</p><h2>What would be most useful right now?</h2><div class="match-options"><label><input type="radio" name="need" value="research" checked><b>Supplier research or comparison</b></label><label><input type="radio" name="need" value="sample"><b>Sample review, factory check, or quality question</b></label><label><input type="radio" name="need" value="communication"><b>Packaging, translation, or supplier communication</b></label><label><input type="radio" name="need" value="travel"><b>Factory or market travel support</b></label></div></div></div><div class="match-step" data-match-step="2"><span>03</span><div><p class="eyebrow">The decision</p><h2>How prepared is your product brief?</h2><div class="match-options"><label><input type="radio" name="brief" value="early" checked><b>I have an idea, image, or product link</b></label><label><input type="radio" name="brief" value="clear"><b>I have product requirements and a quantity range</b></label><label><input type="radio" name="brief" value="active"><b>I have supplier details, samples, or order information</b></label></div></div></div><div class="matcher-actions"><button type="button" class="button" id="match-next">Continue ↓</button><button type="button" class="button button-outline" id="match-result">Show my starting point ↗</button><p>Your selections stay in this browser session only.</p></div></form><aside class="match-result" id="match-result-panel" aria-live="polite"><p class="eyebrow">Your starting point</p><h2>Answer the three questions.</h2><p>Then we will show the most relevant buyer path, service page, or project-preparation tool.</p><div class="result-mark">SA</div></aside></div></section>
</Layout>
<script>
  const form = document.querySelector('#matcher-form');
  const steps = [...document.querySelectorAll('[data-match-step]')];
  const nextButton = document.querySelector('#match-next');
  const resultButton = document.querySelector('#match-result');
  const panel = document.querySelector('#match-result-panel');
  let current = 0;
  const setStep = (index) => { current=index; steps.forEach((step,i)=>step.classList.toggle('is-open',i===index)); nextButton.textContent=index===2?'Ready to match ↗':'Continue ↓'; };
  const getResult = () => {
    const data = new FormData(form); const situation=data.get('situation'); const need=data.get('need'); const brief=data.get('brief');
    if(situation==='visit' || need==='travel') return { eyebrow:'Route recommendation', title:'Plan the China Visit path', copy:'Start with a visit objective, actual addresses, a realistic route, and the evidence you need to collect. The Route Map and China Visit path help you prepare before travel.', link:'/en/paths/china-visit/', label:'Open China Visit path ↗' };
    if(situation==='existing' && (need==='sample' || need==='communication')) return { eyebrow:'Route recommendation', title:'Clarify the existing supplier situation', copy:'Bring the current brief, sample or order details, photos, supplier messages, and the exact issue into one written record before deciding what local check or communication support is useful.', link:'/en/paths/existing-supplier-rescue/', label:'Open Existing Supplier path ↗' };
    if(need==='sample') return { eyebrow:'Service recommendation', title:'Start with the sample and quality question', copy:'Use a sample, factory-check, or quality-control path only after the product requirement and the evidence you need are clearly described.', link:'/en/services/sample-sourcing/', label:'Explore Sample Sourcing ↗' };
    if(need==='communication') return { eyebrow:'Service recommendation', title:'Start with the current product record', copy:'Packaging and communication work is easier when the product version, files, questions, and expected outcome are visible in writing.', link:'/en/services/translation/', label:'Explore Translation Support ↗' };
    if(brief==='early') return { eyebrow:'Buyer path recommendation', title:'Start with the First Import path', copy:'Turn the product idea, references, target quantity, destination, and unknowns into a short brief before comparing suppliers.', link:'/en/paths/first-import/', label:'Open First Import path ↗' };
    return { eyebrow:'Service recommendation', title:'Start with supplier research and comparison', copy:'A clear product brief and consistent supplier questions create a better basis for a sample, factory visit, or next sourcing decision.', link:'/en/services/supplier-sourcing/', label:'Explore Supplier Sourcing ↗' };
  };
  nextButton.addEventListener('click',()=>{ if(current<2) setStep(current+1); else resultButton.click(); });
  resultButton.addEventListener('click',()=>{ const result=getResult(); panel.innerHTML=`<p class="eyebrow">${result.eyebrow}</p><h2>${result.title}</h2><p>${result.copy}</p><a class="button" href="${result.link}">${result.label}</a><a class="text-link" href="/en/start-project/">Or build a project brief ↗</a><div class="result-mark">✓</div>`; panel.classList.add('has-result'); });
</script>
<style>.matcher-hero{background:#f4f8ff;padding:86px 0 98px;position:relative;overflow:hidden}.matcher-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.matcher-hero-grid{position:relative;display:grid;grid-template-columns:1fr .42fr;gap:80px;align-items:end}.back-link{display:inline-block;color:var(--blue);font-size:.84rem;font-weight:750;margin-bottom:40px}.matcher-hero h1{font-size:clamp(3rem,6vw,5.9rem);letter-spacing:-.08em;line-height:.96;margin:0 0 20px;max-width:850px}.matcher-hero p:not(.eyebrow){font-size:1.1rem;color:#405069;line-height:1.8;max-width:650px;margin:0}.matcher-hero aside{min-height:310px;background:var(--gold);padding:25px;color:var(--ink);box-shadow:17px 17px 0 rgba(40,103,217,.13);position:relative;overflow:hidden}.matcher-hero aside:after{content:"";position:absolute;width:250px;height:250px;border:1px solid rgba(13,43,80,.28);border-radius:50%;right:-120px;bottom:-110px}.matcher-hero aside>*{position:relative;z-index:2}.matcher-hero aside span{font-size:.65rem;color:var(--coral);font-weight:800;letter-spacing:.13em}.matcher-hero aside strong{display:block;font-size:3rem;line-height:.8;letter-spacing:-.08em;margin:42px 0 17px}.matcher-hero aside p{font-size:.85rem!important}.matcher-workspace{background:#fff}.matcher-grid{display:grid;grid-template-columns:1.2fr .62fr;gap:25px;align-items:start}.matcher-form{border:1px solid var(--line);border-radius:18px;overflow:hidden}.match-step{display:none;grid-template-columns:70px 1fr;gap:20px;padding:32px;border-bottom:1px solid var(--line)}.match-step.is-open{display:grid;animation:matchin .35s ease}.match-step>span{color:var(--coral);font-weight:850;font-size:1.3rem}.match-step h2{font-size:clamp(1.8rem,3vw,2.8rem);letter-spacing:-.055em;margin:0 0 22px}.match-options{display:grid;grid-template-columns:1fr 1fr;gap:10px}.match-options label{border:1px solid var(--line);padding:15px;border-radius:10px;cursor:pointer;transition:.2s}.match-options label:has(input:checked){border-color:var(--blue);background:#eef4fb;box-shadow:4px 4px 0 rgba(40,103,217,.11)}.match-options input{accent-color:var(--blue);margin:0 7px 0 0}.match-options b{font-size:.9rem}.match-options small{display:block;color:var(--muted);line-height:1.5;margin:7px 0 0 24px}.matcher-actions{display:flex;flex-wrap:wrap;gap:12px;padding:25px 32px}.button-outline{background:#fff;color:var(--blue);border:1px solid var(--blue)}.matcher-actions p{width:100%;font-size:.73rem;color:var(--muted);margin:3px 0 0}.match-result{position:sticky;top:110px;background:var(--ink);color:white;border-radius:18px;min-height:375px;padding:28px;overflow:hidden}.match-result:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.07) 1px,transparent 1px);background-size:34px 34px;opacity:.6}.match-result>*{position:relative;z-index:2}.match-result .eyebrow{color:var(--gold)}.match-result h2{font-size:2.1rem;letter-spacing:-.06em;line-height:1;margin:0 0 15px}.match-result p:not(.eyebrow){color:#cbd8e8;line-height:1.75}.match-result .button{margin-top:18px}.match-result .text-link{display:block;color:var(--gold);margin-top:20px}.result-mark{position:absolute!important;right:22px;bottom:13px;color:rgba(247,201,72,.28);font-size:7rem!important;font-weight:900;letter-spacing:-.1em}.match-result.has-result{box-shadow:14px 15px 0 rgba(247,201,72,.55)}@keyframes matchin{from{opacity:0;transform:translateX(12px)}to{opacity:1;transform:none}}@media(max-width:800px){.matcher-hero-grid,.matcher-grid{grid-template-columns:1fr;gap:38px}.matcher-hero aside{max-width:320px}.match-result{position:relative;top:auto}.match-options{grid-template-columns:1fr}}@media(max-width:540px){.matcher-hero{padding:70px 0 78px}.matcher-hero h1{font-size:3rem}.match-step{grid-template-columns:1fr;padding:23px}.matcher-actions{padding:20px 23px}.matcher-actions .button{width:100%;text-align:center}}</style>
