---
import Layout from '../../layouts/Layout.astro';
import { localeAvailability } from '../../data/locale-availability';
export function getStaticPaths(){return ['en','es','pt','ru','tr','fr','ja','de','ar','id','it'].map(lang=>({params:{lang}}))}
const lang=Astro.params.lang || 'en';
const locales={
 en:{title:'China Sourcing Service Matcher | Sourcing Ally',desc:'Answer practical questions to explore the Sourcing Ally service, guide, or project-brief path that may fit your sourcing situation.',back:'← Buyer paths',eyebrow:'Sourcing Service Matcher',hero:'Start with the decision—not a generic service list.',intro:'Answer three short questions. This local tool suggests the most relevant Sourcing Ally starting point. It does not store or submit your answers.',side:'One clearer next step.',s1:'Your starting point',q1:'What is the main situation?',situations:[['start','I have a product idea or first order','I need a clearer supplier, sample, or product starting point.'],['existing','I already have a supplier or active order','I need help with a sample, quality, packaging, communication, or progress question.'],['visit','I am planning a China supplier or market visit','I need a useful route, purpose, and visit checklist.']],s2:'The local question',q2:'What would be most useful right now?',needs:[['research','Supplier research or comparison'],['sample','Sample review, factory check, or quality question'],['communication','Packaging, translation, or supplier communication'],['travel','Factory or market travel support']],s3:'The decision',q3:'How prepared is your product brief?',briefs:[['early','I have an idea, image, or product link'],['clear','I have product requirements and a quantity range'],['active','I have supplier details, samples, or order information']],continue:'Continue ↓',ready:'Ready to match ↗',show:'Show my starting point ↗',privacy:'Your selections stay in this browser session only.',resultEyebrow:'Your starting point',resultTitle:'Answer the three questions.',resultCopy:'Then we will show the most relevant buyer path, service page, or project-preparation tool.',orBrief:'Or build a project brief ↗',results:{visit:['Route recommendation','Plan the China Visit path','Start with a visit objective, actual addresses, a realistic route, and the evidence you need to collect. The Route Map and China Visit path help you prepare before travel.','Open China Visit path ↗'],existing:['Route recommendation','Clarify the existing supplier situation','Bring the current brief, sample or order details, photos, supplier messages, and the exact issue into one written record before deciding what local check or communication support is useful.','Open Existing Supplier path ↗'],sample:['Service recommendation','Start with the sample and quality question','Use a sample, factory-check, or quality-control path only after the product requirement and the evidence you need are clearly described.','Explore Sample Sourcing ↗'],communication:['Service recommendation','Start with the current product record','Packaging and communication work is easier when the product version, files, questions, and expected outcome are visible in writing.','Explore Translation Support ↗'],early:['Buyer path recommendation','Start with the First Import path','Turn the product idea, references, target quantity, destination, and unknowns into a short brief before comparing suppliers.','Open First Import path ↗'],research:['Service recommendation','Start with supplier research and comparison','A clear product brief and consistent supplier questions create a better basis for a sample, factory visit, or next sourcing decision.','Explore Supplier Sourcing ↗']}},
 es:{title:'Selector de servicios de compras en China | Sourcing Ally',desc:'Responda preguntas prácticas para explorar el servicio, guía o briefing de Sourcing Ally que puede encajar con su situación.',back:'← Rutas del comprador',eyebrow:'Selector de servicios',hero:'Empiece por la decisión, no por una lista genérica de servicios.',intro:'Responda tres preguntas breves. Esta herramienta local sugiere el punto de partida de Sourcing Ally más relevante. No guarda ni envía sus respuestas.',side:'Un siguiente paso más claro.',s1:'Su punto de partida',q1:'¿Cuál es su situación principal?',situations:[['start','Tengo una idea de producto o un primer pedido','Necesito un punto de partida más claro para proveedores, muestras o producto.'],['existing','Ya tengo proveedor o un pedido en marcha','Necesito ayuda con una muestra, calidad, embalaje, comunicación o avance.'],['visit','Estoy preparando una visita a proveedores o mercados en China','Necesito una ruta, un propósito y una lista de comprobación útiles.']],s2:'La cuestión local',q2:'¿Qué sería más útil ahora?',needs:[['research','Investigación o comparación de proveedores'],['sample','Revisión de muestras, comprobación de fábrica o cuestión de calidad'],['communication','Embalaje, traducción o comunicación con proveedores'],['travel','Apoyo para visitar fábricas o mercados']],s3:'La decisión',q3:'¿Cómo de preparado está su briefing de producto?',briefs:[['early','Tengo una idea, imagen o enlace de producto'],['clear','Tengo requisitos de producto y un rango de cantidades'],['active','Tengo datos del proveedor, muestras o información del pedido']],continue:'Continuar ↓',ready:'Listo para ver la recomendación ↗',show:'Ver mi punto de partida ↗',privacy:'Sus selecciones permanecen solo en esta sesión del navegador.',resultEyebrow:'Su punto de partida',resultTitle:'Responda las tres preguntas.',resultCopy:'Después mostraremos la ruta, página de servicio o herramienta de preparación más relevante.',orBrief:'O cree un briefing de proyecto ↗',results:{visit:['Recomendación de ruta','Planifique la ruta de visita a China','Empiece por un objetivo de visita, direcciones reales, una ruta viable y las pruebas que necesita reunir. El Mapa de rutas y la ruta de visita a China le ayudan a prepararse antes de viajar.','Abrir ruta de visita a China ↗'],existing:['Recomendación de ruta','Aclare la situación del proveedor actual','Reúna el briefing, los detalles de muestra o pedido, fotos, mensajes del proveedor y el problema exacto en un registro escrito antes de decidir qué comprobación local o apoyo de comunicación es útil.','Abrir ruta de proveedor actual ↗'],sample:['Recomendación de servicio','Empiece por la muestra y la cuestión de calidad','Utilice una ruta de muestras, comprobación de fábrica o control de calidad solo después de describir con claridad los requisitos del producto y la evidencia necesaria.','Explorar búsqueda de muestras ↗'],communication:['Recomendación de servicio','Empiece por el registro actual del producto','El embalaje y la comunicación resultan más fáciles cuando la versión del producto, archivos, preguntas y resultado esperado están visibles por escrito.','Explorar apoyo de traducción ↗'],early:['Recomendación de ruta','Empiece por la ruta de primera importación','Convierta la idea de producto, referencias, cantidad objetivo, destino e incógnitas en un briefing breve antes de comparar proveedores.','Abrir ruta de primera importación ↗'],research:['Recomendación de servicio','Empiece por investigar y comparar proveedores','Un briefing claro y preguntas consistentes para proveedores crean una mejor base para una muestra, visita a fábrica o siguiente decisión.','Explorar búsqueda de proveedores ↗']}},
 pt:{title:'Seletor de serviços de sourcing na China | Sourcing Ally',desc:'Responda perguntas práticas para explorar o serviço, guia ou briefing da Sourcing Ally mais adequado à sua situação de sourcing.',back:'← Caminhos do comprador',eyebrow:'Seletor de serviços de sourcing',hero:'Comece pela decisão, não por uma lista genérica de serviços.',intro:'Responda a três perguntas curtas. Esta ferramenta local sugere o ponto de partida mais relevante da Sourcing Ally. Ela não armazena nem envia suas respostas.',side:'Um próximo passo mais claro.',s1:'Seu ponto de partida',q1:'Qual é a situação principal?',situations:[['start','Tenho uma ideia de produto ou primeiro pedido','Preciso de um ponto de partida mais claro para fornecedor, amostra ou produto.'],['existing','Já tenho um fornecedor ou pedido em andamento','Preciso de ajuda com amostra, qualidade, embalagem, comunicação ou andamento.'],['visit','Estou planejando uma visita a fornecedores ou mercados na China','Preciso de uma rota, objetivo e lista de verificação úteis.']],s2:'A questão local',q2:'O que seria mais útil agora?',needs:[['research','Pesquisa ou comparação de fornecedores'],['sample','Revisão de amostra, verificação de fábrica ou questão de qualidade'],['communication','Embalagem, tradução ou comunicação com fornecedores'],['travel','Apoio para visitar fábricas ou mercados']],s3:'A decisão',q3:'Como está o briefing do seu produto?',briefs:[['early','Tenho uma ideia, imagem ou link de produto'],['clear','Tenho requisitos de produto e uma faixa de quantidade'],['active','Tenho detalhes do fornecedor, amostras ou informações do pedido']],continue:'Continuar ↓',ready:'Pronto para recomendar ↗',show:'Mostrar meu ponto de partida ↗',privacy:'Suas seleções ficam apenas nesta sessão do navegador.',resultEyebrow:'Seu ponto de partida',resultTitle:'Responda às três perguntas.',resultCopy:'Em seguida mostraremos o caminho do comprador, a página de serviço ou a ferramenta de preparação mais relevante.',orBrief:'Ou crie um briefing de projeto ↗',results:{visit:['Recomendação de rota','Planeje o caminho de visita à China','Comece com um objetivo de visita, endereços reais, uma rota viável e as evidências que precisa coletar. O Mapa de rotas e o caminho de visita à China ajudam antes da viagem.','Abrir caminho de visita à China ↗'],existing:['Recomendação de rota','Esclareça a situação do fornecedor atual','Reúna o briefing atual, detalhes de amostra ou pedido, fotos, mensagens do fornecedor e o problema exato em um único registro escrito antes de decidir qual verificação local ou apoio de comunicação é útil.','Abrir caminho do fornecedor atual ↗'],sample:['Recomendação de serviço','Comece pela questão da amostra e qualidade','Use uma rota de amostra, verificação de fábrica ou controle de qualidade somente após descrever claramente o requisito do produto e as evidências necessárias.','Explorar busca de amostras ↗'],communication:['Recomendação de serviço','Comece pelo registro atual do produto','O trabalho de embalagem e comunicação é mais simples quando a versão do produto, arquivos, perguntas e resultado esperado estão claros por escrito.','Explorar apoio de tradução ↗'],early:['Recomendação de caminho','Comece pelo caminho da primeira importação','Transforme a ideia de produto, referências, quantidade alvo, destino e dúvidas em um briefing curto antes de comparar fornecedores.','Abrir caminho da primeira importação ↗'],research:['Recomendação de serviço','Comece pela pesquisa e comparação de fornecedores','Um briefing de produto claro e perguntas consistentes aos fornecedores criam uma base melhor para uma amostra, visita à fábrica ou próxima decisão.','Explorar busca de fornecedores ↗']}},
 ru:{title:'Подбор услуг по закупкам в Китае | Sourcing Ally',desc:'Ответьте на практические вопросы, чтобы подобрать наиболее подходящую услугу, руководство или бриф Sourcing Ally.',back:'← Маршруты покупателя',eyebrow:'Подбор услуг',hero:'Начните с решения, а не с общего списка услуг.',intro:'Ответьте на три коротких вопроса. Этот локальный инструмент предложит наиболее подходящую отправную точку Sourcing Ally. Он не сохраняет и не отправляет ваши ответы.',side:'Один более понятный следующий шаг.',s1:'Ваша отправная точка',q1:'Какая ситуация главная?',situations:[['start','У меня есть идея товара или первый заказ','Мне нужна более понятная отправная точка по поставщику, образцу или товару.'],['existing','У меня уже есть поставщик или активный заказ','Мне нужна помощь с образцом, качеством, упаковкой, коммуникацией или ходом работы.'],['visit','Я планирую визит к поставщикам или на рынки в Китае','Мне нужен полезный маршрут, цель и чек-лист визита.']],s2:'Локальный вопрос',q2:'Что сейчас было бы наиболее полезно?',needs:[['research','Поиск или сравнение поставщиков'],['sample','Проверка образца, фабрики или вопрос качества'],['communication','Упаковка, перевод или связь с поставщиком'],['travel','Поддержка поездки на фабрики или рынки']],s3:'Решение',q3:'Насколько готов бриф по товару?',briefs:[['early','У меня есть идея, изображение или ссылка на товар'],['clear','У меня есть требования к товару и диапазон количества'],['active','У меня есть данные поставщика, образцы или сведения о заказе']],continue:'Продолжить ↓',ready:'Готово к подбору ↗',show:'Показать мою отправную точку ↗',privacy:'Ваш выбор остаётся только в этой сессии браузера.',resultEyebrow:'Ваша отправная точка',resultTitle:'Ответьте на три вопроса.',resultCopy:'Затем мы покажем наиболее подходящий маршрут покупателя, страницу услуги или инструмент подготовки проекта.',orBrief:'Или создайте бриф проекта ↗',results:{visit:['Рекомендация маршрута','Спланируйте маршрут визита в Китай','Начните с цели визита, реальных адресов, реалистичного маршрута и доказательств, которые необходимо собрать. Карта маршрутов и путь визита в Китай помогут подготовиться до поездки.','Открыть путь визита в Китай ↗'],existing:['Рекомендация маршрута','Уточните ситуацию с текущим поставщиком','Соберите текущий бриф, данные образца или заказа, фото, сообщения поставщика и точную проблему в одном письменном документе, прежде чем решать, какая локальная проверка или поддержка коммуникации нужна.','Открыть путь с текущим поставщиком ↗'],sample:['Рекомендация услуги','Начните с вопроса образца и качества','Используйте путь работы с образцом, проверкой фабрики или контролем качества только после того, как требования к товару и нужные доказательства ясно описаны.','Изучить поиск образцов ↗'],communication:['Рекомендация услуги','Начните с текущего описания товара','Работа с упаковкой и коммуникацией проще, когда версия товара, файлы, вопросы и ожидаемый результат видны в письменном виде.','Изучить поддержку перевода ↗'],early:['Рекомендация пути','Начните с пути первого импорта','Превратите идею товара, референсы, целевое количество, рынок назначения и неизвестные в короткий бриф до сравнения поставщиков.','Открыть путь первого импорта ↗'],research:['Рекомендация услуги','Начните с поиска и сравнения поставщиков','Чёткий бриф по товару и одинаковые вопросы поставщикам создают лучшую основу для образца, визита на фабрику или следующего решения.','Изучить поиск поставщиков ↗']}},
 tr:{title:'Çin tedarik hizmet eşleştiricisi | Sourcing Ally',desc:'Tedarik durumunuza uygun Sourcing Ally hizmetini, rehberini veya proje özeti yolunu keşfetmek için pratik soruları yanıtlayın.',back:'← Alıcı yolları',eyebrow:'Tedarik hizmet eşleştiricisi',hero:'Genel bir hizmet listesiyle değil, kararla başlayın.',intro:'Üç kısa soruyu yanıtlayın. Bu yerel araç en uygun Sourcing Ally başlangıç noktasını önerir. Yanıtlarınızı saklamaz veya göndermez.',side:'Daha net bir sonraki adım.',s1:'Başlangıç noktanız',q1:'Ana durum nedir?',situations:[['start','Bir ürün fikrim veya ilk siparişim var','Tedarikçi, numune veya ürün için daha net bir başlangıç noktasına ihtiyacım var.'],['existing','Zaten bir tedarikçim veya devam eden siparişim var','Numune, kalite, ambalaj, iletişim veya ilerleme konusunda yardıma ihtiyacım var.'],['visit','Çin’de tedarikçi veya pazar ziyareti planlıyorum','Yararlı bir rota, amaç ve ziyaret kontrol listesine ihtiyacım var.']],s2:'Yerel soru',q2:'Şu anda en faydalı olan nedir?',needs:[['research','Tedarikçi araştırması veya karşılaştırması'],['sample','Numune incelemesi, fabrika kontrolü veya kalite sorusu'],['communication','Ambalaj, çeviri veya tedarikçi iletişimi'],['travel','Fabrika veya pazar seyahati desteği']],s3:'Karar',q3:'Ürün özetiniz ne kadar hazır?',briefs:[['early','Bir fikrim, görselim veya ürün bağlantım var'],['clear','Ürün gereksinimlerim ve miktar aralığım var'],['active','Tedarikçi ayrıntılarım, numunelerim veya sipariş bilgim var']],continue:'Devam et ↓',ready:'Eşleştirmeye hazır ↗',show:'Başlangıç noktamı göster ↗',privacy:'Seçimleriniz yalnızca bu tarayıcı oturumunda kalır.',resultEyebrow:'Başlangıç noktanız',resultTitle:'Üç soruyu yanıtlayın.',resultCopy:'Ardından en ilgili alıcı yolunu, hizmet sayfasını veya proje hazırlama aracını göstereceğiz.',orBrief:'Ya da proje özeti oluşturun ↗',results:{visit:['Rota önerisi','Çin Ziyareti yolunu planlayın','Ziyaret amacı, gerçek adresler, gerçekçi bir rota ve toplamanız gereken kanıtlarla başlayın. Rota Haritası ve Çin Ziyareti yolu seyahatten önce hazırlanmanıza yardımcı olur.','Çin Ziyareti yolunu aç ↗'],existing:['Rota önerisi','Mevcut tedarikçi durumunu netleştirin','Hangi yerel kontrolün veya iletişim desteğinin yararlı olduğuna karar vermeden önce mevcut özeti, numune veya sipariş ayrıntılarını, fotoğrafları, tedarikçi mesajlarını ve kesin sorunu tek bir yazılı kayıtta toplayın.','Mevcut tedarikçi yolunu aç ↗'],sample:['Hizmet önerisi','Numune ve kalite sorusuyla başlayın','Ürün gereksinimi ve ihtiyaç duyduğunuz kanıtlar net biçimde açıklanmadan numune, fabrika kontrolü veya kalite kontrolü yolunu kullanmayın.','Numune tedarikini incele ↗'],communication:['Hizmet önerisi','Mevcut ürün kaydıyla başlayın','Ürün sürümü, dosyalar, sorular ve beklenen sonuç yazılı olarak görünür olduğunda ambalaj ve iletişim çalışması daha kolaydır.','Çeviri desteğini incele ↗'],early:['Alıcı yolu önerisi','İlk İthalat yoluyla başlayın','Tedarikçileri karşılaştırmadan önce ürün fikrini, referansları, hedef miktarı, hedef pazarı ve bilinmeyenleri kısa bir özete dönüştürün.','İlk İthalat yolunu aç ↗'],research:['Hizmet önerisi','Tedarikçi araştırması ve karşılaştırmasıyla başlayın','Net bir ürün özeti ve tutarlı tedarikçi soruları, numune, fabrika ziyareti veya sonraki tedarik kararı için daha iyi bir temel oluşturur.','Tedarikçi araştırmasını incele ↗']}}
};
const fr={title:'Outil d’orientation des services de sourcing en Chine | Sourcing Ally',desc:'Répondez à quelques questions pratiques pour découvrir le service, le guide ou le parcours Sourcing Ally qui correspond le mieux à votre situation.',back:'← Parcours acheteurs',eyebrow:'Outil d’orientation sourcing',hero:'Partez de la décision, pas d’une liste de services générique.',intro:'Répondez à trois courtes questions. Cet outil local suggère le point de départ Sourcing Ally le plus pertinent. Il ne conserve ni ne transmet vos réponses.',side:'Une prochaine étape plus claire.',s1:'Votre point de départ',q1:'Quelle est votre situation principale ?',situations:[['start','J’ai une idée de produit ou une première commande','J’ai besoin d’un point de départ plus clair pour le fournisseur, l’échantillon ou le produit.'],['existing','J’ai déjà un fournisseur ou une commande en cours','J’ai besoin d’aide pour un échantillon, la qualité, l’emballage, la communication ou le suivi.'],['visit','Je prépare une visite de fournisseurs ou de marchés en Chine','J’ai besoin d’un itinéraire, d’un objectif et d’une liste de contrôle utiles.']],s2:'La question locale',q2:'Qu’est-ce qui serait le plus utile maintenant ?',needs:[['research','Recherche ou comparaison de fournisseurs'],['sample','Analyse d’échantillon, vérification d’usine ou question de qualité'],['communication','Emballage, traduction ou communication avec les fournisseurs'],['travel','Accompagnement pour visiter des usines ou marchés']],s3:'La décision',q3:'À quel stade en est votre brief produit ?',briefs:[['early','J’ai une idée, une image ou un lien produit'],['clear','J’ai les exigences du produit et une fourchette de quantité'],['active','J’ai les informations du fournisseur, des échantillons ou les données de commande']],continue:'Continuer ↓',ready:'Voir la recommandation ↗',show:'Afficher mon point de départ ↗',privacy:'Vos choix restent uniquement dans cette session de navigateur.',resultEyebrow:'Votre point de départ',resultTitle:'Répondez aux trois questions.',resultCopy:'Nous afficherons ensuite le parcours acheteur, la page de service ou l’outil de préparation le plus pertinent.',orBrief:'Ou créer un brief projet ↗',results:{visit:['Recommandation de parcours','Préparez le parcours Visite en Chine','Commencez par un objectif de visite, des adresses réelles, un itinéraire réaliste et les éléments à vérifier. La Carte des itinéraires et le parcours Visite en Chine vous aident à préparer le voyage.','Ouvrir le parcours Visite en Chine ↗'],existing:['Recommandation de parcours','Clarifiez la situation avec le fournisseur actuel','Réunissez le brief actuel, les détails de l’échantillon ou de la commande, les photos, les messages du fournisseur et le problème précis dans un seul dossier écrit avant de décider quelle vérification locale ou aide de communication serait utile.','Ouvrir le parcours Fournisseur actuel ↗'],sample:['Recommandation de service','Commencez par la question de l’échantillon et de la qualité','Utilisez un parcours d’échantillon, de vérification d’usine ou de contrôle qualité seulement après avoir décrit clairement les exigences du produit et les éléments à vérifier.','Découvrir la recherche d’échantillons ↗'],communication:['Recommandation de service','Commencez par le dossier produit actuel','Le travail sur l’emballage et la communication est plus simple lorsque la version du produit, les fichiers, les questions et le résultat attendu sont clairement visibles par écrit.','Découvrir l’assistance de traduction ↗'],early:['Recommandation de parcours','Commencez par le parcours Première importation','Transformez l’idée produit, les références, la quantité cible, le marché de destination et les inconnues en un brief concis avant de comparer des fournisseurs.','Ouvrir le parcours Première importation ↗'],research:['Recommandation de service','Commencez par rechercher et comparer les fournisseurs','Un brief produit clair et des questions cohérentes adressées aux fournisseurs constituent une meilleure base pour un échantillon, une visite d’usine ou la prochaine décision de sourcing.','Découvrir la recherche de fournisseurs ↗']}};
const c=(lang==='fr' ? fr : locales[lang as keyof typeof locales]) || locales.en;
const unavailable=false;
const availability=unavailable ? localeAvailability.fr : undefined;
---
<Layout title={c.title} description={c.desc} lang={lang} noindex={lang === 'fr'}>
{unavailable && availability && <section class="matcher-availability section-pad"><div class="container availability-inner"><p class="eyebrow">Sourcing Ally</p><h1>{availability.toolTitle}</h1><p>{availability.toolCopy}</p><a class="button" href={`/${lang}/questions/`}>{availability.questionsAction}</a></div></section>}
<section class:list={['matcher-hero',unavailable && 'locale-source-only']}><div class="container matcher-hero-grid"><div><a class="back-link" href={`/${lang}/paths/`}>{c.back}</a><p class="eyebrow">{c.eyebrow}</p><h1>{c.hero}</h1><p>{c.intro}</p></div><aside><span>SA / MATCHER</span><strong>03<br/>QUESTIONS</strong><p>{c.side}</p></aside></div></section>
<section class:list={['matcher-workspace','section-pad',unavailable && 'locale-source-only']}><div class="container matcher-grid"><form id="matcher-form" class="matcher-form" data-copy={JSON.stringify(c)}><div class="match-step is-open" data-match-step="0"><span>01</span><div><p class="eyebrow">{c.s1}</p><h2>{c.q1}</h2><div class="match-options">{c.situations.map((item,i)=><label><input type="radio" name="situation" value={item[0]} checked={i===0}/><b>{item[1]}</b><small>{item[2]}</small></label>)}</div></div></div><div class="match-step" data-match-step="1"><span>02</span><div><p class="eyebrow">{c.s2}</p><h2>{c.q2}</h2><div class="match-options">{c.needs.map((item,i)=><label><input type="radio" name="need" value={item[0]} checked={i===0}/><b>{item[1]}</b></label>)}</div></div></div><div class="match-step" data-match-step="2"><span>03</span><div><p class="eyebrow">{c.s3}</p><h2>{c.q3}</h2><div class="match-options">{c.briefs.map((item,i)=><label><input type="radio" name="brief" value={item[0]} checked={i===0}/><b>{item[1]}</b></label>)}</div></div></div><div class="matcher-actions"><button type="button" class="button" id="match-next">{c.continue}</button><button type="button" class="button button-outline" id="match-result">{c.show}</button><p>{c.privacy}</p></div></form><aside class="match-result" id="match-result-panel" aria-live="polite"><p class="eyebrow">{c.resultEyebrow}</p><h2>{c.resultTitle}</h2><p>{c.resultCopy}</p><div class="result-mark">SA</div></aside></div></section>
</Layout>
<script>
 const form=document.querySelector('#matcher-form'); const c=JSON.parse(form?.dataset.copy||'{}'); const steps=[...document.querySelectorAll('[data-match-step]')]; const nextButton=document.querySelector('#match-next'); const resultButton=document.querySelector('#match-result'); const panel=document.querySelector('#match-result-panel'); let current=0;
 const setStep=(index)=>{current=index;steps.forEach((step,i)=>step.classList.toggle('is-open',i===index));nextButton.textContent=index===2?c.ready:c.continue;};
 const route=(path)=>`/${document.documentElement.lang}${path}`;
 const getResult=()=>{const data=new FormData(form);const situation=data.get('situation');const need=data.get('need');const brief=data.get('brief');if(situation==='visit'||need==='travel')return [...c.results.visit,route('/paths/china-visit/')];if(situation==='existing'&&(need==='sample'||need==='communication'))return [...c.results.existing,route('/paths/existing-supplier-rescue/')];if(need==='sample')return [...c.results.sample,route('/services/sample-sourcing/')];if(need==='communication')return [...c.results.communication,route('/services/translation/')];if(brief==='early')return [...c.results.early,route('/paths/first-import/')];return [...c.results.research,route('/services/supplier-sourcing/')];};
 nextButton?.addEventListener('click',()=>{if(current<2)setStep(current+1);else resultButton?.click();}); resultButton?.addEventListener('click',()=>{const [eyebrow,title,copy,label,link]=getResult();panel.innerHTML=`<p class="eyebrow">${eyebrow}</p><h2>${title}</h2><p>${copy}</p><a class="button" href="${link}">${label}</a><a class="text-link" href="${route('/start-project/')}">${c.orBrief}</a><div class="result-mark">✓</div>`;panel.classList.add('has-result');});
</script>
<style>.matcher-hero{background:#f4f8ff;padding:86px 0 98px;position:relative;overflow:hidden}.matcher-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.matcher-hero-grid{position:relative;display:grid;grid-template-columns:1fr .42fr;gap:80px;align-items:end}.back-link{display:inline-block;color:var(--blue);font-size:.84rem;font-weight:750;margin-bottom:40px}.matcher-hero h1{font-size:clamp(3rem,6vw,5.9rem);letter-spacing:-.04em;line-height:.96;margin:0 0 20px;max-width:850px}.matcher-hero p:not(.eyebrow){font-size:1.1rem;color:#405069;line-height:1.8;max-width:650px;margin:0}.matcher-hero aside{min-height:310px;background:var(--gold);padding:25px;color:var(--ink);box-shadow:17px 17px 0 rgba(40,103,217,.13);position:relative;overflow:hidden}.matcher-hero aside:after{content:"";position:absolute;width:250px;height:250px;border:1px solid rgba(13,43,80,.28);border-radius:50%;right:-120px;bottom:-110px}.matcher-hero aside>*{position:relative;z-index:2}.matcher-hero aside span{font-size:.65rem;color:var(--coral);font-weight:800;letter-spacing:.13em}.matcher-hero aside strong{display:block;font-size:3rem;line-height:.8;letter-spacing:-.04em;margin:42px 0 17px}.matcher-hero aside p{font-size:.85rem!important}.matcher-workspace{background:#fff}.matcher-grid{display:grid;grid-template-columns:1.2fr .62fr;gap:25px;align-items:start}.matcher-form{border:1px solid var(--line);border-radius:18px;overflow:hidden}.match-step{display:none;grid-template-columns:70px 1fr;gap:20px;padding:32px;border-bottom:1px solid var(--line)}.match-step.is-open{display:grid;animation:matchin .35s ease}.match-step>span{color:var(--coral);font-weight:850;font-size:1.3rem}.match-step h2{font-size:clamp(1.8rem,3vw,2.8rem);letter-spacing:-.03em;margin:0 0 22px}.match-options{display:grid;grid-template-columns:1fr 1fr;gap:10px}.match-options label{border:1px solid var(--line);padding:15px;border-radius:10px;cursor:pointer;transition:.2s}.match-options label:has(input:checked){border-color:var(--blue);background:#eef4fb;box-shadow:4px 4px 0 rgba(40,103,217,.11)}.match-options input{accent-color:var(--blue);margin:0 7px 0 0}.match-options b{font-size:.9rem}.match-options small{display:block;color:var(--muted);line-height:1.5;margin:7px 0 0 24px}.matcher-actions{display:flex;flex-wrap:wrap;gap:12px;padding:25px 32px}.button-outline{background:#fff;color:var(--blue);border:1px solid var(--blue)}.matcher-actions p{width:100%;font-size:.73rem;color:var(--muted);margin:3px 0 0}.match-result{position:sticky;top:110px;background:var(--ink);color:white;border-radius:18px;min-height:375px;padding:28px;overflow:hidden}.match-result:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.07) 1px,transparent 1px);background-size:34px 34px;opacity:.6}.match-result>*{position:relative;z-index:2}.match-result .eyebrow{color:var(--gold)}.match-result h2{font-size:2.1rem;letter-spacing:-.03em;line-height:1;margin:0 0 15px}.match-result p:not(.eyebrow){color:#cbd8e8;line-height:1.75}.match-result .button{margin-top:18px}.match-result .text-link{display:block;color:var(--gold);margin-top:20px}.result-mark{position:absolute!important;right:22px;bottom:13px;color:rgba(247,201,72,.28);font-size:7rem!important;font-weight:900;letter-spacing:-.04em}.match-result.has-result{box-shadow:14px 15px 0 rgba(247,201,72,.55)}@keyframes matchin{from{opacity:0;transform:translateX(12px)}to{opacity:1;transform:none}}@media(max-width:800px){.matcher-hero-grid,.matcher-grid{grid-template-columns:1fr;gap:38px}.matcher-hero aside{max-width:320px}.match-result{position:relative;top:auto}.match-options{grid-template-columns:1fr}}@media(max-width:540px){.matcher-hero{padding:70px 0 78px}.matcher-hero h1{font-size:3rem}.match-step{grid-template-columns:1fr;padding:23px}.matcher-actions{padding:20px 23px}.matcher-actions .button{width:100%;text-align:center}}.matcher-availability{background:#f4f8ff}.availability-inner{max-width:780px}.availability-inner h1{font-size:clamp(2.8rem,5.5vw,5.2rem);line-height:1;letter-spacing:-.06em;margin:0 0 22px}.availability-inner>p:not(.eyebrow){font-size:1.1rem;line-height:1.75;color:var(--muted);max-width:680px;margin:0 0 30px}</style>
