---
import Layout from '../../../layouts/Layout.astro';
import { services, products, cities, guides } from '../../../data/site-data';
const sectionMap = { services, products, cities, guides };
const labels = {
  services: {kicker:'Work with us', title:'China sourcing is a chain of decisions—not one search.', intro:'A useful sourcing partner helps you move from an uncertain product idea to clearer supplier decisions, samples, factory conversations, quality checks, packaging, and the next logistics step.', tone:'services', framework:['Define the brief','Find and compare','Verify and sample','Manage production','Check and prepare']},
  products: {kicker:'Product intelligence', title:'Start with the product. Then find the place, process, and partner.', intro:'Different products create different sourcing questions. Materials, tooling, testing, packaging, MOQ, and destination-market obligations all change the way a project should be researched.', tone:'products', framework:['Material & use','Manufacturing method','Supplier questions','Quality checkpoints','Market requirements']},
  cities: {kicker:'China on the ground', title:'A city name is a starting point—not a supplier guarantee.', intro:'China’s manufacturing geography is connected by clusters, markets, factories, logistics, and specialist processes. Use location research to plan better questions and more useful visits.', tone:'cities', framework:['Choose the region','Find the process','Verify the address','Plan the route','Document the visit']},
  guides: {kicker:'Sourcing school', title:'Learn the system before you place the order.', intro:'The most expensive sourcing mistakes often begin before production: unclear requirements, weak supplier comparisons, untested assumptions, or confusion about responsibility. Start with a structured path.', tone:'guides', framework:['Start here','Find suppliers','Develop samples','Control quality','Ship and review']}
};
export function getStaticPaths(){return ['services','products','cities','guides'].map(section=>({params:{lang:'en',section},props:{section}}))}
const {section}=Astro.props; const t=labels[section as keyof typeof labels]; const items=sectionMap[section as keyof typeof sectionMap];
const featured = items.slice(0,3); const remainder = items.slice(3);
const faq = section === 'services' ? [['When should I use a sourcing partner?','A local partner can be useful when supplier communication, product verification, factory travel, quality checks, or coordination would be difficult to manage from abroad. The right scope depends on the product and project.'],['Do you visit every factory?','No. A factory visit is planned when the project size, product, supplier question, or risk makes an on-the-ground check worthwhile.'],['How does the fee work?','When a client orders through Sourcing Ally, the minimum sourcing service fee is 5%. Independent factory-travel support is $150 per day when the client does not order through Sourcing Ally.']] : section === 'products' ? [['Do all product categories require the same checks?','No. A toy, a textile, an electronic product, and a piece of furniture create different questions about materials, function, testing, packaging, and destination-market requirements.'],['Can you source a product not shown here?','The library is an educational starting point, not a complete list of capabilities. Share the product brief and Sourcing Ally can discuss whether the project is suitable.'],['Should I start with a sample?','For most new products, a sample or prototype is an important way to test assumptions before a larger production commitment.']] : section === 'cities' ? [['Is the city where the factory is located?','Not necessarily. A city may be associated with a market, a supplier ecosystem, or a manufacturing cluster. Always request and verify the actual production address.'],['Can you travel outside Shenzhen?','Sourcing Ally is based in Shenzhen and can work in nearby Guangdong areas. Farther travel within China can be discussed when the project requires it.'],['Should I plan a multi-city trip?','Only when the supplier shortlist and project goals justify it. A focused itinerary is usually more useful than trying to visit many places without a decision plan.']] : [['Where should a beginner start?','Start with a clear product brief, an understanding of the end market, and a structured supplier and sample process. The first lesson below gives you the sequence.'],['Can I do the work myself?','Yes. The purpose of Sourcing School is to help buyers understand the process, whether they work independently or decide that local support is useful.'],['Are the legal and compliance guides legal advice?','No. They are general educational guides. Requirements vary by product, destination, importer, and current rules, so obtain qualified advice for a real shipment.']];
---
<Layout title={`${t.title} | Sourcing Ally`} description={t.intro} lang="en">
  <section class={`hub-hero hub-${t.tone}`}><div class="container hub-hero-grid"><div><p class="eyebrow">{t.kicker}</p><h1>{t.title}</h1><p class="hero-intro">{t.intro}</p><div class="hero-actions"><a class="button" href="/en/#contact">Start with your project ↗</a><a class="text-link" href="#framework">See the framework ↓</a></div></div><div class="hub-visual"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="hub-visual-label"><span>FIELD GUIDE</span><b>{section === 'cities' ? 'China / on the ground' : section === 'guides' ? 'Learn / apply / review' : section === 'products' ? 'Product / process / proof' : 'Brief / sample / check'}</b></div><div class="hub-index">{section === 'services' ? '01—05' : section === 'products' ? 'A—E' : section === 'cities' ? 'SZ—CN' : '01—∞'}</div></div></div></section>
  <section id="framework" class="framework-section section-pad"><div class="container"><div class="section-heading"><div><p class="eyebrow">The way to think about it</p><h2>Useful sourcing has a sequence.</h2></div><p>Use this framework to understand what comes before the next decision. Each step connects to a deeper guide and a practical action.</p></div><div class="framework-line">{t.framework.map((step,index)=><div class="framework-step"><span>0{index+1}</span><b>{step}</b><i></i></div>)}</div></div></section>
  <section class="hub-story section-pad section-light"><div class="container story-grid"><div><p class="eyebrow">Why this matters</p><h2>{section === 'services' ? 'The supplier is only one part of the work.' : section === 'products' ? 'The same sourcing method does not fit every product.' : section === 'cities' ? 'Location research becomes useful when it changes your questions.' : 'Education gives you better decisions, not just more information.'}</h2></div><div class="story-copy"><p>{section === 'services' ? 'A supplier search can produce names and prices. A managed process helps you understand whether a supplier fits the requirement, whether the sample is meaningful, what should be checked during production, and what needs to be agreed before goods move.' : section === 'products' ? 'A product category is a set of manufacturing choices. The right page should help you think about materials, production methods, samples, quality, packaging, and market requirements before you compare quotations.' : section === 'cities' ? 'A location can point you toward a cluster, market, process, or travel route. It cannot replace supplier verification. Use city knowledge to plan the right visit and ask for the evidence that matters.' : 'A good guide should help you define the next action. Read the sequence, write down your own assumptions, compare the options, and then ask for help with a specific question rather than a vague request.'}</p><p class="story-note">Sourcing Ally is based in Shenzhen and supports international buyers with agreed project work across China.</p></div></div></section>
  <section class="featured-section section-pad"><div class="container"><div class="section-heading"><div><p class="eyebrow">Start here</p><h2>Three useful doorways into this topic.</h2></div><p>These are not advertisements. They are starting points chosen to help you understand the subject before you decide what to do.</p></div><div class="featured-grid">{featured.map((item,index)=><a class="featured-card" href={`/en/${section}/${item.slug}/`}><span class="featured-number">0{index+1}</span><span class="featured-label">{item.shortTitle}</span><h3>{item.title}</h3><p>{item.summary}</p><b>Read the full guide ↗</b></a>)}</div></div></section>
  <section class="tool-section section-pad section-light"><div class="container tool-grid"><div><p class="eyebrow">Practical tool</p><h2>Before you click “contact supplier”.</h2><p>Write down these questions first. They will make your research, quotation comparison, and first conversation much more useful.</p><a class="button" href="/en/guides/how-to-import-from-china/">Open the beginner guide ↗</a></div><div class="tool-list">{(section === 'services' ? ['What exactly do I need the supplier or partner to decide?','What must be checked before I pay or approve production?','What information can I provide in a product brief?','What would make this project unsuitable?'] : section === 'products' ? ['What is the product made from and how will it be used?','What could vary between a sample and mass production?','What packaging protects the product in real shipping?','Which destination-market questions must be checked?'] : section === 'cities' ? ['What process or supplier capability am I looking for?','Do I know the actual factory address?','What should I photograph, record, or ask during a visit?','What is the next decision after I return?'] : ['What is my product, quantity, destination, and timeline?','How will I compare suppliers on the same requirements?','Which sample and quality checks are necessary?','Who is responsible for customs, testing, and compliance?']).map((x,index)=><div><span>0{index+1}</span><p>{x}</p></div>)}</div></div></section>
  <section class="library-section section-pad"><div class="container"><div class="section-heading"><div><p class="eyebrow">Explore the library</p><h2>Go deeper when you are ready.</h2></div><p>The full library is organized so the next page answers the question that naturally follows the one you are reading.</p></div><div class="library-grid">{remainder.map(item=><a href={`/en/${section}/${item.slug}/`} class="library-row"><span>{item.shortTitle}</span><b>{item.title}</b><small>{item.summary}</small><i>↗</i></a>)}</div></div></section>
  <section class="faq-section section-pad section-light"><div class="container faq-grid"><div><p class="eyebrow">Questions buyers ask</p><h2>Clear answers before a real conversation.</h2></div><div>{faq.map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>
  <section class="hub-close"><div class="container close-inner"><div><p class="eyebrow">Make it specific</p><h2>Tell us what you are trying to source.</h2><p>Email the product, quantity, destination, timing, and the question you are trying to answer. We will discuss the next practical step.</p></div><a class="button button-light" href="mailto:sourcingally@gmail.com">Contact Sourcing Ally ↗</a></div></section>
</Layout>
<style>.hub-hero{padding:95px 0 110px;background:#f4f8ff;position:relative;overflow:hidden}.hub-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.42;mask-image:linear-gradient(to right,black,transparent 78%)}.hub-hero-grid{display:grid;grid-template-columns:1fr .7fr;gap:80px;align-items:center;position:relative}.hub-hero h1{font-size:clamp(3.1rem,6.5vw,6.4rem);line-height:.96;letter-spacing:-.075em;max-width:900px;margin:0 0 27px}.hub-hero .hero-intro{max-width:670px;font-size:1.14rem;line-height:1.75;color:var(--muted)}.hub-visual{aspect-ratio:1;max-width:430px;justify-self:end;border-radius:50%;background:var(--gold);border:1px solid rgba(13,43,80,.16);position:relative;display:grid;place-items:center;box-shadow:18px 18px 0 rgba(40,103,217,.13)}.hub-products .hub-visual{background:#bfe1ff}.hub-cities .hub-visual{background:#ffd2b8}.hub-guides .hub-visual{background:#ccebcf}.orbit{position:absolute;border:1px solid rgba(13,43,80,.3);border-radius:50%;animation:spin 18s linear infinite}.orbit-one{width:74%;height:32%;transform:rotate(-34deg)}.orbit-two{width:48%;height:80%;transform:rotate(42deg);animation-direction:reverse}.hub-visual-label{display:flex;flex-direction:column;gap:9px;text-align:center;z-index:2}.hub-visual-label span{font-size:.68rem;letter-spacing:.18em;font-weight:800;color:var(--coral)}.hub-visual-label b{font-size:1.35rem;letter-spacing:-.04em}.hub-index{position:absolute;bottom:18px;right:25px;font-size:.7rem;letter-spacing:.16em;font-weight:800;color:var(--electric,var(--blue))}.framework-section{background:white}.framework-line{display:grid;grid-template-columns:repeat(5,1fr);gap:0}.framework-step{position:relative;padding:0 18px 20px 0;min-height:120px}.framework-step:not(:last-child):after{content:"";position:absolute;left:36px;right:0;top:20px;border-top:1px solid var(--line)}.framework-step i{display:block;width:12px;height:12px;background:var(--gold);border:3px solid white;box-shadow:0 0 0 1px var(--blue);border-radius:50%;position:relative;z-index:2;margin:10px 0 19px}.framework-step span{font-size:.7rem;color:var(--coral);font-weight:800;letter-spacing:.1em}.framework-step b{font-size:1rem;display:block;max-width:130px;line-height:1.2}.hub-story{background:#eef4fb}.story-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:start}.story-grid h2{font-size:clamp(2.2rem,4vw,4rem);line-height:1.02;letter-spacing:-.06em;margin:0}.story-copy p{font-size:1.05rem;line-height:1.85;color:#405069;margin:0 0 20px}.story-note{border-left:3px solid var(--gold);padding-left:16px;font-size:.84rem!important}.featured-section{background:white}.featured-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.featured-card{border:1px solid var(--line);border-radius:20px;padding:28px;min-height:340px;display:flex;flex-direction:column;position:relative;overflow:hidden;transition:.25s}.featured-card:hover{transform:translateY(-8px);box-shadow:12px 14px 0 rgba(40,103,217,.12);border-color:var(--electric,var(--blue))}.featured-number{font-size:4.8rem;line-height:.8;letter-spacing:-.1em;color:#dceafe;font-weight:900}.featured-label{margin-top:33px;color:var(--coral);font-size:.7rem;text-transform:uppercase;letter-spacing:.13em;font-weight:800}.featured-card h3{font-size:1.35rem;line-height:1.1;letter-spacing:-.04em;margin:13px 0 10px}.featured-card p{color:var(--muted);font-size:.88rem;line-height:1.65;margin:0}.featured-card b{color:var(--electric,var(--blue));font-size:.8rem;margin-top:auto}.tool-section{background:#eef4fb}.tool-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:100px;align-items:start}.tool-grid h2{font-size:clamp(2.2rem,4vw,4rem);line-height:1.02;letter-spacing:-.06em;margin:0 0 17px}.tool-grid>div>p:not(.eyebrow){color:var(--muted);line-height:1.75;max-width:460px;margin-bottom:28px}.tool-list>div{display:grid;grid-template-columns:50px 1fr;gap:18px;border-top:1px solid var(--line);padding:17px 0}.tool-list span{color:var(--coral);font-size:.74rem;font-weight:800}.tool-list p{margin:0;color:var(--ink);font-weight:650}.library-section{background:white}.library-grid{border-top:1px solid var(--line)}.library-row{display:grid;grid-template-columns:150px 1.2fr 1fr 30px;gap:20px;align-items:center;padding:22px 5px;border-bottom:1px solid var(--line);transition:.2s}.library-row:hover{padding-left:14px;background:#f5f8fc}.library-row span{color:var(--coral);font-size:.7rem;text-transform:uppercase;letter-spacing:.12em;font-weight:800}.library-row b{font-size:1.05rem}.library-row small{color:var(--muted);line-height:1.5}.library-row i{font-size:1.2rem;color:var(--electric,var(--blue))}.faq-section{background:#eef4fb}.faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:100px}.faq-grid h2{font-size:clamp(2.3rem,4vw,4rem);line-height:1.02;letter-spacing:-.06em;margin:0}.faq-grid details{border-top:1px solid var(--line);padding:18px 0}.faq-grid summary{cursor:pointer;font-weight:700;list-style:none;display:flex;justify-content:space-between;gap:15px}.faq-grid summary::-webkit-details-marker{display:none}.faq-grid summary span{color:var(--coral);font-size:1.2rem}.faq-grid details p{color:var(--muted);line-height:1.7;max-width:680px;margin:14px 0 0}.hub-close{background:var(--ink);color:white;padding:78px 0}.close-inner{display:flex;align-items:center;justify-content:space-between;gap:60px}.close-inner h2{font-size:clamp(2.3rem,4vw,4.5rem);line-height:1;letter-spacing:-.06em;margin:0 0 17px}.close-inner p:not(.eyebrow){color:#cbd8e8;max-width:600px;line-height:1.75}.close-inner .eyebrow{color:var(--gold)}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:900px){.hub-hero-grid,.story-grid,.tool-grid,.faq-grid{grid-template-columns:1fr;gap:45px}.hub-visual{justify-self:start;width:min(100%,390px)}.framework-line{grid-template-columns:1fr;gap:0}.framework-step{min-height:75px;padding-left:40px}.framework-step:not(:last-child):after{left:5px;right:auto;top:30px;bottom:-10px;height:auto;border-top:0;border-left:1px solid var(--line)}.framework-step i{position:absolute;left:0;top:0}.featured-grid{grid-template-columns:1fr}.library-row{grid-template-columns:110px 1fr 25px}.library-row small{display:none}.close-inner{align-items:flex-start;flex-direction:column;gap:30px}}@media(max-width:600px){.hub-hero{padding:75px 0 80px}.hub-hero h1{font-size:3.1rem}.hub-hero .hero-intro{font-size:1rem}.hub-visual{width:100%;max-width:330px}.section-heading{margin-bottom:35px}.story-grid,.tool-grid,.faq-grid{gap:32px}.library-row{grid-template-columns:1fr 25px;gap:10px}.library-row span{grid-column:1 / -1}.library-row b{font-size:1rem}.featured-card{min-height:280px}.close-inner h2{font-size:2.7rem}}
</style>
