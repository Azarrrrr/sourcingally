---
import Layout from '../../../layouts/Layout.astro';
import { allKnowledge, services, products, cities, guides } from '../../../data/site-data';

const sectionMap = { services, products, cities, guides };
export function getStaticPaths() {
  return [
    ...services.map((page) => ({ params: { lang: 'en', section: 'services', slug: page.slug }, props: { page, section: 'services' } })),
    ...products.map((page) => ({ params: { lang: 'en', section: 'products', slug: page.slug }, props: { page, section: 'products' } })),
    ...cities.map((page) => ({ params: { lang: 'en', section: 'cities', slug: page.slug }, props: { page, section: 'cities' } })),
    ...guides.map((page) => ({ params: { lang: 'en', section: 'guides', slug: page.slug }, props: { page, section: 'guides' } })),
  ];
}
const { page, section } = Astro.props;
const sectionLabel = section === 'services' ? 'Sourcing services' : section === 'products' ? 'Product sourcing' : section === 'cities' ? 'China manufacturing cities' : 'China sourcing education';
const relatedPages = page.related.map((slug: string) => allKnowledge.find((item) => item.slug === slug)).filter(Boolean);
---
<Layout title={`${page.title} | Sourcing Ally`} description={page.summary} lang="en">
  <section class="knowledge-hero section-pad"><div class="container knowledge-wrap"><a class="back-link" href={`/en/${section}/`}>← {sectionLabel}</a><p class="eyebrow">{sectionLabel}</p><h1>{page.title}</h1><p class="knowledge-intro">{page.intro}</p></div></section>
  <section class="section-pad section-light"><div class="container knowledge-layout"><article class="knowledge-body">{page.sections.map((item: {heading:string;body:string}) => <section><h2>{item.heading}</h2><p>{item.body}</p></section>)}<section class="notice"><strong>Important note</strong><p>Information on this page is general education, not legal, customs, tax, testing, or professional compliance advice. Requirements depend on the product and destination market and should be checked before you order or sell.</p></section></article><aside class="knowledge-aside"><div class="aside-card"><p class="eyebrow">Questions buyers ask</p>{page.questions.map((question: string) => <p class="question">{question}</p>)}</div><div class="aside-card"><p class="eyebrow">Need help in China?</p><p>Sourcing Ally is based in Shenzhen. When a client orders through Sourcing Ally, the minimum sourcing service fee is 5%. Independent factory-travel support is available at $150 per day when the client does not order through Sourcing Ally.</p><a class="button" href="/en/#contact">Contact Sourcing Ally ↗</a></div></aside></div></section>
  {relatedPages.length > 0 && <section class="section-pad related-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Continue learning</p><h2>Related topics</h2></div><p>Build a clearer sourcing plan by connecting the right questions, services, and locations.</p></div><div class="related-grid">{relatedPages.slice(0,4).map((item) => <a class="related-card" href={`/en/${sectionMap.services.includes(item!) ? 'services' : sectionMap.products.includes(item!) ? 'products' : sectionMap.cities.includes(item!) ? 'cities' : 'guides'}/${item!.slug}/`}><span>{item!.shortTitle}</span><b>{item!.title}</b><small>Read guide ↗</small></a>)}</div></div></section>}
</Layout>
<style>.knowledge-wrap{max-width:900px}.back-link{display:inline-block;color:var(--blue);font-size:.84rem;font-weight:700;margin-bottom:62px}.knowledge-hero h1{font-size:clamp(2.8rem,6vw,5.6rem);line-height:1;letter-spacing:-.07em;max-width:900px;margin:0 0 24px}.knowledge-intro{font-size:1.22rem;line-height:1.7;color:var(--muted);max-width:750px}.knowledge-layout{display:grid;grid-template-columns:1.35fr .65fr;gap:75px}.knowledge-body section{margin-bottom:45px}.knowledge-body h2{font-size:1.85rem;letter-spacing:-.045em;margin:0 0 12px}.knowledge-body p{font-size:1.02rem;line-height:1.85;color:#405069;margin:0}.knowledge-aside{display:flex;flex-direction:column;gap:18px}.aside-card{background:white;border:1px solid var(--line);border-radius:var(--radius);padding:25px}.aside-card p:not(.eyebrow){font-size:.88rem;color:var(--muted);line-height:1.7}.aside-card .button{margin-top:12px;font-size:.8rem}.question{padding:13px 0;border-top:1px solid var(--line);margin:0!important;color:var(--ink)!important;font-weight:650}.notice{border-left:4px solid var(--yellow);background:#fff9e7;padding:20px 24px}.notice p{font-size:.87rem}.related-section{background:white}.related-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.related-card{border:1px solid var(--line);border-radius:var(--radius);padding:22px;min-height:200px;display:flex;flex-direction:column;transition:.2s}.related-card:hover{border-color:var(--blue);transform:translateY(-3px)}.related-card span{color:var(--red);font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;font-weight:750}.related-card b{margin-top:18px;font-size:1.05rem;line-height:1.2}.related-card small{margin-top:auto;color:var(--blue);font-weight:700}@media(max-width:850px){.knowledge-layout{grid-template-columns:1fr;gap:35px}.related-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:540px){.related-grid{grid-template-columns:1fr}}</style>
