---
import Layout from '../../../layouts/Layout.astro';
import { allKnowledge, services, products, cities, guides } from '../../../data/site-data';
import { knowledgeLibraryLocales } from '../../../data/knowledge-library-locales';
import generatedKnowledgeLibraryTranslations from '../../../data/generatedKnowledgeLibraryTranslations.json';

const sectionMap = { services, products, cities, guides };
export function getStaticPaths() {
  return ['en','es','pt','ru','tr','fr','ja','de','ar','id','it'].flatMap((lang) => [
    ...services.map((page) => ({ params: { lang, section: 'services', slug: page.slug }, props: { section: 'services', slug: page.slug, lang } })),
    ...products.map((page) => ({ params: { lang, section: 'products', slug: page.slug }, props: { section: 'products', slug: page.slug, lang } })),
    ...cities.map((page) => ({ params: { lang, section: 'cities', slug: page.slug }, props: { section: 'cities', slug: page.slug, lang } })),
    ...guides.map((page) => ({ params: { lang, section: 'guides', slug: page.slug }, props: { section: 'guides', slug: page.slug, lang } })),
  ]);
}
const { slug, section, lang } = Astro.props;
const sourcePages = sectionMap[section as keyof typeof sectionMap];
const sourcePage = sourcePages.find((item) => item.slug === slug);
if (!sourcePage) throw new Error(`Unknown knowledge page: ${section}/${slug}`);
const localizedPage = lang === 'en' ? undefined : knowledgeLibraryLocales[lang as keyof typeof knowledgeLibraryLocales]?.[section as 'services'|'products'|'cities'|'guides']?.find((item) => item.slug === slug);
const generatedKnowledge = generatedKnowledgeLibraryTranslations as Partial<Record<string, Record<string, string>>>;
const localizeGeneratedPage = <T extends typeof sourcePage>(source: T, dictionary?: Record<string, string>) => !dictionary ? source : ({
  ...source,
  shortTitle: dictionary[source.shortTitle] ?? source.shortTitle,
  title: dictionary[source.title] ?? source.title,
  summary: dictionary[source.summary] ?? source.summary,
  intro: dictionary[source.intro] ?? source.intro,
  sections: source.sections.map((item) => ({ heading: dictionary[item.heading] ?? item.heading, body: dictionary[item.body] ?? item.body })),
  questions: source.questions.map((question) => dictionary[question] ?? question),
});
const page = localizedPage ? {...sourcePage, ...localizedPage, related: sourcePage.related} : localizeGeneratedPage(sourcePage, generatedKnowledge[lang]);
const localHref = (href: string) => href.replace(/^\/en(?=\/|$)/, `/${lang}`);
const sectionLabel = section === 'services' ? 'Sourcing services' : section === 'products' ? 'Product sourcing' : section === 'cities' ? 'China manufacturing cities' : 'China sourcing education';
const relatedPages = page.related.map((relatedSlug: string) => {
  const sourceRelated = allKnowledge.find((item) => item.slug === relatedSlug);
  if (!sourceRelated) return undefined;
  const relatedSection = sectionMap.services.includes(sourceRelated) ? 'services' : sectionMap.products.includes(sourceRelated) ? 'products' : sectionMap.cities.includes(sourceRelated) ? 'cities' : 'guides';
  const translatedRelated = lang === 'en' ? undefined : knowledgeLibraryLocales[lang as keyof typeof knowledgeLibraryLocales]?.[relatedSection]?.find((item) => item.slug === relatedSlug);
  return { item: translatedRelated ? {...sourceRelated, ...translatedRelated, related: sourceRelated.related} : localizeGeneratedPage(sourceRelated, generatedKnowledge[lang]), section: relatedSection };
}).filter(Boolean);
const preparation = section === 'services' ? 'Prepare the product brief, target quantity, destination market, timing, budget assumptions, and the specific decision you need help making.' : section === 'products' ? 'Start with the intended use, target buyer, materials, dimensions, expected quantity, packaging, destination market, and any existing reference sample.' : section === 'cities' ? 'Confirm the exact product process, supplier addresses, number of meetings, travel timing, and what evidence you need from each visit.' : 'Use this guide as a planning framework. Write down your assumptions, open questions, responsible parties, and the next decision before contacting a supplier.';
const nextStep = section === 'services' ? 'After the scope is clear, the next step is a written brief and a practical conversation about what Sourcing Ally should handle.' : section === 'products' ? 'After reviewing the category, connect the product requirements to supplier research, sample review, quality control, packaging, and destination-market checks.' : section === 'cities' ? 'After choosing a region, build a supplier shortlist and itinerary around actual factory addresses rather than relying only on a city label.' : 'After learning the framework, apply it to one real product and one real destination market; the details should be checked before money or production is committed.';
const deepConnections = section === 'services' ? [{label:'Choose your buyer path',href:'/en/paths/',note:'Start with the sourcing situation you are actually facing.'},{label:'Ask a sourcing question',href:'/en/questions/',note:'Find direct answers before deciding what local support is useful.'},{label:'Build a project brief',href:'/en/start-project/',note:'Turn your product and timing into a clearer first message.'}] : section === 'products' ? [{label:'Find the right buyer path',href:'/en/paths/',note:'Match the product project to a practical sourcing route.'},{label:'Explore supplier research',href:'/en/services/supplier-sourcing/',note:'Connect the category to consistent supplier questions.'},{label:'Check China sourcing cities',href:'/en/cities/',note:'Understand the city and factory-travel questions behind a category.'}] : section === 'cities' ? [{label:'Open the China Route Map',href:'/en/china-route/',note:'Connect the city to an actual sourcing question and visit purpose.'},{label:'Plan a China visit',href:'/en/paths/china-visit/',note:'Build a useful route around decisions—not sightseeing.'},{label:'Use the Project Brief Builder',href:'/en/start-project/',note:'Prepare supplier addresses, product details, timing, and questions.'}] : [{label:'Ask a sourcing question',href:'/en/questions/',note:'Find direct answers before you apply this framework to a project.'},{label:'Choose your buyer path',href:'/en/paths/',note:'Move from education to the right sourcing route.'},{label:'Build a project brief',href:'/en/start-project/',note:'Turn the learning into a clear next message.'}];
const officialSources = page.slug === 'shipping-from-china' ? [{label:'ICC Incoterms® 2020',href:'https://iccwbo.org/business-solutions/incoterms-rules/incoterms-2020/',note:'Official resource for international trade terms.'},{label:'International Trade Administration: Know Your Incoterms',href:'https://www.trade.gov/know-your-incoterms',note:'Government trade-education resource on responsibilities in international shipments.'}] : [];
---
<Layout title={`${page.title} | Sourcing Ally`} description={page.summary} lang={lang} noindex={lang !== 'en'}>
  <section class="knowledge-hero section-pad"><div class="container knowledge-wrap"><a class:list={['back-link',lang !== 'en' && 'locale-source-only']} href={`/${lang}/${section}/`}>← {sectionLabel}</a><p class:list={['eyebrow',lang !== 'en' && 'locale-source-only']}>{sectionLabel}</p><h1>{page.title}</h1><p class="knowledge-intro">{page.intro}</p></div></section>
  <section class="section-pad section-light"><div class="container knowledge-layout"><article class="knowledge-body">{page.sections.map((item: {heading:string;body:string}) => <section><h2>{item.heading}</h2><p>{item.body}</p></section>)}<section class:list={lang !== 'en' && 'locale-source-only'}><h2>Before you begin</h2><p>{preparation}</p></section><section class:list={lang !== 'en' && 'locale-source-only'}><h2>A useful decision checklist</h2><ol class="decision-list">{page.questions.map((question: string) => <li>{question}</li>)}</ol></section><section class:list={lang !== 'en' && 'locale-source-only'}><h2>What to do next</h2><p>{nextStep}</p></section><section class:list={['connected-knowledge',lang !== 'en' && 'locale-source-only']}><p class="eyebrow">Connect the next decision</p><h2>Use this page as part of a clearer sourcing plan.</h2><div class="connection-grid">{deepConnections.map((link,index)=><a href={localHref(link.href)}><span>0{index+1}</span><b>{link.label}</b><p>{link.note}</p><i>↗</i></a>)}</div></section>{officialSources.length > 0 && <section class:list={['authority-box',lang !== 'en' && 'locale-source-only']}><p class="eyebrow">Official resources</p><h2>Further reading for current trade-term questions.</h2><p>These sources are provided for educational context. They do not replace advice for your product, destination, transaction, or import role.</p><ul>{officialSources.map(source=><li><a href={source.href} target="_blank" rel="noreferrer"><b>{source.label}</b><span>{source.note}</span> ↗</a></li>)}</ul></section>}<section class:list={['notice',lang !== 'en' && 'locale-source-only']}><strong>Important note</strong><p>Information on this page is general education, not legal, customs, tax, testing, or professional compliance advice. Requirements depend on the product and destination market and should be checked before you order or sell.</p></section></article><aside class:list={['knowledge-aside',lang !== 'en' && 'locale-source-only']}><div class="aside-card"><p class="eyebrow">Questions buyers ask</p>{page.questions.map((question: string) => <p class="question">{question}</p>)}</div><div class="aside-card"><p class="eyebrow">Need help in China?</p><p>Sourcing Ally is based in Shenzhen. When a client orders through Sourcing Ally, the minimum sourcing service fee is 5%. Independent factory-travel support is available at $150 per day when the client does not order through Sourcing Ally.</p><a class="button" href={`/${lang}/#contact`}>Contact Sourcing Ally ↗</a></div></aside></div></section>
  {relatedPages.length > 0 && <section class="section-pad related-section"><div class="container"><div class:list={['section-heading',lang !== 'en' && 'locale-source-only']}><div><p class="eyebrow">Continue learning</p><h2>Related topics</h2></div><p>Build a clearer sourcing plan by connecting the right questions, services, and locations.</p></div><div class="related-grid">{relatedPages.slice(0,4).map((related) => <a class="related-card" href={`/${lang}/${related.section}/${related.item.slug}/`}><span>{related.item.shortTitle}</span><b>{related.item.title}</b><small>{lang === 'en' ? 'Read guide ↗' : '↗'}</small></a>)}</div></div></section>}
</Layout>
<style>.knowledge-wrap{max-width:900px}.back-link{display:inline-block;color:var(--blue);font-size:.84rem;font-weight:700;margin-bottom:62px}.knowledge-hero h1{font-size:clamp(2.8rem,6vw,5.6rem);line-height:1;letter-spacing:-.07em;max-width:900px;margin:0 0 24px}.knowledge-intro{font-size:1.22rem;line-height:1.7;color:var(--muted);max-width:750px}.knowledge-layout{display:grid;grid-template-columns:1.35fr .65fr;gap:75px}.knowledge-body section{margin-bottom:45px}.knowledge-body h2{font-size:1.85rem;letter-spacing:-.045em;margin:0 0 12px}.knowledge-body p{font-size:1.02rem;line-height:1.85;color:#405069;margin:0}.decision-list{margin:0;padding:0;list-style:none;counter-reset:decision}.decision-list li{counter-increment:decision;display:flex;gap:13px;align-items:flex-start;border-top:1px solid var(--line);padding:14px 0;color:#405069;font-size:.96rem}.decision-list li:before{content:counter(decision,decimal-leading-zero);color:var(--electric,var(--blue));font-size:.72rem;font-weight:800;letter-spacing:.1em;padding-top:3px}.knowledge-aside{display:flex;flex-direction:column;gap:18px}.aside-card{background:white;border:1px solid var(--line);border-radius:var(--radius);padding:25px}.aside-card p:not(.eyebrow){font-size:.88rem;color:var(--muted);line-height:1.7}.aside-card .button{margin-top:12px;font-size:.8rem}.question{padding:13px 0;border-top:1px solid var(--line);margin:0!important;color:var(--ink)!important;font-weight:650}.connected-knowledge{padding-top:5px}.connected-knowledge h2,.authority-box h2{font-size:1.65rem}.connection-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:19px}.connection-grid a{min-height:164px;border:1px solid var(--line);border-radius:12px;padding:17px;background:#fff;display:flex;flex-direction:column;transition:.2s}.connection-grid a:hover{border-color:var(--blue);box-shadow:6px 8px 0 rgba(40,103,217,.1);transform:translateY(-3px)}.connection-grid span{font-size:.65rem;color:var(--red);font-weight:800}.connection-grid b{color:var(--ink);font-size:.9rem;line-height:1.2;margin:14px 0 7px}.connection-grid p{font-size:.76rem;line-height:1.55;margin:0}.connection-grid i{color:var(--blue);font-style:normal;margin-top:auto}.authority-box{background:#eef4fb;border-radius:12px;padding:22px}.authority-box>p:not(.eyebrow){font-size:.87rem;line-height:1.65}.authority-box ul{list-style:none;padding:0}.authority-box li{margin:9px 0}.authority-box a{font-size:.84rem;color:var(--blue);line-height:1.55}.authority-box a span{font-size:.78rem;color:var(--muted)}.notice{border-left:4px solid var(--yellow);background:#fff9e7;padding:20px 24px}.notice p{font-size:.87rem}.related-section{background:white}.related-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.related-card{border:1px solid var(--line);border-radius:var(--radius);padding:22px;min-height:200px;display:flex;flex-direction:column;transition:.2s}.related-card:hover{border-color:var(--blue);transform:translateY(-3px)}.related-card span{color:var(--red);font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;font-weight:750}.related-card b{margin-top:18px;font-size:1.05rem;line-height:1.2}.related-card small{margin-top:auto;color:var(--blue);font-weight:700}@media(max-width:850px){.knowledge-layout{grid-template-columns:1fr;gap:35px}.related-grid{grid-template-columns:repeat(2,1fr)}.connection-grid{grid-template-columns:1fr}}@media(max-width:540px){.related-grid{grid-template-columns:1fr}}.locale-source-only{display:none!important}</style>
