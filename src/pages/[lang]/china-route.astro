---
import Layout from '../../layouts/Layout.astro';
export function getStaticPaths(){return ['en','es','pt','ru','tr'].map(lang=>({params:{lang}}))}
const cities=[
 {name:'Shenzhen', code:'SZ', x:65, y:64, text:'Electronics, components, product development, and a Shenzhen base for Sourcing Ally.', href:'/en/cities/shenzhen/'},
 {name:'Dongguan', code:'DG', x:51, y:53, text:'Manufacturing questions and factory-visit planning in the Pearl River Delta.', href:'/en/cities/dongguan/'},
 {name:'Guangzhou', code:'GZ', x:33, y:43, text:'Markets, trade shows, apparel questions, and supplier-meeting routes.', href:'/en/cities/guangzhou/'},
 {name:'Foshan', code:'FS', x:23, y:56, text:'Furniture, lighting, and building-product sourcing questions.', href:'/en/cities/foshan/'},
 {name:'Zhongshan', code:'ZS', x:43, y:76, text:'Lighting and appliance supply-chain questions.', href:'/en/cities/zhongshan/'},
 {name:'Huizhou', code:'HZ', x:80, y:43, text:'Electronics and nearby manufacturing questions.', href:'/en/cities/huizhou/'},
 {name:'Yiwu', code:'YW', x:52, y:16, text:'Wholesale-market planning and supplier-discovery questions.', href:'/en/cities/yiwu/'},
 {name:'Ningbo', code:'NB', x:69, y:18, text:'Port, manufacturing, and export-planning questions.', href:'/en/cities/ningbo/'},
 {name:'Shanghai', code:'SH', x:83, y:12, text:'Meetings, trade shows, and supply-chain planning.', href:'/en/cities/shanghai/'}
];
---
<Layout title="China Sourcing Route Map | Sourcing Ally" description="Use an interactive planning map to connect China manufacturing cities, supplier visits, market research, and sourcing questions." lang="en">
<section class="route-map-hero"><div class="container map-hero-grid"><div><a class="back-link" href="/en/cities/">← China cities</a><p class="eyebrow">China sourcing route map</p><h1>Plan the question before you plan the trip.</h1><p>A city name is not a sourcing plan. Use this map to connect the product or supplier question to the right type of visit, realistic route, and next action.</p><a class="button" href="#map">Explore the route map ↓</a></div><aside><span>SA / FIELD ROUTES</span><strong>REGION<br/>TO<br/>DECISION</strong><p>Markets, factories, trade shows, and supplier meetings serve different purposes.</p></aside></div></section>
<section id="map" class="map-workspace section-pad"><div class="container"><div class="map-heading"><div><p class="eyebrow">Interactive planning layer</p><h2>Click a city. See the sourcing question it can help you explore.</h2></div><p>This is a planning guide, not a claim that a particular supplier is suitable or that every product in a category is made in one location.</p></div><div class="map-layout"><div class="china-map"><div class="map-grid"></div><svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M52 16 L69 18 L83 12"/><path d="M33 43 L51 53 L65 64"/><path d="M23 56 L43 76 L65 64"/><path d="M51 53 L80 43 L65 64"/></svg>{cities.map(city=><button class="map-city" style={`--x:${city.x}%;--y:${city.y}%`} data-city={city.name} data-text={city.text} data-href={city.href}><span>{city.code}</span><b>{city.name}</b></button>)}</div><div class="map-detail" id="map-detail"><p class="eyebrow">Select a point</p><h3>Start with a sourcing question.</h3><p>Choose a city point to see what the related guide can help you plan.</p><a class="button button-outline" href="/en/cities/">Explore all city guides ↗</a></div></div></div></section>
<section class="route-map-process section-pad"><div class="container"><div><p class="eyebrow">A better visit framework</p><h2>Every stop should produce a useful answer.</h2></div><div class="visit-sequence"><article><span>01</span><h3>Define the purpose</h3><p>Product discovery, factory verification, sample review, production discussion, or market research?</p></article><article><span>02</span><h3>Confirm the location</h3><p>Use the actual supplier or market address, realistic travel time, and a visible contact plan.</p></article><article><span>03</span><h3>Prepare the evidence</h3><p>Bring the product brief, samples, questions, photo list, and follow-up template.</p></article><article><span>04</span><h3>Record the decision</h3><p>Turn observations into a written next step rather than relying on an impression.</p></article></div></div></section>
<section class="route-map-close"><div class="container close-map-grid"><div><p class="eyebrow">Planning a trip?</p><h2>Create a supplier-visit brief before you book the route.</h2></div><p>Sourcing Ally is based in Shenzhen. Nearby Guangdong locations can be discussed for an agreed project, while farther China travel should be planned around real addresses and decision goals.</p><a class="button" href="/en/start-project/">Build your project brief ↗</a></div></section>
</Layout>
<script>
  const detail = document.querySelector('#map-detail');
  document.querySelectorAll('.map-city').forEach((button) => button.addEventListener('click', () => {
    document.querySelectorAll('.map-city').forEach(el => el.classList.remove('is-selected'));
    button.classList.add('is-selected');
    detail.innerHTML = `<p class="eyebrow">${button.dataset.city} / CITY GUIDE</p><h3>${button.dataset.city}</h3><p>${button.dataset.text}</p><a class="button" href="${button.dataset.href}">Open ${button.dataset.city} guide ↗</a>`;
  }));
</script>
<style>.route-map-hero{background:#f4f8ff;padding:88px 0 102px;position:relative;overflow:hidden}.route-map-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.map-hero-grid{position:relative;display:grid;grid-template-columns:1fr .45fr;gap:80px;align-items:end}.back-link{display:inline-block;color:var(--blue);font-size:.84rem;font-weight:750;margin-bottom:40px}.route-map-hero h1{font-size:clamp(3.1rem,6.2vw,6.05rem);letter-spacing:-.08em;line-height:.96;margin:0 0 20px;max-width:850px}.route-map-hero p:not(.eyebrow){color:#405069;line-height:1.8;font-size:1.1rem;max-width:670px;margin:0 0 30px}.map-hero-grid aside{background:var(--coral);padding:25px;min-height:340px;color:#fff;box-shadow:17px 17px 0 rgba(40,103,217,.12);position:relative;overflow:hidden}.map-hero-grid aside:before{content:"";position:absolute;width:300px;height:300px;border:1px solid rgba(255,255,255,.35);border-radius:50%;right:-100px;bottom:-125px}.map-hero-grid aside>*{position:relative;z-index:2}.map-hero-grid aside span{font-size:.65rem;letter-spacing:.14em;font-weight:800}.map-hero-grid aside strong{display:block;font-size:2.5rem;letter-spacing:-.08em;line-height:.82;margin:42px 0 20px}.map-hero-grid aside p{color:#fff!important;font-size:.84rem!important}.map-workspace{background:#fff}.map-heading{display:grid;grid-template-columns:1fr .8fr;gap:70px;align-items:end;margin-bottom:37px}.map-heading h2{font-size:clamp(2.25rem,4.3vw,4.45rem);line-height:1;letter-spacing:-.07em;margin:0}.map-heading>p{line-height:1.75;color:var(--muted);margin:0}.map-layout{display:grid;grid-template-columns:1.3fr .6fr;gap:20px}.china-map{min-height:580px;position:relative;background:var(--ink);overflow:hidden;border-radius:18px;box-shadow:15px 17px 0 rgba(247,201,72,.52)}.map-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.07) 1px,transparent 1px);background-size:42px 42px}.china-map svg{position:absolute;inset:8%;width:84%;height:84%;stroke:rgba(247,201,72,.68);stroke-width:.6;fill:none}.map-city{position:absolute;left:var(--x);top:var(--y);transform:translate(-50%,-50%);background:transparent;border:0;color:#fff;text-align:left;cursor:pointer;padding:0;display:flex;align-items:center;gap:8px}.map-city span{display:grid;place-items:center;width:36px;height:36px;background:var(--gold);border-radius:50%;color:var(--ink);font-size:.65rem;font-weight:800;box-shadow:0 0 0 0 rgba(247,201,72,.32);transition:.25s}.map-city b{font-size:.75rem;white-space:nowrap}.map-city:hover span,.map-city.is-selected span{box-shadow:0 0 0 9px rgba(247,201,72,.18);transform:scale(1.12)}.map-city.is-selected b{color:var(--gold)}.map-detail{background:#eef4fb;border-radius:18px;padding:28px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.map-detail h3{font-size:2.15rem;letter-spacing:-.06em;line-height:1;margin:0 0 15px}.map-detail p:not(.eyebrow){color:#405069;line-height:1.8;margin:0 0 25px}.button-outline{background:white;color:var(--blue);border:1px solid var(--blue)}.route-map-process{background:#eef4fb}.route-map-process h2{font-size:clamp(2.4rem,4.7vw,4.8rem);line-height:1;letter-spacing:-.07em;max-width:800px;margin:0 0 42px}.visit-sequence{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.visit-sequence article{background:white;border:1px solid var(--line);padding:23px;border-radius:15px}.visit-sequence span{color:var(--coral);font-size:.7rem;font-weight:800}.visit-sequence h3{font-size:1.25rem;letter-spacing:-.04em;margin:22px 0 8px}.visit-sequence p{color:var(--muted);line-height:1.65;font-size:.86rem;margin:0}.route-map-close{background:var(--ink);color:#fff;padding:75px 0}.close-map-grid{display:grid;grid-template-columns:1.1fr .8fr auto;gap:45px;align-items:end}.close-map-grid .eyebrow{color:var(--gold)}.close-map-grid h2{font-size:clamp(2.2rem,4vw,4rem);line-height:1.02;letter-spacing:-.06em;margin:0}.close-map-grid>p{color:#cbd8e8;line-height:1.75;margin:0}@media(max-width:850px){.map-hero-grid,.map-heading,.map-layout{grid-template-columns:1fr;gap:38px}.map-hero-grid aside{max-width:340px}.visit-sequence{grid-template-columns:repeat(2,1fr)}.close-map-grid{grid-template-columns:1fr;align-items:start;gap:22px}}@media(max-width:560px){.route-map-hero{padding:70px 0 80px}.route-map-hero h1{font-size:3rem}.china-map{min-height:460px}.map-city b{display:none}.visit-sequence{grid-template-columns:1fr}.map-heading{gap:20px}}</style>
