import Layout from '../../layouts/Layout.astro';
export function getStaticPaths(){return ['en','es','pt','ru','tr','fr','ja','de','ar','id','it'].map(lang=>({params:{lang}}))}
const lang=Astro.params.lang || 'en';
const locales={
 en:{title:'China Sourcing Route Map | Sourcing Ally',desc:'Use an interactive planning map to connect China manufacturing cities, supplier visits, market research, and sourcing questions.',back:'← China cities',eyebrow:'China sourcing route map',hero:'Plan the question before you plan the trip.',intro:'A city name is not a sourcing plan. Use this map to connect the product or supplier question to the right type of visit, realistic route, and next action.',explore:'Explore the route map ↓',side:'REGION\nTO\nDECISION',sideCopy:'Markets, factories, trade shows, and supplier meetings serve different purposes.',layer:'Interactive planning layer',mapTitle:'Click a city. See the sourcing question it can help you explore.',mapCopy:'This is a planning guide, not a claim that a particular supplier is suitable or that every product in a category is made in one location.',select:'Select a point',selectTitle:'Start with a sourcing question.',selectCopy:'Choose a city point to see what the related guide can help you plan.',allCities:'Explore all city guides ↗',notice:'Detailed city guides remain English source pages while reviewed translations are prepared.',framework:'A better visit framework',frameworkTitle:'Every stop should produce a useful answer.',steps:[['Define the purpose','Product discovery, factory verification, sample review, production discussion, or market research?'],['Confirm the location','Use the actual supplier or market address, realistic travel time, and a visible contact plan.'],['Prepare the evidence','Bring the product brief, samples, questions, photo list, and follow-up template.'],['Record the decision','Turn observations into a written next step rather than relying on an impression.']],planning:'Planning a trip?',close:'Create a supplier-visit brief before you book the route.',closeCopy:'Sourcing Ally is based in Shenzhen. Nearby Guangdong locations can be discussed for an agreed project, while farther China travel should be planned around real addresses and decision goals.',brief:'Build your project brief ↗',guide:'Open guide ↗',cities:['Electronics, components, product development, and a Shenzhen base for Sourcing Ally.','Manufacturing questions and factory-visit planning in the Pearl River Delta.','Markets, trade shows, apparel questions, and supplier-meeting routes.','Furniture, lighting, and building-product sourcing questions.','Lighting and appliance supply-chain questions.','Electronics and nearby manufacturing questions.','Wholesale-market planning and supplier-discovery questions.','Port, manufacturing, and export-planning questions.','Meetings, trade shows, and supply-chain planning.']},
 es:{title:'Mapa de rutas de compras en China | Sourcing Ally',desc:'Use un mapa interactivo para conectar ciudades manufactureras de China, visitas a proveedores, investigación de mercados y preguntas de compras.',back:'← Ciudades de China',eyebrow:'Mapa de rutas de compras en China',hero:'Planifique la pregunta antes de planificar el viaje.',intro:'El nombre de una ciudad no es un plan de compras. Use este mapa para relacionar la pregunta sobre producto o proveedor con el tipo de visita, ruta realista y siguiente acción adecuados.',explore:'Explorar el mapa de rutas ↓',side:'REGIÓN\nA\nDECISIÓN',sideCopy:'Los mercados, fábricas, ferias y reuniones con proveedores tienen objetivos diferentes.',layer:'Capa de planificación interactiva',mapTitle:'Haga clic en una ciudad. Vea la pregunta de compras que puede explorar.',mapCopy:'Esta es una guía de planificación, no una afirmación de que un proveedor concreto sea adecuado ni de que todos los productos de una categoría se fabriquen en un solo lugar.',select:'Seleccione un punto',selectTitle:'Empiece por una pregunta de compras.',selectCopy:'Elija una ciudad para ver qué puede ayudarle a planificar la guía relacionada.',allCities:'Explorar todas las guías de ciudades ↗',notice:'Las guías detalladas de ciudades siguen siendo páginas fuente en inglés mientras se preparan traducciones revisadas.',framework:'Un mejor marco para las visitas',frameworkTitle:'Cada parada debe producir una respuesta útil.',steps:[['Defina el propósito','¿Descubrir productos, verificar una fábrica, revisar muestras, hablar de producción o investigar un mercado?'],['Confirme la ubicación','Use la dirección real del proveedor o mercado, tiempo de viaje realista y un plan de contacto visible.'],['Prepare la evidencia','Lleve el briefing de producto, muestras, preguntas, lista de fotos y plantilla de seguimiento.'],['Registre la decisión','Convierta las observaciones en un siguiente paso escrito en lugar de depender de una impresión.']],planning:'¿Está planeando un viaje?',close:'Cree un briefing de visita a proveedor antes de reservar la ruta.',closeCopy:'Sourcing Ally tiene su base en Shenzhen. Se pueden comentar ubicaciones cercanas de Guangdong para un proyecto acordado, mientras que los viajes a zonas más lejanas de China deben planificarse con direcciones reales y objetivos de decisión.',brief:'Crear su briefing de proyecto ↗',guide:'Abrir guía ↗',cities:['Electrónica, componentes, desarrollo de productos y base de Sourcing Ally en Shenzhen.','Preguntas de fabricación y planificación de visitas a fábricas en el delta del río Perla.','Mercados, ferias, ropa y rutas para reuniones con proveedores.','Preguntas sobre compras de muebles, iluminación y productos de construcción.','Preguntas sobre cadenas de suministro de iluminación y electrodomésticos.','Preguntas sobre electrónica y fabricación cercana.','Planificación de mercados mayoristas y búsqueda de proveedores.','Preguntas sobre puerto, fabricación y planificación de exportación.','Reuniones, ferias y planificación de cadena de suministro.']},
 pt:{title:'Mapa de rotas de sourcing na China | Sourcing Ally',desc:'Use um mapa interativo para conectar cidades manufatureiras da China, visitas a fornecedores, pesquisa de mercado e perguntas de sourcing.',back:'← Cidades da China',eyebrow:'Mapa de rotas de sourcing na China',hero:'Planeje a pergunta antes de planejar a viagem.',intro:'O nome de uma cidade não é um plano de sourcing. Use este mapa para conectar a pergunta sobre produto ou fornecedor ao tipo certo de visita, rota realista e próxima ação.',explore:'Explorar o mapa de rotas ↓',side:'REGIÃO\nPARA\nDECISÃO',sideCopy:'Mercados, fábricas, feiras e reuniões com fornecedores têm finalidades diferentes.',layer:'Camada de planejamento interativa',mapTitle:'Clique em uma cidade. Veja a pergunta de sourcing que ela pode ajudar a explorar.',mapCopy:'Este é um guia de planejamento, não uma afirmação de que determinado fornecedor seja adequado ou de que todos os produtos de uma categoria sejam fabricados em um lugar.',select:'Selecione um ponto',selectTitle:'Comece com uma pergunta de sourcing.',selectCopy:'Escolha uma cidade para ver o que o guia relacionado pode ajudar você a planejar.',allCities:'Explorar todos os guias de cidades ↗',notice:'Guias detalhados de cidades permanecem páginas-fonte em inglês enquanto traduções revisadas são preparadas.',framework:'Uma estrutura melhor para visitas',frameworkTitle:'Cada parada deve produzir uma resposta útil.',steps:[['Defina o objetivo','Descoberta de produto, verificação de fábrica, revisão de amostra, discussão de produção ou pesquisa de mercado?'],['Confirme o local','Use o endereço real do fornecedor ou mercado, tempo de viagem realista e um plano de contato visível.'],['Prepare as evidências','Leve o briefing do produto, amostras, perguntas, lista de fotos e modelo de acompanhamento.'],['Registre a decisão','Transforme observações em um próximo passo escrito em vez de depender de uma impressão.']],planning:'Planejando uma viagem?',close:'Crie um briefing de visita ao fornecedor antes de reservar a rota.',closeCopy:'A Sourcing Ally está baseada em Shenzhen. Locais próximos em Guangdong podem ser discutidos para um projeto acordado, enquanto viagens mais distantes na China devem ser planejadas com endereços reais e objetivos de decisão.',brief:'Criar seu briefing de projeto ↗',guide:'Abrir guia ↗',cities:['Eletrônicos, componentes, desenvolvimento de produto e base da Sourcing Ally em Shenzhen.','Questões de fabricação e planejamento de visitas a fábricas no Delta do Rio das Pérolas.','Mercados, feiras, vestuário e rotas para reuniões com fornecedores.','Questões de sourcing de móveis, iluminação e produtos de construção.','Questões da cadeia de suprimentos de iluminação e eletrodomésticos.','Questões de eletrônicos e fabricação próxima.','Planejamento de mercado atacadista e descoberta de fornecedores.','Questões de porto, fabricação e planejamento de exportação.','Reuniões, feiras e planejamento da cadeia de suprimentos.']},
 ru:{title:'Карта маршрутов закупок в Китае | Sourcing Ally',desc:'Используйте интерактивную карту для связи промышленных городов Китая, визитов к поставщикам, исследования рынков и вопросов по закупкам.',back:'← Города Китая',eyebrow:'Карта маршрутов закупок в Китае',hero:'Спланируйте вопрос до планирования поездки.',intro:'Название города — не план закупок. Используйте карту, чтобы связать вопрос о товаре или поставщике с подходящим типом визита, реалистичным маршрутом и следующим действием.',explore:'Открыть карту маршрутов ↓',side:'РЕГИОН\nК\nРЕШЕНИЮ',sideCopy:'Рынки, фабрики, выставки и встречи с поставщиками выполняют разные задачи.',layer:'Интерактивный слой планирования',mapTitle:'Нажмите на город. Посмотрите, какой вопрос по закупкам он поможет изучить.',mapCopy:'Это руководство по планированию, а не утверждение, что конкретный поставщик подходит или что все товары категории производятся в одном месте.',select:'Выберите точку',selectTitle:'Начните с вопроса по закупкам.',selectCopy:'Выберите город, чтобы увидеть, что соответствующее руководство поможет спланировать.',allCities:'Открыть все гиды по городам ↗',notice:'Подробные гиды по городам пока остаются английскими исходными страницами, пока готовятся проверенные переводы.',framework:'Более полезная структура визита',frameworkTitle:'Каждая остановка должна давать полезный ответ.',steps:[['Определите цель','Поиск товара, проверка фабрики, анализ образца, обсуждение производства или исследование рынка?'],['Подтвердите место','Используйте реальный адрес поставщика или рынка, реалистичное время в пути и видимый план контакта.'],['Подготовьте доказательства','Возьмите бриф по товару, образцы, вопросы, список фото и шаблон последующих действий.'],['Зафиксируйте решение','Превратите наблюдения в письменный следующий шаг, а не полагайтесь на впечатление.']],planning:'Планируете поездку?',close:'Создайте бриф визита к поставщику до бронирования маршрута.',closeCopy:'Sourcing Ally базируется в Шэньчжэне. Близлежащие места в Гуандуне можно обсудить для согласованного проекта, а поездки в более дальние регионы Китая следует планировать вокруг реальных адресов и целей решения.',brief:'Создать бриф проекта ↗',guide:'Открыть руководство ↗',cities:['Электроника, компоненты, разработка товаров и база Sourcing Ally в Шэньчжэне.','Вопросы производства и планирование визитов на фабрики в дельте Жемчужной реки.','Рынки, выставки, одежда и маршруты встреч с поставщиками.','Вопросы закупок мебели, освещения и строительных товаров.','Вопросы цепочки поставок освещения и бытовой техники.','Вопросы электроники и близлежащего производства.','Планирование оптового рынка и поиск поставщиков.','Вопросы порта, производства и экспортного планирования.','Встречи, выставки и планирование цепочки поставок.']},
 tr:{title:'Çin tedarik rota haritası | Sourcing Ally',desc:'Çin üretim şehirlerini, tedarikçi ziyaretlerini, pazar araştırmasını ve tedarik sorularını bağlamak için etkileşimli bir planlama haritası kullanın.',back:'← Çin şehirleri',eyebrow:'Çin tedarik rota haritası',hero:'Seyahati planlamadan önce soruyu planlayın.',intro:'Bir şehir adı tedarik planı değildir. Ürün veya tedarikçi sorusunu doğru ziyaret türü, gerçekçi rota ve sonraki eylemle ilişkilendirmek için bu haritayı kullanın.',explore:'Rota haritasını keşfedin ↓',side:'BÖLGE\nKARARA\nDÖNÜŞÜR',sideCopy:'Pazarlar, fabrikalar, fuarlar ve tedarikçi toplantıları farklı amaçlara hizmet eder.',layer:'Etkileşimli planlama katmanı',mapTitle:'Bir şehre tıklayın. Keşfetmenize yardımcı olabileceği tedarik sorusunu görün.',mapCopy:'Bu bir planlama rehberidir; belirli bir tedarikçinin uygun olduğu veya kategorideki her ürünün tek yerde üretildiği iddiası değildir.',select:'Bir nokta seçin',selectTitle:'Bir tedarik sorusuyla başlayın.',selectCopy:'İlgili rehberin neyi planlamanıza yardımcı olabileceğini görmek için bir şehir noktası seçin.',allCities:'Tüm şehir rehberlerini keşfedin ↗',notice:'Ayrıntılı şehir rehberleri, incelenmiş çeviriler hazırlanırken İngilizce kaynak sayfalar olarak kalır.',framework:'Ziyaretler için daha iyi bir çerçeve',frameworkTitle:'Her durak faydalı bir yanıt üretmelidir.',steps:[['Amacı belirleyin','Ürün keşfi, fabrika doğrulaması, numune incelemesi, üretim görüşmesi veya pazar araştırması mı?'],['Konumu doğrulayın','Gerçek tedarikçi veya pazar adresini, gerçekçi seyahat süresini ve görünür iletişim planını kullanın.'],['Kanıtı hazırlayın','Ürün özetini, numuneleri, soruları, fotoğraf listesini ve takip şablonunu getirin.'],['Kararı kaydedin','Gözlemleri bir izlenime güvenmek yerine yazılı bir sonraki adıma dönüştürün.']],planning:'Bir seyahat mi planlıyorsunuz?',close:'Rotayı ayırtmadan önce tedarikçi ziyaret özeti oluşturun.',closeCopy:'Sourcing Ally Shenzhen’de bulunur. Yakındaki Guangdong konumları üzerinde anlaşılmış bir proje için görüşülebilir; Çin’in daha uzak bölgelerine seyahat ise gerçek adresler ve karar hedefleri etrafında planlanmalıdır.',brief:'Proje özetinizi oluşturun ↗',guide:'Rehberi aç ↗',cities:['Elektronik, bileşenler, ürün geliştirme ve Sourcing Ally’nin Shenzhen üssü.','İnci Nehri Deltası’nda üretim soruları ve fabrika ziyareti planlaması.','Pazarlar, fuarlar, giyim soruları ve tedarikçi toplantısı rotaları.','Mobilya, aydınlatma ve yapı ürünü tedarik soruları.','Aydınlatma ve ev aletleri tedarik zinciri soruları.','Elektronik ve yakın üretimle ilgili sorular.','Toptan pazar planlaması ve tedarikçi bulma soruları.','Liman, üretim ve ihracat planlama soruları.','Toplantılar, fuarlar ve tedarik zinciri planlaması.']}
};
const fr={title:'Carte des itinéraires de sourcing en Chine | Sourcing Ally',desc:'Utilisez une carte interactive de préparation pour relier les villes industrielles chinoises, les visites fournisseurs, la recherche de marché et vos questions de sourcing.',back:'← Villes de Chine',eyebrow:'Carte des itinéraires de sourcing en Chine',hero:'Préparez la question avant de préparer le voyage.',intro:'Le nom d’une ville ne constitue pas un plan de sourcing. Utilisez cette carte pour relier votre question sur le produit ou le fournisseur au bon type de visite, à un itinéraire réaliste et à la prochaine action.',explore:'Explorer la carte des itinéraires ↓',side:'RÉGION\nVERS\nDÉCISION',sideCopy:'Les marchés, les usines, les salons et les rendez-vous fournisseurs n’ont pas le même objectif.',layer:'Couche de préparation interactive',mapTitle:'Cliquez sur une ville. Découvrez la question de sourcing qu’elle peut vous aider à explorer.',mapCopy:'Il s’agit d’un guide de préparation, et non d’une affirmation selon laquelle un fournisseur précis est adapté ou que tous les produits d’une catégorie sont fabriqués au même endroit.',select:'Sélectionnez un point',selectTitle:'Commencez par une question de sourcing.',selectCopy:'Choisissez une ville pour voir ce que le guide associé peut vous aider à préparer.',allCities:'Découvrir tous les guides par ville ↗',notice:'Les guides détaillés des villes restent des pages sources en anglais pendant la préparation de traductions révisées.',framework:'Un cadre plus utile pour vos visites',frameworkTitle:'Chaque étape doit produire une réponse utile.',steps:[['Définir l’objectif','Découverte produit, vérification d’usine, analyse d’échantillon, discussion de production ou recherche de marché ?'],['Confirmer le lieu','Utilisez l’adresse réelle du fournisseur ou du marché, un temps de trajet réaliste et un plan de contact clair.'],['Préparer les éléments à vérifier','Apportez le brief produit, les échantillons, les questions, la liste de photos et un modèle de suivi.'],['Consigner la décision','Transformez les observations en prochaine étape écrite au lieu de vous fier à une impression.']],planning:'Vous préparez un voyage ?',close:'Créez un brief de visite fournisseur avant de réserver l’itinéraire.',closeCopy:'Sourcing Ally est basé à Shenzhen. Les lieux proches du Guangdong peuvent être envisagés pour un projet convenu, tandis que les déplacements plus lointains en Chine doivent être organisés autour d’adresses réelles et d’objectifs de décision.',brief:'Créer votre brief projet ↗',guide:'Ouvrir le guide ↗',cities:['Électronique, composants, développement produit et base de Sourcing Ally à Shenzhen.','Questions de fabrication et préparation de visites d’usine dans le delta de la rivière des Perles.','Marchés, salons, habillement et itinéraires de rendez-vous fournisseurs.','Questions de sourcing pour le mobilier, l’éclairage et les produits du bâtiment.','Questions sur la chaîne d’approvisionnement de l’éclairage et de l’électroménager.','Questions sur l’électronique et la fabrication proche.','Préparation de marchés de gros et recherche de fournisseurs.','Questions liées au port, à la fabrication et à la préparation des exportations.','Rendez-vous, salons et préparation de chaîne d’approvisionnement.']};
const c=(lang==='fr' ? fr : locales[lang as keyof typeof locales]) || locales.en;
const baseCities=[['Shenzhen','SZ',65,64,'shenzhen'],['Dongguan','DG',51,53,'dongguan'],['Guangzhou','GZ',33,43,'guangzhou'],['Foshan','FS',23,56,'foshan'],['Zhongshan','ZS',43,76,'zhongshan'],['Huizhou','HZ',80,43,'huizhou'],['Yiwu','YW',52,16,'yiwu'],['Ningbo','NB',69,18,'ningbo'],['Shanghai','SH',83,12,'shanghai']];
const cityNames=lang==='ru' ? ['Шэньчжэнь','Дунгуань','Гуанчжоу','Фошань','Чжуншань','Хойчжоу','Иу','Нинбо','Шанхай'] : baseCities.map(city=>city[0]);
const cities=baseCities.map((city,index)=>[cityNames[index],...city.slice(1)]);
---
<Layout title={c.title} description={c.desc} lang={lang} noindex={false}>
<section class="route-map-hero"><div class="container map-hero-grid"><div><a class="back-link" href={`/${lang}/cities/`}>{c.back}</a><p class="eyebrow">{c.eyebrow}</p><h1>{c.hero}</h1><p>{c.intro}</p><a class="button" href="#map">{c.explore}</a></div><aside><span>SA / FIELD ROUTES</span><strong>{c.side.split('\n').map(line=><>{line}<br/></>)}</strong><p>{c.sideCopy}</p></aside></div></section>
<section id="map" class="map-workspace section-pad"><div class="container"><div class="map-heading"><div><p class="eyebrow">{c.layer}</p><h2>{c.mapTitle}</h2></div><p>{c.mapCopy}</p></div><p class="translation-notice">{c.notice}</p><div class="map-layout"><div class="china-map"><div class="map-grid"></div><svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M52 16 L69 18 L83 12"/><path d="M33 43 L51 53 L65 64"/><path d="M23 56 L43 76 L65 64"/><path d="M51 53 L80 43 L65 64"/></svg>{cities.map((city,index)=><button class="map-city" style={`--x:${city[2]}%;--y:${city[3]}%`} data-city={city[0]} data-text={c.cities[index]} data-href={`/${lang}/cities/${city[4]}/`} data-guide={c.guide}><span>{city[1]}</span><b>{city[0]}</b></button>)}</div><div class="map-detail" id="map-detail"><p class="eyebrow">{c.select}</p><h3>{c.selectTitle}</h3><p>{c.selectCopy}</p><a class="button button-outline" href={`/${lang}/cities/`}>{c.allCities}</a></div></div></div></section>
<section class="route-map-process section-pad"><div class="container"><div><p class="eyebrow">{c.framework}</p><h2>{c.frameworkTitle}</h2></div><div class="visit-sequence">{c.steps.map((step,index)=><article><span>0{index+1}</span><h3>{step[0]}</h3><p>{step[1]}</p></article>)}</div></div></section>
<section class="route-map-close"><div class="container close-map-grid"><div><p class="eyebrow">{c.planning}</p><h2>{c.close}</h2></div><p>{c.closeCopy}</p><a class="button" href={`/${lang}/start-project/`}>{c.brief}</a></div></section>
</Layout>
<script>
 const detail=document.querySelector('#map-detail');document.querySelectorAll('.map-city').forEach((button)=>button.addEventListener('click',()=>{document.querySelectorAll('.map-city').forEach(el=>el.classList.remove('is-selected'));button.classList.add('is-selected');detail.innerHTML=`<p class="eyebrow">${button.dataset.city} / CITY GUIDE</p><h3>${button.dataset.city}</h3><p>${button.dataset.text}</p><a class="button" href="${button.dataset.href}">${button.dataset.guide}</a>`;}));
</script>
<style>.route-map-hero{background:#f4f8ff;padding:88px 0 102px;position:relative;overflow:hidden}.route-map-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(40,103,217,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(40,103,217,.09) 1px,transparent 1px);background-size:45px 45px;opacity:.4}.map-hero-grid{position:relative;display:grid;grid-template-columns:1fr .45fr;gap:80px;align-items:end}.back-link{display:inline-block;color:var(--blue);font-size:.84rem;font-weight:750;margin-bottom:40px}.route-map-hero h1{font-size:clamp(3.1rem,6.2vw,6.05rem);letter-spacing:-.04em;line-height:.96;margin:0 0 20px;max-width:850px}.route-map-hero p:not(.eyebrow){color:#405069;line-height:1.8;font-size:1.1rem;max-width:670px;margin:0 0 30px}.map-hero-grid aside{background:var(--coral);padding:25px;min-height:340px;color:#fff;box-shadow:17px 17px 0 rgba(40,103,217,.12);position:relative;overflow:hidden}.map-hero-grid aside:before{content:"";position:absolute;width:300px;height:300px;border:1px solid rgba(255,255,255,.35);border-radius:50%;right:-100px;bottom:-125px}.map-hero-grid aside>*{position:relative;z-index:2}.map-hero-grid aside span{font-size:.65rem;letter-spacing:.14em;font-weight:800}.map-hero-grid aside strong{display:block;font-size:2.5rem;letter-spacing:-.04em;line-height:.82;margin:42px 0 20px}.map-hero-grid aside p{color:#fff!important;font-size:.84rem!important}.map-workspace{background:#fff}.map-heading{display:grid;grid-template-columns:1fr .8fr;gap:70px;align-items:end;margin-bottom:20px}.map-heading h2{font-size:clamp(2.25rem,4.3vw,4.45rem);line-height:1;letter-spacing:-.04em;margin:0}.map-heading>p{line-height:1.75;color:var(--muted);margin:0}.translation-notice{margin:0 0 25px;padding:14px 17px;background:#fff8db;border-left:4px solid var(--coral);color:#405069;line-height:1.65;font-size:.88rem}.map-layout{display:grid;grid-template-columns:1.3fr .6fr;gap:20px}.china-map{min-height:580px;position:relative;background:var(