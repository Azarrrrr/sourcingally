---
import Layout from '../layouts/Layout.astro';

const title = 'Page not found | Sourcing Ally';
const description = 'The page you requested could not be found. Return to Sourcing Ally’s home page or contact the team.';
---

<Layout title={title} description={description} lang="en" noindex>
  <section class="not-found container">
    <p class="eyebrow">404 · Page not found</p>
    <h1>This page isn’t here.</h1>
    <p>The address may be outdated or incorrect. You can return to the home page or contact Sourcing Ally for help.</p>
    <div class="actions">
      <a class="button" href="/en/">Go to the home page</a>
      <a class="text-link" href="mailto:captain@sourcingally.com">Contact captain@sourcingally.com</a>
    </div>
  </section>
</Layout>

<style>
  .not-found{min-height:62vh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding-block:80px}
  .not-found h1{max-width:760px;margin:0 0 18px;font-size:clamp(3rem,8vw,6rem);line-height:.98;letter-spacing:-.07em}
  .not-found>p:not(.eyebrow){max-width:620px;color:var(--muted);font-size:1.1rem;line-height:1.7}
  .actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:22px}
</style>
