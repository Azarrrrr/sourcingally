---
import {
  foundationRouteFallbacks,
  type FoundationRouteKey,
  type PartialFoundationLanguage,
} from '../data/foundation-route-fallbacks';

interface Props {
  lang: PartialFoundationLanguage;
  page: FoundationRouteKey;
}

const { lang, page } = Astro.props;
const copy = foundationRouteFallbacks[lang][page];
const englishPath = page === 'howWeWork' ? '/en/how-we-work/' : '/en/fees-and-scope/';
---
<section class="foundation-route-fallback container locale-source-only">
  <p class="eyebrow">{copy.eyebrow}</p>
  <h1>{copy.title}</h1>
  <p class="foundation-route-fallback__notice">{copy.notice}</p>
  <div class="foundation-route-fallback__actions">
    <a class="button" href={englishPath}>{copy.englishLink} <span>↗</span></a>
    <a class="text-link" href={`/${lang}/services/`}>{copy.localLink}</a>
  </div>
</section>

<style>
  .foundation-route-fallback{min-height:62vh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding-block:80px}
  .foundation-route-fallback h1{max-width:760px;margin:0 0 18px;font-size:clamp(2.5rem,7vw,5rem);line-height:1.02;letter-spacing:-.055em}
  .foundation-route-fallback__notice{max-width:660px;color:var(--muted);font-size:1.1rem;line-height:1.75}
  .foundation-route-fallback__actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:20px}
</style>
