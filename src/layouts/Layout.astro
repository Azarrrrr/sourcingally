---
import '../styles/global.css';
import '../styles/refresh.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  noindex?: boolean;
}

const { title, description, lang = 'en', noindex = false } = Astro.props;
const languages = [
  ['en', 'English'],
  ['es', 'Español'],
  ['pt', 'Português'],
  ['ru', 'Русский'],
  ['tr', 'Türkçe'],
  ['fr', 'Français'],
  ['ja', '日本語'],
  ['de', 'Deutsch'],
  ['ar', 'العربية'],
  ['id', 'Bahasa Indonesia'],
  ['it', 'Italiano'],
];
const path = Astro.url.pathname.replace(/^\/(en|es|pt|ru|tr|fr|ja|de|ar|id|it)/, '') || '/';
const canonicalUrl = `https://sourcingally.com${Astro.url.pathname}`;
const fullyLocalizedPaths = new Set(['/', '/paths/', '/start-project/', '/service-matcher/', '/china-route/', '/supplier-verification/', '/product-samples/', '/factory-visits/', '/quality-control-plan/', '/shipping-readiness/', '/china-business-travel/']);
const hasLocalizedAlternates = !noindex && fullyLocalizedPaths.has(path);
const alternateLanguages = languages;
const uiValues = {
  en:{work:'Work with us',learn:'Learn',exploreChina:'Explore China',services:'Services',buyerPaths:'Buyer paths',matcher:'Service Matcher',briefBuilder:'Project Brief Builder',questions:'Sourcing Questions',school:'Sourcing School',journal:'Journal',editorial:'Editorial standards',cities:'China cities',routeMap:'China Route Map',products:'Product guides',start:'Start a project',howWeWork:'How we work',feesScope:'Fees & scope',decisionGuides:'Decision guides',supplierVerification:'Supplier verification',productSamples:'Product samples',factoryVisits:'Factory visits',qualityControlPlan:'Quality-control plan',shippingReadiness:'Shipping readiness',chinaBusinessTravel:'China business travel',menu:'Menu',chooseLanguage:'Choose language',explore:'Explore',privacy:'Privacy',terms:'Terms',disclaimer:'Disclaimer',policy:'Editorial policy',contact:'Contact',footer:'A sourcing partner on the ground in Shenzhen, helping international buyers work with China more clearly and confidently.',international:'Shenzhen, China · International service'},
  es:{work:'Trabaje con nosotros',learn:'Aprenda',exploreChina:'Explora China',services:'Servicios',buyerPaths:'Rutas de compra',matcher:'Asistente de servicios',briefBuilder:'Creador de proyecto',questions:'Preguntas sobre abastecimiento',school:'Escuela de abastecimiento',journal:'Revista',editorial:'Estándares editoriales',cities:'Ciudades de China',routeMap:'Mapa de rutas en China',products:'Guías de productos',start:'Inicie un proyecto',howWeWork:'Cómo trabajamos',feesScope:'Tarifas y alcance',decisionGuides:'Guías de decisión',supplierVerification:'Verificación de proveedores',productSamples:'Muestras de producto',factoryVisits:'Visitas a fábricas',qualityControlPlan:'Plan de control de calidad',shippingReadiness:'Preparación del envío',chinaBusinessTravel:'Viajes de negocios a China',menu:'Menú',chooseLanguage:'Elija un idioma',explore:'Explorar',privacy:'Privacidad',terms:'Términos',disclaimer:'Aviso legal',policy:'Política editorial',contact:'Contacto',footer:'Un socio de abastecimiento en Shenzhen que ayuda a compradores internacionales a trabajar con China con mayor claridad y confianza.',international:'Shenzhen, China · Servicio internacional'},
  pt:{work:'Trabalhe conosco',learn:'Aprenda',exploreChina:'Explore a China',services:'Serviços',buyerPaths:'Rotas do comprador',matcher:'Assistente de serviços',briefBuilder:'Criador de projeto',questions:'Perguntas sobre sourcing',school:'Escola de sourcing',journal:'Revista',editorial:'Padrões editoriais',cities:'Cidades da China',routeMap:'Mapa de rotas na China',products:'Guias de produtos',start:'Inicie um projeto',howWeWork:'Como trabalhamos',feesScope:'Taxas e escopo',decisionGuides:'Guias de decisão',supplierVerification:'Verificação de fornecedores',productSamples:'Amostras de produto',factoryVisits:'Visitas a fábricas',qualityControlPlan:'Plano de controle de qualidade',shippingReadiness:'Preparação para envio',chinaBusinessTravel:'Viagens de negócios à China',menu:'Menu',chooseLanguage:'Escolha um idioma',explore:'Explorar',privacy:'Privacidade',terms:'Termos',disclaimer:'Aviso legal',policy:'Política editorial',contact:'Contato',footer:'Um parceiro de sourcing em Shenzhen que ajuda compradores internacionais a trabalhar com a China de forma mais clara e confiante.',international:'Shenzhen, China · Serviço internacional'},
  ru:{work:'Работать с нами',learn:'Узнать больше',exploreChina:'О Китае',services:'Услуги',buyerPaths:'Маршруты покупателя',matcher:'Подбор услуги',briefBuilder:'Конструктор проекта',questions:'Вопросы о закупках',school:'Школа закупок',journal:'Журнал',editorial:'Редакционные стандарты',cities:'Города Китая',routeMap:'Карта маршрутов по Китаю',products:'Гиды по продуктам',start:'Начать проект',howWeWork:'Как мы работаем',feesScope:'Стоимость и объём работ',decisionGuides:'Гиды для решений',supplierVerification:'Проверка поставщика',productSamples:'Образцы продукции',factoryVisits:'Посещение фабрик',qualityControlPlan:'План контроля качества',shippingReadiness:'Подготовка к отгрузке',chinaBusinessTravel:'Деловая поездка в Китай',menu:'Меню',chooseLanguage:'Выберите язык',explore:'Обзор',privacy:'Конфиденциальность',terms:'Условия',disclaimer:'Отказ от ответственности',policy:'Редакционная политика',contact:'Контакты',footer:'Партнёр по закупкам в Шэньчжэне, который помогает международным покупателям работать с Китаем яснее и увереннее.',international:'Шэньчжэнь, Китай · Международный сервис'},
  tr:{work:'Bizimle çalışın',learn:'Öğrenin',exploreChina:'Çin’i keşfedin',services:'Hizmetler',buyerPaths:'Alıcı rotaları',matcher:'Hizmet Eşleştirici',briefBuilder:'Proje Oluşturucu',questions:'Tedarik soruları',school:'Tedarik Okulu',journal:'Dergi',editorial:'Editoryal standartlar',cities:'Çin şehirleri',routeMap:'Çin rota haritası',products:'Ürün rehberleri',start:'Bir proje başlatın',howWeWork:'Nasıl çalışıyoruz',feesScope:'Ücretler ve kapsam',decisionGuides:'Karar rehberleri',supplierVerification:'Tedarikçi doğrulama',productSamples:'Ürün numuneleri',factoryVisits:'Fabrika ziyaretleri',qualityControlPlan:'Kalite kontrol planı',shippingReadiness:'Sevkiyat hazırlığı',chinaBusinessTravel:'Çin iş seyahati',menu:'Menü',chooseLanguage:'Dil seçin',explore:'Keşfedin',privacy:'Gizlilik',terms:'Koşullar',disclaimer:'Sorumluluk reddi',policy:'Editoryal politika',contact:'İletişim',footer:'Shenzhen’de bulunan ve uluslararası alıcıların Çin ile daha net ve güvenle çalışmasına yardımcı olan tedarik ortağı.',international:'Shenzhen, Çin · Uluslararası hizmet'},
  fr:{work:'Travailler avec nous',learn:'Apprendre',exploreChina:'Explorer la Chine',services:'Services',buyerPaths:'Parcours acheteurs',matcher:'Assistant services',briefBuilder:'Créateur de brief',questions:'Questions sur le sourcing',school:'École du sourcing',journal:'Journal',editorial:'Charte éditoriale',cities:'Villes de Chine',routeMap:'Carte des itinéraires en Chine',products:'Guides produits',start:'Démarrer un projet',howWeWork:'Comment nous travaillons',feesScope:'Tarifs et périmètre',decisionGuides:'Guides de décision',supplierVerification:'Vérification des fournisseurs',productSamples:'Échantillons produit',factoryVisits:'Visites d’usine',qualityControlPlan:'Plan de contrôle qualité',shippingReadiness:'Préparation de l’expédition',chinaBusinessTravel:'Voyage d’affaires en Chine',menu:'Menu',chooseLanguage:'Choisir une langue',explore:'Explorer',privacy:'Confidentialité',terms:'Conditions',disclaimer:'Avertissement',policy:'Politique éditoriale',contact:'Contact',footer:'Un partenaire de sourcing basé à Shenzhen, qui aide les acheteurs internationaux à travailler avec la Chine de façon plus claire et plus sereine.',international:'Shenzhen, Chine · Service international'}
};
const ui = uiValues[lang as keyof typeof uiValues] ?? uiValues.en;
const quoteUi = ({
  en: { trigger: 'Share your product', eyebrow: 'SOURCING ALLY / PROJECT BRIEF', title: 'Bring your product question into the conversation.', note: 'Share the product, quantity, destination, and the support you need. The request opens in a full-page workspace.', close: 'Close request' },
  es: { trigger: 'Cuéntanos tu producto', eyebrow: 'SOURCING ALLY / BRIEF DE PROYECTO', title: 'Trae tu consulta sobre el producto a la conversación.', note: 'Comparte el producto, la cantidad, el destino y el apoyo que necesitas. La solicitud se abre en una página completa.', close: 'Cerrar solicitud' },
  pt: { trigger: 'Conte-nos o produto', eyebrow: 'SOURCING ALLY / BRIEF DO PROJETO', title: 'Traga a questão do produto para a conversa.', note: 'Partilhe o produto, a quantidade, o destino e o apoio de que precisa. O pedido abre num espaço de página inteira.', close: 'Fechar pedido' },
  ru: { trigger: 'Расскажите о товаре', eyebrow: 'SOURCING ALLY / БРИФ ПРОЕКТА', title: 'Добавьте вопрос о товаре в разговор.', note: 'Укажите товар, количество, направление и нужную поддержку. Заявка открывается на весь экран.', close: 'Закрыть заявку' },
  tr: { trigger: 'Ürününüzü anlatın', eyebrow: 'SOURCING ALLY / PROJE ÖZETİ', title: 'Ürün sorusuyla görüşmeyi başlatın.', note: 'Ürünü, miktarı, varış yerini ve ihtiyacınız olan desteği paylaşın. Talep tam sayfa çalışma alanında açılır.', close: 'Talebi kapat' },
  fr: { trigger: 'Parlez-nous du produit', eyebrow: 'SOURCING ALLY / BRIEF DE PROJET', title: 'Ajoutez votre question produit à la conversation.', note: 'Partagez le produit, la quantité, la destination et l’accompagnement recherché. La demande s’ouvre en pleine page.', close: 'Fermer la demande' }
} as Record<string, { trigger: string; eyebrow: string; title: string; note: string; close: string }>)[lang] ?? { trigger: 'Share your product', eyebrow: 'SOURCING ALLY / PROJECT BRIEF', title: 'Bring your product question into the conversation.', note: 'Share the product, quantity, destination, and the support you need.', close: 'Close request' };
const organizationJson = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Sourcing Ally',
  url: 'https://sourcingally.com',
  email: 'sourcingally@gmail.com',
  telephone: '+8619002009100',
  areaServed: 'International',
  founder: { '@type': 'Person', name: 'Azar Pamir' },
  description: 'A Shenzhen-based sourcing partner supporting international buyers with agreed sourcing, supplier, sample, factory-check, quality-control, packaging, travel, and translation tasks.'
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {hasLocalizedAlternates && alternateLanguages.map(([code]) => <link rel="alternate" hreflang={code} href={`https://sourcingally.com/${code}${path}`} />)}
    {hasLocalizedAlternates && <link rel="alternate" hreflang="x-default" href={`https://sourcingally.com/en${path}`} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sourcing Ally" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJson)}></script>
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href={`/${lang}/`} aria-label="Sourcing Ally home">
          <span class="brand-mark">SA</span>
          <span>Sourcing <b>Ally</b></span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <div class="nav-group" data-nav-group><button class="nav-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="nav-work">{ui.work} <span>+</span></button><div class="nav-panel" id="nav-work"><a href={`/${lang}/services/`}>{ui.services}</a><a href={`/${lang}/paths/`}>{ui.buyerPaths}</a><a href={`/${lang}/service-matcher/`}>{ui.matcher}</a><a href={`/${lang}/start-project/`}>{ui.briefBuilder}</a><a href={`/${lang}/shipping-readiness/`}>{ui.shippingReadiness}</a></div></div>
          <div class="nav-group" data-nav-group><button class="nav-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="nav-decisions">{ui.decisionGuides} <span>+</span></button><div class="nav-panel" id="nav-decisions"><a href={`/${lang}/supplier-verification/`}>{ui.supplierVerification}</a><a href={`/${lang}/product-samples/`}>{ui.productSamples}</a><a href={`/${lang}/factory-visits/`}>{ui.factoryVisits}</a><a href={`/${lang}/quality-control-plan/`}>{ui.qualityControlPlan}</a></div></div>
          <div class="nav-group" data-nav-group><button class="nav-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="nav-learn">{ui.learn} <span>+</span></button><div class="nav-panel" id="nav-learn"><a href={`/${lang}/questions/`}>{ui.questions}</a><a href={`/${lang}/guides/`}>{ui.school}</a><a href={`/${lang}/blog/`}>{ui.journal}</a><a href={`/${lang}/editorial-policy/`}>{ui.editorial}</a></div></div>
          <div class="nav-group" data-nav-group><button class="nav-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="nav-china">{ui.exploreChina} <span>+</span></button><div class="nav-panel" id="nav-china"><a href={`/${lang}/cities/`}>{ui.cities}</a><a href={`/${lang}/china-route/`}>{ui.routeMap}</a><a href={`/${lang}/china-business-travel/`}>{ui.chinaBusinessTravel}</a><a href={`/${lang}/products/`}>{ui.products}</a></div></div>
          <a class="nav-direct" href={`/${lang}/how-we-work/`}>{ui.howWeWork}</a>
          <a class="nav-direct" href={`/${lang}/fees-and-scope/`}>{ui.feesScope}</a>
        </nav>
        <details class="mobile-nav"><summary>{ui.menu} <span>+</span></summary><div class="mobile-nav-panel"><a href={`/${lang}/services/`}>{ui.services}</a><a href={`/${lang}/paths/`}>{ui.buyerPaths}</a><a href={`/${lang}/service-matcher/`}>{ui.matcher}</a><a href={`/${lang}/start-project/`}>{ui.briefBuilder}</a><a href={`/${lang}/how-we-work/`}>{ui.howWeWork}</a><a href={`/${lang}/fees-and-scope/`}>{ui.feesScope}</a><a href={`/${lang}/supplier-verification/`}>{ui.supplierVerification}</a><a href={`/${lang}/product-samples/`}>{ui.productSamples}</a><a href={`/${lang}/factory-visits/`}>{ui.factoryVisits}</a><a href={`/${lang}/quality-control-plan/`}>{ui.qualityControlPlan}</a><a href={`/${lang}/shipping-readiness/`}>{ui.shippingReadiness}</a><a href={`/${lang}/questions/`}>{ui.questions}</a><a href={`/${lang}/guides/`}>{ui.school}</a><a href={`/${lang}/blog/`}>{ui.journal}</a><a href={`/${lang}/cities/`}>{ui.cities}</a><a href={`/${lang}/china-route/`}>{ui.routeMap}</a><a href={`/${lang}/china-business-travel/`}>{ui.chinaBusinessTravel}</a><a href={`/${lang}/products/`}>{ui.products}</a></div></details>
        <div class="nav-actions">
          <label class="language-picker">
            <span class="sr-only">{ui.chooseLanguage}</span>
            <select onchange="window.location.href=this.value">
              {languages.map(([code, name]) => <option value={`/${code}${path}`} selected={code === lang}>{name}</option>)}
            </select>
          </label>
          <a class="button button-small" href={`/${lang}/start-project/`}>{ui.start}</a>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-intro">
          <a class="brand footer-brand" href={`/${lang}/`}><span class="brand-mark">SA</span><span>Sourcing <b>Ally</b></span></a>
          <p class="footer-copy">{ui.footer}</p>
        </div>
        <nav class="footer-links" aria-label={ui.explore}>
          <p class="footer-label">{ui.explore}</p>
          <a href={`/${lang}/services/`}>{ui.services}</a>
          <a href={`/${lang}/products/`}>{ui.products}</a>
          <a href={`/${lang}/cities/`}>{ui.cities}</a>
          <a href={`/${lang}/guides/`}>{ui.school}</a>
          <a href={`/${lang}/blog/`}>{ui.journal}</a>
        </nav>
        <nav class="footer-links" aria-label={ui.work}>
          <p class="footer-label">{ui.work}</p>
          <a href={`/${lang}/paths/`}>{ui.buyerPaths}</a>
          <a href={`/${lang}/start-project/`}>{ui.briefBuilder}</a>
          <a href={`/${lang}/how-we-work/`}>{ui.howWeWork}</a>
          <a href={`/${lang}/fees-and-scope/`}>{ui.feesScope}</a>
        </nav>
        <div class="footer-contact">
          <p class="footer-label">{ui.contact}</p>
          <a href="mailto:sourcingally@gmail.com">sourcingally@gmail.com</a>
          <a href="https://wa.me/8619002009100" target="_blank" rel="noreferrer">WhatsApp +86 190 0200 9100</a>
        </div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} Sourcing Ally</span><nav class="footer-legal" aria-label="Legal"><a href={`/${lang}/privacy/`}>{ui.privacy}</a><a href={`/${lang}/terms/`}>{ui.terms}</a><a href={`/${lang}/disclaimer/`}>{ui.disclaimer}</a><a href={`/${lang}/editorial-policy/`}>{ui.policy}</a></nav><span>{ui.international}</span></div>
    </footer>
    <button class="sa-request-fab" type="button" data-quote-open aria-haspopup="dialog"><span class="sa-request-fab-mark">✦</span><span>{quoteUi.trigger}</span><b>↗</b></button>
    <section class="sa-request-overlay" data-quote-overlay hidden role="dialog" aria-modal="true" aria-label={quoteUi.title}>
      <header><div><span>{quoteUi.eyebrow}</span><h2>{quoteUi.title}</h2><p>{quoteUi.note}</p></div><button type="button" data-quote-close aria-label={quoteUi.close}><span>{quoteUi.close}</span><b>×</b></button></header>
      <div class="sa-request-frame"><iframe data-quote-frame title={quoteUi.title}></iframe></div>
    </section>
    <script define:vars={{ lang }}>
      (() => {
        const button = document.querySelector('[data-quote-open]');
        const overlay = document.querySelector('[data-quote-overlay]');
        const closeButton = document.querySelector('[data-quote-close]');
        const frame = document.querySelector('[data-quote-frame]');
        const open = () => {
          const formUrl = new URL('https://appeqsux2arkwksqlyh.teable.app');
          formUrl.searchParams.set('lang', lang);
          formUrl.searchParams.set('source', window.location.hostname.replace(/^www\\./, '').toLowerCase());
          formUrl.searchParams.set('sourceUrl', window.location.href);
          if (frame) frame.src = formUrl.toString();
          if (overlay) overlay.hidden = false;
          document.body.classList.add('quote-workspace-open');
        };
        const close = () => { if (overlay) overlay.hidden = true; document.body.classList.remove('quote-workspace-open'); };
        button?.addEventListener('click', open);
        closeButton?.addEventListener('click', close);
        document.addEventListener('sa:open-quote', open);
        document.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
      })();
    </script>
    <script>
      const groups = [...document.querySelectorAll('[data-nav-group]')];
      const closeTimers = new WeakMap();
      const closeNow = (group) => {
        window.clearTimeout(closeTimers.get(group));
        group.classList.remove('is-open');
        group.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'false');
      };
      const scheduleClose = (group) => {
        window.clearTimeout(closeTimers.get(group));
        closeTimers.set(group, window.setTimeout(() => closeNow(group), 220));
      };
      const openGroup = (group) => {
        window.clearTimeout(closeTimers.get(group));
        groups.forEach((item) => { if (item !== group) closeNow(item); });
        group.classList.add('is-open');
        group.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'true');
      };
      groups.forEach((group) => {
        const trigger = group.querySelector('.nav-trigger');
        group.addEventListener('mouseenter', () => openGroup(group));
        group.addEventListener('mouseleave', () => scheduleClose(group));
        group.addEventListener('focusin', () => openGroup(group));
        group.addEventListener('focusout', (event) => { if (!group.contains(event.relatedTarget)) closeNow(group); });
        trigger?.addEventListener('click', () => group.classList.contains('is-open') ? closeNow(group) : openGroup(group));
      });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') groups.forEach(closeNow); });
    </script>
    <style is:global>
      .sa-request-fab{position:fixed;left:20px;bottom:20px;z-index:80;display:inline-flex;align-items:center;gap:9px;border:1px solid #0a5c56;border-radius:999px;background:#0a5c56;color:#fff;padding:9px 13px 9px 9px;box-shadow:0 14px 32px rgba(11,46,43,.28);font:800 11px/1.1 system-ui,sans-serif;letter-spacing:.07em;text-transform:uppercase;cursor:pointer;transition:transform .16s cubic-bezier(.23,1,.32,1),background-color .16s ease}.sa-request-fab:hover{transform:translateY(-3px);background:#0f746d}.sa-request-fab:active{transform:scale(.97)}.sa-request-fab-mark{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#d1e8df;color:#0a5c56;font-size:15px}.sa-request-fab b{font-size:14px}.sa-request-overlay{position:fixed;inset:0;z-index:100;display:grid;grid-template-rows:auto minmax(0,1fr);background:#f6faf8}.sa-request-overlay[hidden]{display:none}.sa-request-overlay header{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding:20px clamp(18px,4vw,60px);background:#073b38;color:#fff;border-bottom:4px solid #c6dcd2}.sa-request-overlay header>div{max-width:760px}.sa-request-overlay header>div>span{display:block;color:#d1e8df;font:800 10px/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.sa-request-overlay h2{margin:9px 0 7px;font-size:clamp(1.35rem,2.7vw,2.4rem);line-height:1.02}.sa-request-overlay p{margin:0;max-width:700px;color:#d9ece6;font-size:.94rem;line-height:1.45}.sa-request-overlay header button{display:inline-flex;align-items:center;gap:9px;flex:0 0 auto;border:1px solid rgba(255,255,255,.34);border-radius:999px;background:transparent;color:#fff;padding:8px 11px;font:800 10px/1 system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}.sa-request-overlay header button:hover{background:rgba(255,255,255,.1)}.sa-request-overlay header button b{font-size:22px;font-weight:400;line-height:.6}.sa-request-frame{min-height:0;background:#fff}.sa-request-frame iframe{display:block;width:100%;height:100%;border:0;background:#fff}body.quote-workspace-open{overflow:hidden}@media(max-width:640px){.sa-request-fab{left:13px;bottom:13px;font-size:10px}.sa-request-overlay header{padding:16px;gap:12px}.sa-request-overlay header p{display:none}.sa-request-overlay header button span{display:none}.sa-request-overlay header button{padding:9px}.sa-request-overlay h2{font-size:1.2rem}}
    </style>
  </body>
</html>
