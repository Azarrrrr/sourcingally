---
import '../styles/global.css';
import '../styles/refresh.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  noindex?: boolean;
}

const { title, description, lang = 'en', noindex = false } = Astro.props;
const languages = [
  ['en', 'English'],
  ['es', 'Español'],
  ['pt', 'Português'],
  ['ru', 'Русский'],
  ['tr', 'Türkçe'],
  ['fr', 'Français'],
];
const path = Astro.url.pathname.replace(/^\/(en|es|pt|ru|tr|fr)/, '') || '/';
const canonicalUrl = `https://sourcingally.com${Astro.url.pathname}`;
const fullyLocalizedPaths = new Set(['/', '/paths/', '/start-project/', '/service-matcher/', '/china-route/']);
const hasLocalizedAlternates = !noindex && fullyLocalizedPaths.has(path);
const alternateLanguages = path === '/' ? languages : languages.filter(([code]) => code !== 'fr');
const ui = {
  en:{work:'Work with us',learn:'Learn',exploreChina:'Explore China',services:'Services',buyerPaths:'Buyer paths',matcher:'Service Matcher',briefBuilder:'Project Brief Builder',questions:'Sourcing Questions',school:'Sourcing School',journal:'Journal',editorial:'Editorial standards',cities:'China cities',routeMap:'China Route Map',products:'Product guides',start:'Start a project',howWeWork:'How we work',feesScope:'Fees & scope',menu:'Menu',chooseLanguage:'Choose language',explore:'Explore',privacy:'Privacy',terms:'Terms',disclaimer:'Disclaimer',policy:'Editorial policy',contact:'Contact',footer:'A sourcing partner on the ground in Shenzhen, helping international buyers work with China more clearly and confidently.',international:'Shenzhen, China · International service'},
  es:{work:'Trabaje con nosotros',learn:'Aprenda',exploreChina:'Explore China',services:'Servicios',buyerPaths:'Rutas de compra',matcher:'Asistente de servicios',briefBuilder:'Creador de proyecto',questions:'Preguntas sobre abastecimiento',school:'Escuela de abastecimiento',journal:'Revista',editorial:'Estándares editoriales',cities:'Ciudades de China',routeMap:'Mapa de rutas en China',products:'Guías de productos',start:'Inicie un proyecto',howWeWork:'Cómo trabajamos',feesScope:'Tarifas y alcance',menu:'Menú',chooseLanguage:'Elija un idioma',explore:'Explorar',privacy:'Privacidad',terms:'Términos',disclaimer:'Aviso legal',policy:'Política editorial',contact:'Contacto',footer:'Un socio de abastecimiento en Shenzhen que ayuda a compradores internacionales a trabajar con China con mayor claridad y confianza.',international:'Shenzhen, China · Servicio internacional'},
  pt:{work:'Trabalhe conosco',learn:'Aprenda',exploreChina:'Explore a China',services:'Serviços',buyerPaths:'Rotas do comprador',matcher:'Assistente de serviços',briefBuilder:'Criador de projeto',questions:'Perguntas sobre sourcing',school:'Escola de sourcing',journal:'Revista',editorial:'Padrões editoriais',cities:'Cidades da China',routeMap:'Mapa de rotas na China',products:'Guias de produtos',start:'Inicie um projeto',howWeWork:'Como trabalhamos',feesScope:'Taxas e escopo',menu:'Menu',chooseLanguage:'Escolha um idioma',explore:'Explorar',privacy:'Privacidade',terms:'Termos',disclaimer:'Aviso legal',policy:'Política editorial',contact:'Contato',footer:'Um parceiro de sourcing em Shenzhen que ajuda compradores internacionais a trabalhar com a China de forma mais clara e confiante.',international:'Shenzhen, China · Serviço internacional'},
  ru:{work:'Работать с нами',learn:'Узнать больше',exploreChina:'О Китае',services:'Услуги',buyerPaths:'Маршруты покупателя',matcher:'Подбор услуги',briefBuilder:'Конструктор проекта',questions:'Вопросы о закупках',school:'Школа закупок',journal:'Журнал',editorial:'Редакционные стандарты',cities:'Города Китая',routeMap:'Карта маршрутов по Китаю',products:'Гиды по продуктам',start:'Начать проект',howWeWork:'Как мы работаем',feesScope:'Стоимость и объём работ',menu:'Меню',chooseLanguage:'Выберите язык',explore:'Обзор',privacy:'Конфиденциальность',terms:'Условия',disclaimer:'Отказ от ответственности',policy:'Редакционная политика',contact:'Контакты',footer:'Партнёр по закупкам в Шэньчжэне, который помогает международным покупателям работать с Китаем яснее и увереннее.',international:'Шэньчжэнь, Китай · Международный сервис'},
  tr:{work:'Bizimle çalışın',learn:'Öğrenin',exploreChina:'Çin’i keşfedin',services:'Hizmetler',buyerPaths:'Alıcı rotaları',matcher:'Hizmet Eşleştirici',briefBuilder:'Proje Oluşturucu',questions:'Tedarik soruları',school:'Tedarik Okulu',journal:'Dergi',editorial:'Editoryal standartlar',cities:'Çin şehirleri',routeMap:'Çin rota haritası',products:'Ürün rehberleri',start:'Bir proje başlatın',howWeWork:'Nasıl çalışıyoruz',feesScope:'Ücretler ve kapsam',menu:'Menü',chooseLanguage:'Dil seçin',explore:'Keşfedin',privacy:'Gizlilik',terms:'Koşullar',disclaimer:'Sorumluluk reddi',policy:'Editoryal politika',contact:'İletişim',footer:'Shenzhen’de bulunan ve uluslararası alıcıların Çin ile daha net ve güvenle çalışmasına yardımcı olan tedarik ortağı.',international:'Shenzhen, Çin · Uluslararası hizmet'},
  fr:{work:'Travailler avec nous',learn:'Apprendre',exploreChina:'Explorer la Chine',services:'Services',buyerPaths:'Parcours acheteurs',matcher:'Assistant services',briefBuilder:'Créateur de brief',questions:'Questions sur le sourcing',school:'École du sourcing',journal:'Journal',editorial:'Charte éditoriale',cities:'Villes de Chine',routeMap:'Carte des itinéraires en Chine',products:'Guides produits',start:'Démarrer un projet',howWeWork:'Comment nous travaillons',feesScope:'Tarifs et périmètre',menu:'Menu',chooseLanguage:'Choisir une langue',explore:'Explorer',privacy:'Confidentialité',terms:'Conditions',disclaimer:'Avertissement',policy:'Politique éditoriale',contact:'Contact',footer:'Un partenaire de sourcing basé à Shenzhen, qui aide les acheteurs internationaux à travailler avec la Chine de façon plus claire et plus sereine.',international:'Shenzhen, Chine · Service international'}
}[lang as 'en'|'es'|'pt'|'ru'|'tr'|'fr'] ?? undefined;
const organizationJson = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Sourcing Ally',
  url: 'https://sourcingally.com',
  email: 'sourcingally@gmail.com',
  telephone: '+8619002009100',
  areaServed: 'International',
  founder: { '@type': 'Person', name: 'Azar Pamir' },
  description: 'A Shenzhen-based sourcing partner supporting international buyers with agreed sourcing, supplier, sample, factory-check, quality-control, packaging, travel, and translation tasks.'
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {hasLocalizedAlternates && alternateLanguages.map(([code]) => <link rel="alternate" hreflang={code} href={`https://sourcingally.com/${code}${path}`} />)}
    {hasLocalizedAlternates && <link rel="alternate" hreflang="x-default" href={`https://sourcingally.com/en${path}`} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sourcing Ally" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJson)}></script>
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href={`/${lang}/`} aria-label="Sourcing Ally home">
          <span class="brand-mark">SA</span>
          <span>Sourcing <b>Ally</b></span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <div class="nav-group" data-nav-group><button class="nav-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="nav-work">{ui.work} <span>+</span></button><div class="nav-panel" id="nav-work"><a href={`/${lang}/services/`}>{ui.services}</a><a href={`/${lang}/paths/`}>{ui.buyerPaths}</a><a href={`/${lang}/service-matcher/`}>{ui.matcher}</a><a href={`/${lang}/start-project/`}>{ui.briefBuilder}</a></div></div>
          <div class="nav-group" data-nav-group><button class="nav-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="nav-learn">{ui.learn} <span>+</span></button><div class="nav-panel" id="nav-learn"><a href={`/${lang}/questions/`}>{ui.questions}</a><a href={`/${lang}/guides/`}>{ui.school}</a><a href={`/${lang}/blog/`}>{ui.journal}</a><a href={`/${lang}/editorial-policy/`}>{ui.editorial}</a></div></div>
          <div class="nav-group" data-nav-group><button class="nav-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="nav-china">{ui.exploreChina} <span>+</span></button><div class="nav-panel" id="nav-china"><a href={`/${lang}/cities/`}>{ui.cities}</a><a href={`/${lang}/china-route/`}>{ui.routeMap}</a><a href={`/${lang}/products/`}>{ui.products}</a></div></div>
          <a class="nav-direct" href={`/${lang}/how-we-work/`}>{ui.howWeWork}</a>
          <a class="nav-direct" href={`/${lang}/fees-and-scope/`}>{ui.feesScope}</a>
        </nav>
        <details class="mobile-nav"><summary>{ui.menu} <span>+</span></summary><div class="mobile-nav-panel"><a href={`/${lang}/services/`}>{ui.services}</a><a href={`/${lang}/paths/`}>{ui.buyerPaths}</a><a href={`/${lang}/service-matcher/`}>{ui.matcher}</a><a href={`/${lang}/start-project/`}>{ui.briefBuilder}</a><a href={`/${lang}/how-we-work/`}>{ui.howWeWork}</a><a href={`/${lang}/fees-and-scope/`}>{ui.feesScope}</a><a href={`/${lang}/questions/`}>{ui.questions}</a><a href={`/${lang}/guides/`}>{ui.school}</a><a href={`/${lang}/blog/`}>{ui.journal}</a><a href={`/${lang}/cities/`}>{ui.cities}</a><a href={`/${lang}/china-route/`}>{ui.routeMap}</a><a href={`/${lang}/products/`}>{ui.products}</a></div></details>
        <div class="nav-actions">
          <label class="language-picker">
            <span class="sr-only">{ui.chooseLanguage}</span>
            <select onchange="window.location.href=this.value">
              {languages.map(([code, name]) => <option value={`/${code}${path}`} selected={code === lang}>{name}</option>)}
            </select>
          </label>
          <a class="button button-small" href={`/${lang}/start-project/`}>{ui.start}</a>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand footer-brand" href={`/${lang}/`}><span class="brand-mark">SA</span><span>Sourcing <b>Ally</b></span></a>
          <p class="footer-copy">{ui.footer}</p>
        </div>
        <div>
          <p class="footer-label">{ui.explore}</p>
          <a href={`/${lang}/services/`}>{ui.services}</a>
          <a href={`/${lang}/paths/`}>{ui.buyerPaths}</a>
          <a href={`/${lang}/products/`}>{ui.products}</a>
          <a href={`/${lang}/cities/`}>{ui.cities}</a>
          <a href={`/${lang}/guides/`}>{ui.school}</a>
          <a href={`/${lang}/questions/`}>{ui.questions}</a>
          <a href={`/${lang}/blog/`}>{ui.journal}</a>
          <a href={`/${lang}/start-project/`}>{ui.briefBuilder}</a>
          <a href={`/${lang}/privacy/`}>{ui.privacy}</a>
          <a href={`/${lang}/terms/`}>{ui.terms}</a>
          <a href={`/${lang}/disclaimer/`}>{ui.disclaimer}</a>
          <a href={`/${lang}/editorial-policy/`}>{ui.policy}</a>
        </div>
        <div>
          <p class="footer-label">{ui.contact}</p>
          <a href="mailto:sourcingally@gmail.com">sourcingally@gmail.com</a>
          <a href="https://wa.me/8619002009100" target="_blank" rel="noreferrer">WhatsApp +86 190 0200 9100</a>
        </div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} Sourcing Ally</span><span>{ui.international}</span></div>
    </footer>
    <script>
      const groups = [...document.querySelectorAll('[data-nav-group]')];
      const closeGroup = (group) => {
        group.classList.remove('is-open');
        group.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'false');
      };
      const openGroup = (group) => {
        groups.forEach((item) => { if (item !== group) closeGroup(item); });
        group.classList.add('is-open');
        group.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'true');
      };
      groups.forEach((group) => {
        const trigger = group.querySelector('.nav-trigger');
        group.addEventListener('mouseenter', () => openGroup(group));
        group.addEventListener('mouseleave', () => closeGroup(group));
        group.addEventListener('focusin', () => openGroup(group));
        group.addEventListener('focusout', (event) => { if (!group.contains(event.relatedTarget)) closeGroup(group); });
        trigger?.addEventListener('click', () => group.classList.contains('is-open') ? closeGroup(group) : openGroup(group));
      });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') groups.forEach(closeGroup); });
    </script>
  </body>
</html>
