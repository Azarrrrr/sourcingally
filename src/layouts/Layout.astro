---
import '../styles/global.css';
import '../styles/refresh.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
}

const { title, description, lang = 'en' } = Astro.props;
const languages = [
  ['en', 'English'],
  ['es', 'Español'],
  ['pt', 'Português'],
  ['ru', 'Русский'],
  ['tr', 'Türkçe'],
];
const path = Astro.url.pathname.replace(/^\/(en|es|pt|ru|tr)/, '') || '/';
const canonicalUrl = `https://sourcingally.com${Astro.url.pathname}`;
const organizationJson = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Sourcing Ally',
  url: 'https://sourcingally.com',
  email: 'sourcingally@gmail.com',
  telephone: '+8619002009100',
  areaServed: 'International',
  founder: { '@type': 'Person', name: 'Azar Pamir' },
  description: 'A Shenzhen-based sourcing partner supporting international buyers with agreed sourcing, supplier, sample, factory-check, quality-control, packaging, travel, and translation tasks.'
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sourcing Ally" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJson)}></script>
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href={`/${lang}/`} aria-label="Sourcing Ally home">
          <span class="brand-mark">SA</span>
          <span>Sourcing <b>Ally</b></span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href={`/${lang}/services/`}>Services</a>
          <a href={`/${lang}/products/`}>Products</a>
          <a href={`/${lang}/cities/`}>China cities</a>
          <a href={`/${lang}/guides/`}>Sourcing school</a>
          <a href={`/${lang}/questions/`}>Questions</a>
          <a href={`/${lang}/blog/`}>Journal</a>
        </nav>
        <div class="nav-actions">
          <label class="language-picker">
            <span class="sr-only">Choose language</span>
            <select onchange="window.location.href=this.value">
              {languages.map(([code, name]) => <option value={`/${code}${path}`} selected={code === lang}>{name}</option>)}
            </select>
          </label>
          <a class="button button-small" href={`/${lang}/start-project/`}>Start a project</a>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand footer-brand" href={`/${lang}/`}><span class="brand-mark">SA</span><span>Sourcing <b>Ally</b></span></a>
          <p class="footer-copy">A sourcing partner on the ground in Shenzhen, helping international buyers work with China more clearly and confidently.</p>
        </div>
        <div>
          <p class="footer-label">Explore</p>
          <a href={`/${lang}/services/`}>Services</a>
          <a href={`/${lang}/products/`}>Products</a>
          <a href={`/${lang}/cities/`}>China cities</a>
          <a href={`/${lang}/guides/`}>Sourcing school</a>
          <a href={`/${lang}/questions/`}>Sourcing questions</a>
          <a href={`/${lang}/blog/`}>Journal</a>
          <a href={`/${lang}/start-project/`}>Project brief</a>
          <a href={`/${lang}/privacy/`}>Privacy</a>
          <a href={`/${lang}/terms/`}>Terms</a>
          <a href={`/${lang}/disclaimer/`}>Disclaimer</a>
          <a href={`/${lang}/editorial-policy/`}>Editorial policy</a>
        </div>
        <div>
          <p class="footer-label">Contact</p>
          <a href="mailto:sourcingally@gmail.com">sourcingally@gmail.com</a>
          <a href="https://wa.me/8619002009100" target="_blank" rel="noreferrer">WhatsApp +86 190 0200 9100</a>
        </div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} Sourcing Ally</span><span>Shenzhen, China · International service</span></div>
    </footer>
  </body>
</html>
